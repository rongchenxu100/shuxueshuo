# 微信公众平台（服务号）开发者凭据
WECHAT_MP_APP_ID=wxxxxxxxxxxxxxxxx
WECHAT_MP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 站点对外 HTTPS 来源（无尾部斜杠），须与浏览器地址栏一致；签名接口只接受以此开头的 url
PUBLIC_SITE_ORIGIN=https://www.example.com

# Method Solver runtime
SOLVER_PLANNER_MODE=strategy
SOLVER_LLM_PROVIDER=recorded
SOLVER_LLM_MAX_ATTEMPTS=3
SOLVER_LLM_DEBUG_DIR=

# DeepSeek credentials (vision extraction and optional downstream text Solver)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Independent vision extraction; first pass, repair and review all use enabled/low.
PROBLEM_VISION_PROVIDER=deepseek
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_TIMEOUT=300
DEEPSEEK_VISION_MAX_TOKENS=16384

# Doubao explicit legacy/debug provider only; not required by product extraction.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
