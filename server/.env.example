# 微信公众平台（服务号）开发者凭据
WECHAT_MP_APP_ID=wxxxxxxxxxxxxxxxx
WECHAT_MP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Student phone login: disabled until database migration and credentials are ready.
# Production must use aliyun_sms; mock is only for explicit loopback development.
AUTH_SMS_MODE=disabled
AUTH_ENVIRONMENT=production
AUTH_ORIGIN=https://shuxueshuo.com
AUTH_COOKIE_SECURE=1
AUTH_SECRET=
AUTH_SESSION_SECONDS=2592000
AUTH_SMS_DAILY_LIMIT=200
AUTH_MOCK_DIRECTORY=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 站点对外 HTTPS 来源（无尾部斜杠），须与浏览器地址栏一致；签名接口只接受以此开头的 url
PUBLIC_SITE_ORIGIN=https://www.example.com

# Method Solver runtime
SOLVER_PLANNER_MODE=strategy
SOLVER_LLM_PROVIDER=recorded
SOLVER_LLM_MAX_ATTEMPTS=3
SOLVER_LLM_DEBUG_DIR=

# DeepSeek credentials (vision extraction and optional downstream text Solver)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Small-pilot tutor budgets. Persist this DB outside the public site/release dir.
TUTOR_SESSION_CALL_LIMIT=20
TUTOR_DAILY_CALL_LIMIT=200
TUTOR_FAILURE_COOLDOWN_SECONDS=5
# Empty uses server/var/tutor-usage.sqlite3; production should set an absolute persistent path.
TUTOR_USAGE_DB=

# Independent vision extraction; first pass, repair and review all use enabled/low.
PROBLEM_VISION_PROVIDER=deepseek
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_VISION_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_TIMEOUT=300
DEEPSEEK_VISION_MAX_TOKENS=16384

# Doubao explicit legacy/debug provider only; not required by product extraction.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628
