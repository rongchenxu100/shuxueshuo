      "nodes": [
        {
          "id": "rewrite",
          "title": "凑配表达式",
          "question": "已知 $x<0$，怎样把原式改写成根号内两个正项相乘的形式？",
          "interaction": {
            "type": "choice",
            "field": "rewrite_form",
            "options": [
              {
                "value": "negative_root",
                "label": "$-\\sqrt{x^2(9-x^2)}$"
              },
              {
                "value": "positive_root",
                "label": "$\\sqrt{x^2(9-x^2)}$"
              },
              {
                "value": "missing_root",
                "label": "$-x^2(9-x^2)$"
              }
            ]
          },
          "expected_answer": {
            "one_of": [
              "negative_root"
            ]
          },
          "feedback": {
            "answer": "注意 $\\sqrt{x^2}=|x|=-x$。原式为负，移入根号后要保留根号外的负号。"
          },
          "required_evidence": [
            "signed_rewrite"
          ],
          "criteria": "接受y=-√[x²(9-x²)]，或明确说明x<0故x=-√(x²)，从而把原式写成负的积的平方根。接受先令t=-x>0再写y=-√[t²(9-t²)]，系统仍用原变量显示并说明等价。只说平方、只选方法、只猜-9/2不足。y=+√[x²(9-x²)]或y=-x²(9-x²)不等价，不通过。若提出对-x和√(9-x²)求积，认可其可行，但它们固定的是平方和9，不是和；可引导研究平方后的两项。不能因不同于预设就否定数学上合法的路径。没有计算板，不承诺执行工具。",
          "completion_reply": "改写正确。因为 $x<0$，有 $\\sqrt{x^2}=-x$，所以 $y=-\\sqrt{x^2(9-x^2)}$。",
          "results": [
            "0<x²<9",
            "y=-√[x²(9-x²)]",
            "x²>0，9-x²>0"
          ]
        },
        {
          "id": "structure",
          "title": "观察结构",
          "question": "根号内这两项是定和求积，还是定积求和？",
          "interaction": {
            "type": "structure",
            "terms": [
              "x^2",
              "9-x^2"
            ],
            "term_labels": {
              "x^2": "$x^2$",
              "9-x^2": "$9-x^2$"
            }
          },
          "expected_answer": {
            "terms": [
              "x^2",
              "9-x^2"
            ],
            "fixed": "sum",
            "target": "product"
          },
          "feedback": {
            "terms": "两项应分别为 $x^2$ 与 $9-x^2$。",
            "structure": "固定的是 $x^2+(9-x^2)=9$；先求两项乘积的上界，再代回带负号的原式。"
          },
          "required_evidence": [
            "fixed_sum_structure"
          ],
          "criteria": "接受x²和9-x²为两个正项且和为9，先求乘积最大值/上界；若当前已选两项，可只回答定和求积。不能把原式y的目标说成最大值；求乘积上界是为求负平方根的下界。只说两项为正或只报最终数值不足。若谈-x和√(9-x²)，肯定两项为正且平方和固定，但不能把它们的和说成固定。",
          "completion_reply": "判断正确。$x^2+(9-x^2)=9$，这是定和求积；乘积越大，原式的负平方根越小。",
          "results": [
            "x²>0，9-x²>0",
