        {
          "id": "amgm",
          "title": "应用基本不等式",
          "question": "对这两个正项应用基本不等式，能得到什么关系？",
          "interaction": {
            "type": "amgm",
            "terms": [
              "x^2",
              "9-x^2"
            ],
            "term_labels": {
              "x^2": "$x^2$",
              "9-x^2": "$9-x^2$"
            }
          },
          "expected_answer": {
            "terms": [
              "x^2",
              "9-x^2"
            ]
          },
          "feedback": {
            "terms": "两个位置应分别对应 $x^2$ 和 $9-x^2$。"
          },
          "required_evidence": [
            "amgm_relation"
          ],
          "criteria": "接受x²+(9-x²)≥2√[x²(9-x²)]、9≥2√[x²(9-x²)]、等价均值形式或由此给出的乘积≤81/4、平方根≤9/2。系统代入和9、整理常数，不要求学生再算一次。只猜y最小值-9/2不足。对负的x与正的√(9-x²)直接套正项基本不等式不成立，应说明正性要求，而非简单归因项与模板不同。完成只确认本步，不追问下一步。",
          "completion_reply": "关系正确。代入两项的和为 $9$，得到 $\\sqrt{x^2(9-x^2)}\\le\\frac92$。",
          "results": [
            "9≥2√[x²(9-x²)]",
            "√[x²(9-x²)]≤9/2",
            "x²(9-x²)≤81/4"
