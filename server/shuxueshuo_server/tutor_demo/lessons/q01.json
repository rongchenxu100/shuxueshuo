  "id": "q01",
  "version": 2,
  "problem": {
    "text": "设正实数 m、n 满足 m + n = 2，求 mn 的最大值。",
    "conditions": [
      "m > 0，n > 0",
      "m + n = 2"
    ],
    "target": "(mn)max",
    "segments": [
      {
        "text": "设正实数 "
      },
      {
        "math": "m、n"
      },
      {
        "text": " 满足 "
      },
      {
        "math": "m + n = 2"
      },
      {
        "text": "，求 "
      },
      {
        "math": "mn"
      },
      {
        "text": " 的最大值。"
      }
    ]
  },
  "methods": [
    {
      "id": "direct",
      "label": "直接应用基本不等式"
    },
    {
      "id": "1",
      "label": "条件消元法"
    },
    {
      "id": "2",
      "label": "换元法"
    },
    {
      "id": "3",
      "label": "配齐次式"
    },
    {
      "id": "4",
      "label": "找对称结构"
    }
  ],
  "method_guidance": {
    "2": {
      "context": "换元可以把反复出现的复杂式子、根式等替换成新变量，让条件和目标更简单。",
      "reason": "本题的条件 m + n = 2 和目标 mn 已经很简洁，没有需要整体替换的复杂式子。引入新变量也能尝试求解，但会增加转换；若想减少变量，可以直接用条件消元。",
      "question": "已有的条件和目标之间，能否直接建立联系？"
    },
    "3": {
      "context": "配齐次式是把不同次数的项整理到相同次数，便于比较或应用不等式。",
      "reason": "本题可以把定和条件平方，用 (m + n)² 与 mn 作比较，但还需要展开或构造平方差。两正数的和已经给定，直接应用基本不等式更简洁，不必先补配齐次结构。",
      "question": "已知两正数的和，哪种方法能直接联系它们的积？"
    },
    "4": {
      "title": "找对称结构：本题无需再做和积换元",
      "context": "找对称结构是为了做和积换元：令 s = m + n、p = mn，把对称式改写成关于 s、p 的表达式，简化条件和目标。",
      "reason": "本题的条件已经是 m + n = 2，目标已经是 mn。换元后只是写成 s = 2、求 p 的最大值，没有进一步简化问题。要求出 p 的上界，仍需建立和与积之间的不等关系，因此直接应用基本不等式更简洁。",
      "question": "哪种不等式能直接联系两个正数的和与积？"
    }
  },
