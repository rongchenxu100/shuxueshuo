{
    "id": "quadratic-always-q02",
    "version": 1,
    "problem": {
        "statement": "已知不等式 $kx^2+2kx-(k+2)<0$ 恒成立，求实数 $k$ 的取值范围。",
        "conditions": [
            "$x\\in\\mathbb R$，$k\\in\\mathbb R$",
            "对所有实数 $x$，$kx^2+2kx-(k+2)<0$"
        ],
        "target": "求参数k的取值范围"
    },
    "methods": [
        {
            "id": "discriminant",
            "label": "判别式法"
        }
    ],
    "initial_state": {
        "active": 0,
        "method": null,
        "swapped": false,
        "pairs": [
