                                "options": [
                                    {
                                        "value": "f1",
                                        "label": "$f(1)$",
                                        "note": "左端点最高。"
                                    },
                                    {
                                        "value": "f2",
                                        "label": "$f(2)$",
                                        "note": "右端点最高。"
                                    },
                                    {
                                        "value": "vertex",
                                        "label": "顶点处的值",
                                        "note": "顶点最高。"
