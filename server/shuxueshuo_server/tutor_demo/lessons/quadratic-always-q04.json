{
    "id": "quadratic-always-q04",
    "version": 1,
    "problem": {
        "statement": "当 $1\\le x\\le2$ 时，不等式 $x^2+mx+4<0$ 恒成立，求实数 $m$ 的取值范围。",
        "conditions": [
            "$x\\in[1,2]$，$m\\in\\mathbb R$",
            "对所有 $x\\in[1,2]$，$x^2+mx+4<0$"
        ],
        "target": "求参数m的取值范围"
    },
    "methods": [
        {
            "id": "interval",
            "label": "区间最值法"
        },
        {
            "id": "extremum",
            "label": "分离参数法"
        }
    ],
    "routes": {
        "interval": {
            "label": "区间最值法",
            "nodes": [
                {
                    "id": "i_basis",
                    "title": "判断适用条件",
                    "question": "区间最值法需要一个前提。看看本题是否满足？",
                    "interaction": {
                        "type": "checklist",
                        "title": "区间最值法的前提",
                        "slots": [
                            {
                                "label": "$x$ 的取值范围",
                                "hint": "看题目要求对哪些 $x$ 成立",
                                "options": [
                                    {
                                        "value": "all_real",
                                        "label": "全体实数",
                                        "note": "在全体实数上，看整条图像与横轴的位置。"
                                    },
                                    {
                                        "value": "interval",
                                        "label": "某个区间",
                                        "note": "只看区间上的那一段图像，比较区间上的最值。"
                                    }
                                ]
                            }
                        ]
                    },
                    "expected_answer": {
                        "terms": [
                            "interval"
                        ]
                    },
                    "feedback": {
                        "terms": "题目只要求 $1\\le x\\le2$ 时成立，$x$ 的取值范围是区间 $[1,2]$。"
                    },
                    "required_evidence": [
                        "interval_domain"
                    ],
                    "criteria": "学生须指出x只在闭区间[1,2]上取值（只要求1≤x≤2时成立）。说“x取全体实数”是错误。只说“用区间最值法”不足。开口方向不是本步的前提，它决定下一步最大值在哪里取到；学生顺带说出开口向上不扣分。本步为单槽位checklist。学生明确指出x∈[1,2]时，只返回evidence=[\"interval_domain\"]、actions=[]，由服务端把槽位绑定为interval并推进。",
                    "completion_reply": "$x$ 只在 $[1,2]$ 上取值，只看这一段图像，比较区间上的最值。",
                    "results": [
                        "$x\\in[1,2]$：只看 $[1,2]$ 上的那一段图像，比较区间上的最值。"
                    ]
                },
                {
                    "id": "i_condition",
                    "title": "转化为最值条件",
                    "question": "要使 $f(x)<0$ 对所有 $x\\in[1,2]$ 成立，$f(x)$ 应满足哪个条件？",
                    "interaction": {
                        "type": "choice",
                        "field": "i_condition",
                        "options": [
                            {
                                "value": "max",
                                "label": "$x\\in[1,2]$ 时，$f(x)_{\\max}<0$"
                            },
                            {
                                "value": "min",
                                "label": "$x\\in[1,2]$ 时，$f(x)_{\\min}<0$"
                            },
                            {
                                "value": "one_point",
                                "label": "$f(2)<0$"
                            }
                        ]
                    },
                    "expected_answer": {
                        "one_of": [
                            "max"
                        ]
                    },
                    "feedback": {
                        "answer": "恒成立要求区间上每一点都满足：最高点在横轴下方，整段才在下方。只比最低点或一个点，别处仍可能不满足。"
                    },
                    "required_evidence": [
                        "maximum_condition"
                    ],
                    "criteria": "接受“f(x)在[1,2]上的最大值小于0”或“最高点在横轴下方”。只要求最小值（顶点值）小于0不够；只要求某一点（如f(2)<0）不够。严禁把恒成立当存在。学生直接说“f(1)<0且f(2)<0”时，说明方向对，但本步只确认“最大值小于0”，最大值在哪里取到留到下一步讨论。 答疑要举反例时，优先保持本题函数不变，取m=-9/2：f(1)=1/2>0，f(2)=-1<0，足以说明有负值不代表处处为负；不要临时改写常数项并反复试错。",
                    "completion_reply": "$f(x)<0$ 在 $[1,2]$ 上恒成立，等价于 $f(x)$ 在 $[1,2]$ 上的最大值小于 $0$。",
                    "results": [
                        "$f(x)<0$ 在 $[1,2]$ 上恒成立，等价于 $f(x)_{\\max}<0$。"
                    ]
                },
                {
                    "id": "i_extremum",
                    "title": "分类讨论最值",
                    "question": "$x^2$ 的系数为 $1$，$f(x)$ 开口向上，对称轴为 $x=-\\frac m2$。拖动对称轴观察图像，逐项确定 $f(x)$ 在 $[1,2]$ 上的最大值。",
