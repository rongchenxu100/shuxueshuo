      "contract": "graph-math-step/v2",
      "display_unit": "conditions",
      "explanation": "$\\because\\ \\text{需 }\\max f<\\max g$\n$\\text{情况 }1\\ (a\\in \\left[1, 3\\right]):$\n$f\\text{ 的最大值}=0$\n$g\\text{ 的最大值}=-6$\n$\\therefore\\ \\text{本支覆盖条件不成立}$\n$\\therefore\\ \\varnothing$\n$\\text{情况 }2\\ (a\\in \\left(3, \\infty\\right)):$\n$f\\text{ 的最大值}=0$\n$g\\text{ 的最大值}=a^{2} - 4 a - 3$\n$\\therefore\\ a^{2} - 4 a - 3 > 0$\n$\\therefore\\ a > 2 + \\sqrt{7}$",
      "highlight": {
        "caption": "求参数（$a > 3$）",
        "connector": "⇒",
        "items": [
          {
            "label": "已知与当前范围",
            "math": "\\begin{gathered}a\\in \\left(3, \\infty\\right)\\\\f\\text{ 的最大值}=0\\\\g\\text{ 的最大值}=a^{2} - 4 a - 3\\\\\\max f<\\max g\\end{gathered}"
          },
          {
            "label": "本支条件与 $a$",
            "math": "a^{2} - 4 a - 3 > 0\\Rightarrow a > 2 + \\sqrt{7}"
          }
        ],
        "layout": "derivation"
      },
      "lesson_version": "a7ed0c78bcb5ced5d6df385f596efe88e73cedb3cf927c4eab26c6b986da206a",
