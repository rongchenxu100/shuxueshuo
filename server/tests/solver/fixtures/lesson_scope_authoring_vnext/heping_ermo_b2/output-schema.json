{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson Scope Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_bodies"
  ],
  "properties": {
    "schema_version": {
      "const": "lesson-scope-content/v1"
    },
    "scope_bodies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "i",
        "i_1",
        "i_2",
        "ii"
      ],
      "properties": {
        "i": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "goals"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/lesson_step"
              }
            },
            "goals": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {}
            }
          }
        },
        "i_1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "goals"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "maxItems": 0
            },
            "goals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "i_1.A",
                "i_1.P"
              ],
              "properties": {
                "i_1.A": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "maxItems": 0
                    }
                  }
                },
                "i_1.P": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "$ref": "#/$defs/lesson_step"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "i_2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "goals"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "maxItems": 0
            },
            "goals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "i_2.E"
              ],
              "properties": {
                "i_2.E": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 3,
                      "items": {
                        "$ref": "#/$defs/lesson_step"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ii": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "goals"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "maxItems": 0
            },
            "goals": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ii.E"
              ],
              "properties": {
                "ii.E": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 7,
                      "items": {
                        "$ref": "#/$defs/lesson_step"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lesson_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_count",
        "title",
        "nav_title",
        "goal",
        "derive",
        "box",
        "visuals"
      ],
      "properties": {
        "material_count": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "nav_title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "derive": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "enum": [
                  "作",
                  "设",
                  "∵",
                  "∴",
                  "计算"
                ]
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "box": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visuals": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
