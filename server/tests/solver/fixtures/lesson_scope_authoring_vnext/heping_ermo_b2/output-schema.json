{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lesson Scope Content v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "i",
    "i_1",
    "i_2",
    "ii"
  ],
  "properties": {
    "i": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/lesson_step"
          }
        }
      }
    },
    "i_1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals"
      ],
      "properties": {
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "i_1.P"
          ],
          "properties": {
            "i_1.P": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/lesson_step"
              }
            }
          }
        }
      }
    },
    "i_2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals"
      ],
      "properties": {
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "i_2.E"
          ],
          "properties": {
            "i_2.E": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/lesson_step"
              }
            }
          }
        }
      }
    },
    "ii": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goals"
      ],
      "properties": {
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ii.E"
          ],
          "properties": {
            "ii.E": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "items": {
                "$ref": "#/$defs/lesson_step"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lesson_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_steps",
        "title",
        "nav_title",
        "goal",
        "derive"
      ],
      "properties": {
        "source_steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "nav_title": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "derive": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(作|设|∵|∴|计算)\\s+\\S"
          }
        }
      }
    }
  }
}
