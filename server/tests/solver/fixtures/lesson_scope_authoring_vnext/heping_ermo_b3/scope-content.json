{
  "i": {
    "steps": [
      {
        "source_steps": [
          "s1",
          "s2"
        ],
        "title": "求解析式与 A 点坐标",
        "nav_title": "解析式与 A 点",
        "goal": "确定抛物线解析式并求出左侧 x 轴交点 A。",
        "derive": [
          "∵ 题设给出 b＝－2，c＝3",
          "∴ y＝－x²－2x＋3＝－(x＋1)²＋4",
          "∵ x 轴交点满足 y＝0，即 －x²－2x＋3＝0",
          "计算 x＝－3 或 x＝1",
          "∵ A 定义为左侧交点，取较小根 x＝－3",
          "∴ A(－3,0)"
        ]
      }
    ]
  },
  "i_1": {
    "goals": {
      "i_1.P": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "求顶点 P",
          "nav_title": "求顶点",
          "goal": "由顶点式直接读出顶点坐标。",
          "derive": [
            "∵ y＝－(x＋1)²＋4",
            "∴ P(－1,4)"
          ]
        }
      ]
    }
  },
  "i_2": {
    "goals": {
      "i_2.E": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "设 E 点坐标",
          "nav_title": "设参数点",
          "goal": "利用对称轴方程引入参数表示 E。",
          "derive": [
            "∵ E 在对称轴 x＝－1 上",
            "设 E(－1,t)"
          ]
        },
        {
          "source_steps": [
            "s2"
          ],
          "title": "由正方形求 G",
          "nav_title": "求 G 点",
          "goal": "根据正方形性质求出 G 的坐标。",
          "derive": [
            "作 GQ⊥x轴于 Q",
            "∵ 四边形 AEKG 是正方形",
            "∴ AE＝AG，∠EAG＝90°",
            "∵ ∠EMA＝∠GQA＝90°",
            "∴ ∠EAM＝∠AGQ",
            "∴ Rt△AEM≌Rt△GAQ",
            "∴ AQ＝ME＝t，GQ＝AM＝2",
            "∵ G 在 x 轴下方",
            "∴ G(t－3,－2)"
          ]
        },
        {
          "source_steps": [
            "s3"
          ],
          "title": "代入抛物线求 E",
          "nav_title": "求 E 候选",
          "goal": "把 G 代入抛物线方程解出 t。",
          "derive": [
            "∵ G(t－3,－2) 在 y＝－x²－2x＋3 上",
            "∴ －2＝－(t－3)²－2(t－3)＋3",
            "计算 (t－3)²＋2(t－3)－5＝0",
            "∴ t＝2±√6",
            "∴ E(－1,2＋√6) 或 E(－1,2－√6)"
          ]
        }
      ]
    }
  },
  "ii": {
    "goals": {
      "ii.E": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "化简解析式",
          "nav_title": "化简解析式",
          "goal": "利用 A 在抛物线上解出 b 与 c 的关系，化简解析式。",
          "derive": [
            "∵ A(－c,0) 在 y＝－x²＋bx＋c 上",
            "∴ 0＝－c²－bc＋c＝－c(b＋c－1)",
            "∵ c＞1",
            "∴ b＝1－c",
            "∴ y＝－x²＋(1－c)x＋c"
          ]
        },
        {
          "source_steps": [
            "s2",
            "s3"
          ],
          "title": "化简路径并求最小值",
          "nav_title": "路径最值",
          "goal": "把路径化为单动点折线，利用对称和两点间距离求最小值。",
          "derive": [
            "∵ FM=AE/2，HF=AG/2，AE=AG",
            "∴ HF+FM=AG",
            "∴ HF+FM+MG＝AG+MG",
            "∵ G 的轨迹为 y=-c/2-1/2",
            "作 关于该轨迹构造 A′(-c,-c-1)",
            "∵ AG=A′G",
            "∴ AG+MG＝A′G+MG≥A′M",
            "∴ 最小值为 √5|c+1|/2",
            "∴ 在 G(1/4-3c/4,-c/2-1/2) 处取得"
          ]
        },
        {
          "source_steps": [
            "s4"
          ],
          "title": "反求参数 c",
          "nav_title": "反求 c",
          "goal": "由题设最小值等于 3√5 列出方程并解出 c。",
          "derive": [
            "∵ √5|c＋1|/2＝3√5",
            "计算 解关于 c 的方程并按题设条件筛选",
            "∴ c＝5"
          ]
        },
        {
          "source_steps": [
            "s5"
          ],
          "title": "求 A 具体坐标",
          "nav_title": "代入求 A",
          "goal": "把 c 的值代入 A 的含参坐标。",
          "derive": [
            "∵ A(-c,0)，c＝5",
            "∴ A(-5,0)"
          ]
        },
        {
          "source_steps": [
            "s6"
          ],
          "title": "求 G 具体坐标",
          "nav_title": "代入求 G",
          "goal": "把 c 的值代入 G 的含参坐标。",
          "derive": [
            "∵ G(1/4-3c/4,-c/2-1/2)，c＝5",
            "∴ G(-7/2,-3)"
          ]
        },
        {
          "source_steps": [
            "s7"
          ],
          "title": "由正方形求 E",
          "nav_title": "求 E 坐标",
          "goal": "利用正方形性质由 A、G 求出 E。",
          "derive": [
            "作 GQ⊥x轴于 Q，ER⊥x轴于 R",
            "∵ 四边形 AEKG 是正方形",
            "∴ AG＝AE，∠GAE＝90°",
            "∵ ∠GQA＝∠ERA＝90°",
            "∴ ∠GAQ＝∠AER",
            "∴ Rt△AGQ≌Rt△EAR",
            "∴ AR＝QG＝3，ER＝AQ＝3/2",
            "∵ 按正方形顶点顺序选取 E",
            "∴ E(－2,3/2)"
          ]
        }
      ]
    }
  }
}
