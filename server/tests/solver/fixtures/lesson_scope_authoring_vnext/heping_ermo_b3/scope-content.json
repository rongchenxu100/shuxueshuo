{
  "i": {
    "steps": [
      {
        "source_steps": [
          "s1",
          "s2"
        ],
        "title": "求函数解析式及点 A 的坐标",
        "nav_title": "求解析式与点A",
        "goal": "先由给定系数确定抛物线，再与 x 轴相交取左侧交点得点 A。",
        "derive": [
          "∵ 题设给出当前二次函数的系数条件",
          "∴ b＝－2，c＝3",
          "∴ y＝－x²－2x＋3＝－(x＋1)²＋4",
          "∵ x 轴交点满足 y＝0，即 －x²－2x＋3＝0",
          "计算 x＝－3 或 x＝1",
          "∵ A 定义为左侧交点，取较小根 x＝－3",
          "∴ A(－3,0)"
        ]
      }
    ]
  },
  "i_1": {
    "goals": {
      "i_1.P": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "求二次函数顶点",
          "nav_title": "求顶点",
          "goal": "从顶点式直接读出抛物线的顶点坐标。",
          "derive": [
            "∵ y＝－(x＋1)²＋4",
            "∴ P(－1,4)"
          ]
        }
      ]
    }
  },
  "i_2": {
    "goals": {
      "i_2.E": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "设对称轴上的参数点",
          "nav_title": "设参数点",
          "goal": "由对称轴方程，用一个参数表示轴上的目标点 E。",
          "derive": [
            "∵ E 在对称轴 x＝－1 上",
            "设 E(－1,t)"
          ]
        },
        {
          "source_steps": [
            "s2"
          ],
          "title": "由正方形求相邻顶点 G",
          "nav_title": "正方形求顶点G",
          "goal": "利用正方形相邻边垂直且等长，通过全等三角形求出顶点 G 的坐标。",
          "derive": [
            "作 GQ⊥x轴于 Q",
            "∵ 四边形 AEKG 是正方形",
            "∴ AE＝AG，∠EAG＝90°",
            "∵ ∠EMA＝∠GQA＝90°",
            "∴ ∠EAM＝∠AGQ",
            "∴ Rt△AEM≌Rt△GAQ",
            "∴ AQ＝ME＝t，GQ＝AM＝2",
            "∵ G 在 x 轴下方",
            "∴ G(t－3,－2)"
          ]
        },
        {
          "source_steps": [
            "s3"
          ],
          "title": "代入抛物线求点 E 候选",
          "nav_title": "求点E候选",
          "goal": "把 G 的坐标代入抛物线方程，解出参数 t 并回代得到点 E 的两个候选坐标。",
          "derive": [
            "∵ G(t－3,－2) 在 y＝－x²－2x＋3 上",
            "∴ －2＝－(t－3)²－2(t－3)＋3",
            "计算 (t－3)²＋2(t－3)－5＝0",
            "∴ t＝2±√6",
            "∴ E(－1,2＋√6) 或 E(－1,2－√6)"
          ]
        }
      ]
    }
  },
  "ii": {
    "goals": {
      "ii.E": [
        {
          "source_steps": [
            "s1"
          ],
          "title": "化简函数解析式",
          "nav_title": "化简解析式",
          "goal": "由点 A 在抛物线上建立方程，结合 c>1 解出 b 与 c 的关系，得到含参解析式。",
          "derive": [
            "∵ A(－c,0) 在 y＝－x²＋bx＋c 上",
            "∴ 0＝－c²－bc＋c＝－c(b＋c－1)",
            "∵ c＞1",
            "∴ b＝1－c",
            "∴ y＝－x²＋(1－c)x＋c"
          ]
        },
        {
          "source_steps": [
            "s2"
          ],
          "title": "利用正方形关系化简路径",
          "nav_title": "化简路径",
          "goal": "利用中点、中心和正方形等长关系，把原路径化为单动点路径。",
          "derive": [
            "∵ FM=AE/2，HF=AG/2，AE=AG",
            "∴ HF+FM=AG",
            "∴ HF+FM+MG＝AG+MG"
          ]
        },
        {
          "source_steps": [
            "s3"
          ],
          "title": "确定 G 的轨迹并用反射求最短路径",
          "nav_title": "轨迹与反射",
          "goal": "确定动点轨迹，构造对称点拉直折线，并给出最小值与取等位置。",
          "derive": [
            "∵ G 的轨迹为 y=-c/2-1/2",
            "作 关于该轨迹构造 A′(-c,-c-1)",
            "∵ AG=A′G",
            "∴ AG+MG＝A′G+MG≥A′M",
            "∴ 最小值为 √5|c+1|/2",
            "∴ 在 G(1/4-3c/4,-c/2-1/2) 处取得"
          ]
        },
        {
          "source_steps": [
            "s4"
          ],
          "title": "由表达式取值反求参数",
          "nav_title": "反求参数",
          "goal": "把题设给定值代入已得到的表达式，解出参数并筛选合法分支。",
          "derive": [
            "∵ √5|c＋1|/2＝3√5",
            "计算 解关于 c 的方程并按题设条件筛选",
            "∴ c＝5"
          ]
        },
        {
          "source_steps": [
            "s5"
          ],
          "title": "代入参数求点 A",
          "nav_title": "代入求点A",
          "goal": "把已求出的参数值代入含参点坐标，得到具体点。",
          "derive": [
            "∵ A(-c,0)，c＝5",
            "∴ A(-5,0)"
          ]
        },
        {
          "source_steps": [
            "s6"
          ],
          "title": "代入参数求点 G",
          "nav_title": "代入求点G",
          "goal": "把参数值代入取等点的坐标，得到具体点 G。",
          "derive": [
            "∵ G(1/4-3c/4,-c/2-1/2)，c＝5",
            "∴ G(-7/2,-3)"
          ]
        },
        {
          "source_steps": [
            "s7"
          ],
          "title": "由正方形求相邻顶点 E",
          "nav_title": "正方形求顶点E",
          "goal": "利用正方形相邻边垂直且等长，通过全等三角形反求顶点 E 的坐标。",
          "derive": [
            "作 GQ⊥x轴于 Q",
            "∵ 四边形 AEKG 是正方形",
            "∴ AG＝AE，∠GAE＝90°",
            "∵ ∠GQA＝∠EMA＝90°",
            "∴ ∠GAQ＝∠AEM",
            "∴ Rt△AGQ≌Rt△EAM",
            "∴ AM＝QG＝3，EM＝AQ＝3/2",
            "∵ 按正方形顶点顺序选取 E",
            "∴ E(－2,3/2)"
          ]
        }
      ]
    }
  }
}
