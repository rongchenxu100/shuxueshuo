                {
                  "math": "∵ a>0；∴ a^2>0, 4/a^2>0"
                },
                {
                  "math": "∴ a^2+4/a^2 >= 2*sqrt(a^2*(4/a^2)) = 4"
                }
              ]
            }
          },
          {
            "step_id": "close_and_minimum",
            "capability_id": "close_equality_and_restore",
            "args": {
              "target": "extremum_target_target_expression",
              "bound": {
                "step_id": "amgm_final",
                "return": "bound"
              }
            },
            "parameters": {
              "steps": [
                {
                  "math": "∵ b*(a-b) <= a^2/4 取等条件为 b=a-b，即 b=a/2"
                },
                {
                  "math": "∵ a^2+4/a^2 >= 4 取等条件为 a^2=4/a^2，即 a^4=4，a>0，所以 a=√2"
                },
                {
                  "math": "∵ (a-5*c)^2 >= 0 取等条件为 a-5*c=0，即 c=a/5"
                },
                {
                  "math": "∴ a=√2, b=√2/2, c=√2/5"
                },
                {
                  "math": "∵ a=√2 > b=√2/2 > c=√2/5 > 0；∴ 满足 a>b>c>0"
                },
                {
                  "math": "∴ 2*a^2+1/(a*b)+1/(a*(a-b))-10*a*c+25*c^2 = 4"
                }
              ]
            }
          }
        ]
