                  "math": "∴ 2*a^2-10*a*c+25*c^2 = a^2 + (a-5*c)^2"
                },
                {
                  "math": "∴ 2*a^2+1/(a*b)+1/(a*(a-b))-10*a*c+25*c^2 = a^2+(a-5*c)^2+1/(b*(a-b))"
                }
              ]
            }
