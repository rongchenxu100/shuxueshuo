                {
                  "math": "∵ a>b>c>0；∴ a>0, b>0, c>0, a-b>0, a*b>0, a*(a-b)>0"
                },
                {
                  "math": "∴ 1/(a*b)+1/(a*(a-b)) = (a-b+b)/(a*b*(a-b)) = a/(a*b*(a-b)) = 1/(b*(a-b))"
                },
