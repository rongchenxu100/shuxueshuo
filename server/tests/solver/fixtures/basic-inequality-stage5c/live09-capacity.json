            "step_id": "amgm_reciprocal",
            "capability_id": "apply_two_term_amgm",
            "args": {
              "target": "extremum_target_target_expression",
              "expression": "target_expression"
            },
            "parameters": {
              "steps": [
                {
                  "math": "∵ a>b>c>0；∴ b>0, a-b>0"
                },
                {
                  "math": "∵ (b+(a-b))^2/4 = a^2/4；∴ b*(a-b) <= a^2/4"
                },
                {
                  "math": "∴ 1/(b*(a-b)) >= 4/a^2"
                },
                {
                  "math": "∵ (a-5*c)^2 >= 0；∴ a^2+(a-5*c)^2+1/(b*(a-b)) >= a^2+4/a^2"
                }
              ]
            }
          },
