{"format":"functional_plan/v2","root_scope":{"scope_ref":"problem","goals":[{"goal_ref":"problem.minimum","answer_from":{"step_id":"close","return":"minimum"},"steps":[{"step_id":"organize","capability_id":"organize_expressions","args":{"expression":"target_expression"},"parameters":{"steps":[{"math":"∵ 1/(a*b)+1/(a*(a-b))=(a-b+b)/(a*b*(a-b))=a/(a*b*(a-b))=1/(b*(a-b))"},{"math":"∴ 2*a^2+1/(a*b)+1/(a*(a-b))-10*a*c+25*c^2 = 2*a^2-10*a*c+25*c^2+1/(b*(a-b))"},{"math":"∵ 2*a^2-10*a*c+25*c^2 = a^2+(a-5*c)^2"},{"math":"∴ 原式 = a^2+(a-5*c)^2+1/(b*(a-b))"}]}},{"step_id":"amgm1","capability_id":"apply_two_term_amgm","args":{"expression":"target_expression","target":"extremum_target_target_expression"},"parameters":{"steps":[{"math":"∵ a>b>c>0；∴ b>0，a-b>0"},{"math":"∵ b*(a-b) <= ((b+(a-b))/2)^2 = (a/2)^2 = a^2/4"},{"math":"∴ 1/(b*(a-b)) >= 4/a^2"},{"math":"∴ 原式 >= a^2+(a-5*c)^2+4/a^2"}]}},{"step_id":"amgm2","capability_id":"apply_two_term_amgm","args":{"previous_bound":{"step_id":"amgm1","return":"bound"},"target":"extremum_target_target_expression"},"parameters":{"steps":[{"math":"∵ a>0；∴ a^2+4/a^2 >= 2*sqrt(a^2*4/a^2) = 4"},{"math":"∴ 原式 >= 4+(a-5*c)^2"}]}},{"step_id":"quad_bound","capability_id":"bound_univariate_quadratic","args":{"previous_bound":{"step_id":"amgm2","return":"bound"},"target":"extremum_target_target_expression"},"parameters":{"steps":[{"math":"∴ 4+(a-5*c)^2 = 1*(a-5*c)^2+4"},{"math":"∵ 1>0，(a-5*c)^2>=0；∴ 1*(a-5*c)^2+4 >= 4"}],"variable":"a"}},{"step_id":"close","capability_id":"close_equality_and_restore","args":{"bound":{"step_id":"quad_bound","return":"bound"},"target":"extremum_target_target_expression"},"parameters":{"steps":[{"math":"∵ b*(a-b)=a^2/4，a^2=4/a^2，(a-5*c)^2=0"},{"math":"∴ b=a/2，a=sqrt(2)，c=a/5=sqrt(2)/5"},{"math":"∴ a=sqrt(2)，b=sqrt(2)/2，c=sqrt(2)/5"},{"math":"∵ a>b>c>0；∴ sqrt(2)>sqrt(2)/2>sqrt(2)/5>0"},{"math":"∴ 2*a^2+1/(a*b)+1/(a*(a-b))-10*a*c+25*c^2=4"}]}}]}]}}