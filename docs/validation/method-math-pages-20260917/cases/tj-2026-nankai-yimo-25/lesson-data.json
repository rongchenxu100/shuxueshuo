  "steps": [
    {
      "id": "teach:i_derive_D",
      "section": "整题",
      "title": "第1步：由系数关系求对称轴",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "二次函数的对称轴为 x＝－b/(2a)"
        ],
        [
          "计算",
          "由 2a＋b＝0 得 b＝－2a，代入得 x＝1"
        ],
        [
          "∴",
          "对称轴与 x 轴交于 D(1,0)"
        ]
      ],
      "box": [
        "D(1,0)"
      ]
    },
    {
      "id": "teach:i_derive_parabola",
      "section": "第（Ⅰ）问：写出点 D 的坐标和抛物线的解析式",
      "title": "第1步：求函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "已知系数条件为 a＝2，c＝－5，2a＋b＝0"
        ],
        [
          "计算",
          "将 a＝2 代入 2a＋b＝0，解得 b＝－4"
        ],
        [
          "计算",
          "代入 y＝ax²＋bx＋c，得 y＝2x²－4x－5"
        ],
        [
          "∴",
          "y＝2x²－4x－5＝2(x－1)²－7"
        ]
      ],
      "box": [
        "y＝2x²－4x－5"
      ]
    },
    {
      "id": "teach:ii_construct_N:right_angle_equal_length_construct_and_select/construct_candidates",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第1步：由直角等腰关系构造候选点",
      "t": 0.75,
      "derive": [
        [
          "设",
          "两个候选点分别为N₁、N₂"
        ],
        [
          "作",
          "MU⊥x 轴于U，N₁V⊥x 轴于V，N₂W⊥x 轴于W"
        ],
        [
          "∵",
          "D(1,0)，M(m,1)"
        ],
        [
          "∴",
          "U(m,0)，DU＝m－1，MU＝1"
        ],
        [
          "∵",
          "∠MDN₁＝∠MDN₂＝90°，DM＝DN₁＝DN₂"
        ],
        [
          "∴",
          "Rt△DUM≌Rt△N₁VD≌Rt△N₂WD"
        ],
        [
          "∴",
          "DV＝DW＝MU＝1，N₁V＝N₂W＝DU＝m－1"
        ],
        [
          "∴",
          "V(2,0)，W(0,0)，N₁(2,1－m)，N₂(0,m－1)"
        ]
      ],
      "box": [
        "N₁(2,1－m)，N₂(0,m－1)"
      ]
    },
    {
      "id": "teach:ii_construct_N:right_angle_equal_length_construct_and_select/select_candidate",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第2步：根据题设条件确定唯一候选点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "N 在第四象限，且 m＞2"
        ],
        [
          "计算",
          "逐一判断，N₁(2,1－m)满足上述条件；N₂(0,m－1)不满足上述条件"
        ],
        [
          "∴",
          "唯一符合题意的点为N(2,1－m)"
        ]
      ],
      "box": [
        "N(2,1－m)"
      ]
    },
    {
      "id": "teach:ii_derive_parabola",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第3步：化简函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设还给出 2a＋b＝0"
        ],
        [
          "∵",
          "M(m,1) 在 y＝ax²＋bx＋c 上"
        ],
        [
          "∴",
          "代入 M 点坐标，得 1＝am²＋bm＋c"
        ],
        [
          "∵",
          "N(2,1－m) 在 y＝ax²＋bx＋c 上"
        ],
        [
          "∴",
          "代入 N 点坐标，得 1－m＝4a＋2b＋c"
        ],
        [
          "计算",
          "联立上述方程，得 a＝1/(m－2)，b＝－2/(m－2)，c＝1－m"
        ],
        [
          "∴",
          "y＝(1/(m－2))x²－2/(m－2)x＋1－m"
        ]
      ],
      "box": [
        "y＝(1/(m－2))x²－2/(m－2)x＋1－m"
      ]
    },
    {
      "id": "teach:ii_compute_F",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第4步：求线段中点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "线段两端点为 D(1,0)、N(2,1－m)"
        ],
        [
          "计算",
          "由中点公式，x_F＝(1＋2)/2＝3/2，y_F＝(0＋(1－m))/2＝1/2－m/2"
        ],
        [
          "∴",
          "中点为 F(3/2,1/2－m/2)"
        ]
      ],
      "box": [
        "F(3/2,1/2－m/2)"
      ]
    },
    {
      "id": "teach:ii_path_minimum:coupled_segment_endpoint_replacement_path_minimum/endpoint_replacement",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第5步：利用线段关系替换耦合端点",
      "t": 0.75,
      "derive": [
        [
          "作",
          "GH⊥DN于H，GK⊥DM于K"
        ],
        [
          "∵",
          "△DMN是等腰直角三角形，G在线段MN上"
        ],
        [
          "∴",
          "△GNH是等腰直角三角形"
        ],
        [
          "∴",
          "GH＝HN＝NG/√2"
        ],
        [
          "∵",
          "四边形DKGH是矩形"
        ],
        [
          "∴",
          "DK＝GH，GK＝DH"
        ],
        [
          "∵",
          "DE＝√2·NG＝2GH"
        ],
        [
          "∴",
          "EK＝DE－DK＝GH＝DK"
        ],
        [
          "∵",
          "GK⊥DM，D、E、K在直线DM上"
        ],
        [
          "∴",
          "GK垂直平分DE"
        ],
        [
          "∴",
          "△DGE是等腰三角形，EG＝DG"
        ],
        [
          "∴",
          "EG＋FG＝DG＋FG"
        ]
      ],
      "box": [
        "EG+FG＝DG+FG"
      ],
      "localControls": {
        "values": {
          "u": 0.75
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 G（E 联动）",
            "min": 0.5,
            "max": 1.0,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动G，观察E与路径同步变化。"
      }
    },
    {
      "id": "teach:ii_path_minimum:coupled_segment_endpoint_replacement_path_minimum/reflection_minimum",
      "section": "第（Ⅱ）问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第6步：确定G的轨迹并拉直折线",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "G 的轨迹为 线段MN"
        ],
        [
          "作",
          "关于G的轨迹作D的对称点D′(m+1,2-m)"
        ],
        [
          "∴",
          "DG+FG＝D′G+FG≥D′F"
        ],
        [
          "∴",
          "最小值为 √(5m²-10m+10)/2"
        ],
        [
          "∴",
          "在 G(m/3+4/3,1-2m/3) 处取得"
        ]
      ],
      "box": [
        "最小值为 √(5m²-10m+10)/2",
        "取等点为 G(m/3+4/3,1-2m/3)"
      ],
      "localControls": {
        "values": {
          "u": 0.666667
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 G",
            "min": 0.5,
            "max": 1.0,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动G，观察相关动点与路径同步变化。"
      }
    },
    {
      "id": "teach:ii_1_solve_m",
      "section": "第（Ⅱ）①问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第1步：由线段长度关系求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "目标线段端点为 M(m,1)、N(2,1－m)"
        ],
        [
          "∵",
          "题设长度条件为 MN²＝10"
        ],
        [
          "计算",
          "由距离公式建立方程 m²＋(m－2)²＝10"
        ],
        [
          "计算",
          "解方程，得 m＝－1 或 m＝3"
        ],
        [
          "∵",
          "根据 m＞2，保留 m＝3"
        ],
        [
          "∴",
          "m＝3"
        ]
      ],
      "box": [
        "m＝3"
      ]
    },
    {
      "id": "teach:ii_1_evaluate_minimum",
      "section": "第（Ⅱ）①问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第2步：代入参数化简表达式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "m＝3"
        ],
        [
          "计算",
          "把 m＝3 代入 √(5m²－10m＋10)/2，化简得 5/2"
        ],
        [
          "∴",
          "5/2"
        ]
      ],
      "box": [
        "5/2"
      ]
    },
    {
      "id": "teach:ii_1_specialize_parabola",
      "section": "第（Ⅱ）①问：求抛物线的解析式，并直接写出 EG＋FG 的最小值",
      "title": "第3步：代入参数化简表达式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "m＝3"
        ],
        [
          "计算",
          "把 m＝3 代入 (x²－2x＋(1－m)(m－2))/(m－2)，化简得 x²－2x－2"
        ],
        [
          "∴",
          "x²－2x－2"
        ]
      ],
      "box": [
        "x²－2x－2"
      ]
    },
    {
      "id": "teach:ii_2_solve_m",
      "section": "第（Ⅱ）②问：写出此时抛物线的解析式和点 G 的坐标",
      "title": "第1步：由最小值反求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设要求 √(5m²－10m＋10)/2＝5√10/2"
        ],
        [
          "计算",
          "解方程，得 m＝－6 或 m＝8"
        ],
        [
          "∵",
          "根据 m＞2，保留 m＝8"
        ],
        [
          "∴",
          "m＝8"
        ]
      ],
      "box": [
        "m＝8"
      ]
    },
    {
      "id": "teach:ii_2_evaluate_G",
      "section": "第（Ⅱ）②问：写出此时抛物线的解析式和点 G 的坐标",
      "title": "第2步：代入参数求点坐标",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "G(m/3+4/3,1-2m/3)，m＝8"
        ],
        [
          "计算",
          "将 m＝8 代入：x_G＝m/3＋4/3＝4，y_G＝1－2m/3＝－13/3"
        ],
        [
          "∴",
          "G(4,-13/3)"
        ]
      ],
      "box": [
        "G(4,-13/3)"
      ]
    },
    {
      "id": "teach:ii_2_specialize_parabola",
      "section": "第（Ⅱ）②问：写出此时抛物线的解析式和点 G 的坐标",
      "title": "第3步：代入参数化简表达式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "m＝8"
        ],
        [
          "计算",
          "把 m＝8 代入 (x²－2x＋(1－m)(m－2))/(m－2)，化简得 x²/6－x/3－7"
        ],
        [
          "∴",
          "x²/6－x/3－7"
        ]
      ],
      "box": [
        "x²/6－x/3－7"
      ]
    }
