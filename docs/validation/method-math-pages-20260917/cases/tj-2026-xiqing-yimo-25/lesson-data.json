          }
        ],
        "note": "拖动M，观察辅助点Q与等价路径同步变化。"
      }
    },
    {
      "id": "teach:derive_weighted_minimum_ii:weighted_axis_path_minimum/domain_minimum",
      "section": "第（Ⅱ）②问：求 b 的值",
      "title": "第2步：拉直折线求路径最小值",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "两点之间线段最短"
        ],
        [
          "∴",
          "DM＋MQ≥DQ"
        ],
        [
          "∴",
          "当 D、M、Q 三点共线时，折线最短"
        ],
        [
          "∵",
          "Q 在过 A 且经过 y 轴正半轴点 (0,√3/3) 的 30° 固定射线 y＝√3(x＋1)/3 上运动"
        ],
        [
          "∴",
          "最短时 DQ⊥AQ"
        ],
        [
          "∵",
          "取等时 M((－√3b＋3b－3√3＋6)/3,0)，且 M 在 x 轴正半轴上"
        ],
        [
          "∴",
          "取等状态在定义域内恒成立"
        ],
        [
          "∴",
          "此时 2DM＋AM 的最小值为 b＋√3b＋3＋3√3"
        ]
      ],
      "box": [
        "最小值为 b＋√3b＋3＋3√3"
      ],
      "localControls": {
        "values": {
          "m": 2.844
        },
        "controls": [
          {
            "var": "m",
            "label": "动点 M",
            "min": 0.04,
            "max": 5.648,
            "step": 0.04,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动M，观察辅助点Q与等价路径同步变化。"
      }
    },
    {
      "id": "teach:solve_parameter_from_minimum_ii",
      "section": "第（Ⅱ）②问：求 b 的值",
      "title": "第3步：由表达式取值反求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设要求 b＋√3(b＋3)＋3＝5＋5√3"
        ],
        [
          "计算",
          "解方程，得 b＝2"
        ],
        [
          "∴",
          "b＝2"
        ]
      ],
      "box": [
        "b＝2"
      ]
