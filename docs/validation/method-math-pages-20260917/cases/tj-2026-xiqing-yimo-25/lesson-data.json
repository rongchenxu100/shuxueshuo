  "steps": [
    {
      "id": "teach:derive_parabola_i",
      "section": "第（Ⅰ）问：求抛物线的顶点坐标",
      "title": "第1步：求函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设还给出 b＝4"
        ],
        [
          "∵",
          "A(－1,0) 在 y＝－x²＋bx＋c 上"
        ],
        [
          "∴",
          "代入 A 点坐标，得 0＝－1－4＋c＝c－5"
        ],
        [
          "计算",
          "化简上述方程，得 b＝4，c＝5"
        ],
        [
          "∴",
          "y＝－x²＋4x＋5＝－(x－2)²＋9"
        ]
      ],
      "box": [
        "y＝－x²＋4x＋5"
      ]
    },
    {
      "id": "teach:derive_vertex_i",
      "section": "第（Ⅰ）问：求抛物线的顶点坐标",
      "title": "第2步：求二次函数顶点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "抛物线为 y＝－x²＋4x＋5"
        ],
        [
          "计算",
          "配方，得 y＝－(x－2)²＋9"
        ],
        [
          "∴",
          "顶点为 (2,9)"
        ]
      ],
      "box": [
        "(2,9)"
      ]
    },
    {
      "id": "teach:derive_parametric_parabola_ii",
      "section": "第（Ⅱ）问：求 b 的值",
      "title": "第1步：化简函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "A(－1,0) 在 y＝－x²＋bx＋c 上"
        ],
        [
          "∴",
          "代入 A 点坐标，得 0＝－1－b＋c＝－b＋c－1"
        ],
        [
          "计算",
          "化简上述方程，得 c＝b＋1"
        ],
        [
          "∴",
          "y＝－x²＋bx＋b＋1"
        ]
      ],
      "box": [
        "y＝－x²＋bx＋b＋1"
      ]
    },
    {
      "id": "teach:derive_curve_point_D_ii",
      "section": "第（Ⅱ）问：求 b 的值",
      "title": "第2步：由横坐标求抛物线上点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "D 在 y＝－x²＋bx＋b＋1 上，且 x＝b＋2"
        ],
        [
          "计算",
          "代入横坐标，y＝－(b＋2)²＋b(b＋2)＋b＋1＝－b－3"
        ],
        [
          "∴",
          "D(b＋2,－b－3)"
        ]
      ],
      "box": [
        "D(b＋2,－b－3)"
      ]
    },
    {
      "id": "teach:derive_x_intercept_B_ii",
      "section": "第（Ⅱ）问：求 b 的值",
      "title": "第3步：求抛物线与 x 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "x 轴交点满足 y＝0，即 －x²＋bx＋b＋1＝0"
        ],
        [
          "计算",
          "x＝－1 或 x＝b＋1"
        ],
        [
          "∵",
          "结合B的定义，取 x＝b＋1"
        ],
        [
          "∴",
          "B(b＋1,0)"
        ]
      ],
      "box": [
        "B(b＋1,0)"
      ]
    },
    {
      "id": "teach:derive_y_intercept_C_ii",
      "section": "第（Ⅱ）问：求 b 的值",
      "title": "第4步：求抛物线与 y 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "y 轴上的点满足 x＝0"
        ],
        [
          "计算",
          "代入 x＝0，得 y＝－(0)²＋b(0)＋b＋1＝b＋1"
        ],
        [
          "∴",
          "C(0,b＋1)"
        ]
      ],
      "box": [
        "C(0,b＋1)"
      ]
    },
    {
      "id": "teach:solve_parameter_from_segment_relation_ii",
      "section": "第（Ⅱ）①问：求 b 的值",
      "title": "第1步：由线段长度关系求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "目标线段端点为 A(－1,0)、D(b＋2,－b－3)"
        ],
        [
          "∵",
          "题设长度条件为 AD＝2BC"
        ],
        [
          "计算",
          "由距离公式建立方程 2(b＋3)²＝8(b＋1)²"
        ],
        [
          "计算",
          "解方程，得 b＝－5/3 或 b＝1"
        ],
        [
          "∵",
          "根据 b＞0，保留 b＝1"
        ],
        [
          "∴",
          "b＝1"
        ]
      ],
      "box": [
        "b＝1"
      ]
    },
    {
      "id": "teach:derive_weighted_minimum_ii:weighted_axis_path_minimum/weighted_reduction",
      "section": "第（Ⅱ）②问：求 b 的值",
      "title": "第1步：构造辅助直角三角形消去路径权重",
      "t": 0.75,
      "derive": [
        [
          "作",
          "在 x 轴上方作 Rt△AQM，使 ∠AQM＝90°，∠QAM＝30°"
        ],
        [
          "∵",
          "在 Rt△AQM 中，30° 角所对的边为 QM"
        ],
        [
          "∴",
          "AM＝2·QM"
        ],
        [
          "∴",
          "2DM＋AM＝2DM＋2QM"
        ],
        [
          "∴",
          "2DM＋AM＝2(DM＋QM)"
        ],
        [
          "∵",
          "M 在 x 轴上运动"
        ],
        [
          "∴",
          "Q 在过 A 且经过 y 轴正半轴点 (0,√3/3) 的 30° 固定射线 y＝√3(x＋1)/3 上运动"
        ]
      ],
      "box": [
        "2DM＋AM＝2(DM＋QM)"
      ],
      "localControls": {
        "values": {
          "m": 2.844
        },
        "controls": [
          {
            "var": "m",
            "label": "动点 M",
            "min": 0.04,
