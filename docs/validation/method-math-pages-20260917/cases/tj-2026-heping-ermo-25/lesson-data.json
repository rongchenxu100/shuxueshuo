  "steps": [
    {
      "id": "teach:derive_parabola_i",
      "section": "第（Ⅰ）问：求点 P 和点 A 的坐标",
      "title": "第1步：求函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "已知系数条件为 b＝－2，c＝3"
        ],
        [
          "计算",
          "代入 y＝－x²＋bx＋c，得 y＝－x²－2x＋3"
        ],
        [
          "∴",
          "y＝－x²－2x＋3＝－(x＋1)²＋4"
        ]
      ],
      "box": [
        "y＝－x²－2x＋3"
      ]
    },
    {
      "id": "teach:derive_x_intercept_A_i",
      "section": "第（Ⅰ）问：求点 P 和点 A 的坐标",
      "title": "第2步：求抛物线与 x 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "x 轴交点满足 y＝0，即 －x²－2x＋3＝0"
        ],
        [
          "计算",
          "x＝－3 或 x＝1"
        ],
        [
          "∵",
          "A 定义为左侧交点，取较小根 x＝－3"
        ],
        [
          "∴",
          "A(－3,0)"
        ]
      ],
      "box": [
        "A(－3,0)"
      ]
    },
    {
      "id": "teach:derive_vertex_P_i",
      "section": "第（Ⅰ）①问：求点 P 和点 A 的坐标",
      "title": "第1步：求二次函数顶点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "抛物线为 y＝－x²－2x＋3"
        ],
        [
          "计算",
          "配方，得 y＝－(x＋1)²＋4"
        ],
        [
          "∴",
          "顶点为 P(－1,4)"
        ]
      ],
      "box": [
        "P(－1,4)"
      ]
    },
    {
      "id": "teach:parameterize_axis_point_E_i",
      "section": "第（Ⅰ）②问：求点 E 的坐标",
      "title": "第1步：设对称轴上的参数点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "E 在对称轴 x＝－1 上"
        ],
        [
          "设",
          "E(－1,t)"
        ]
      ],
      "box": [
        "E(－1,t)"
      ],
      "localControls": {
        "values": {
          "t": 0.0
        },
        "controls": [
          {
            "var": "t",
