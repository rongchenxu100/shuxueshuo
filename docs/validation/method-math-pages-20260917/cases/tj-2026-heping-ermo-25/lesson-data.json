          }
        ],
        "note": "拖动仅用于观察当前步骤中的参数变化，不改变数学定义域。"
      }
    },
    {
      "id": "teach:derive_parametric_parabola_ii",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第1步：化简函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "A(－c,0) 在 y＝－x²＋bx＋c 上"
        ],
        [
          "∴",
          "代入 A 点坐标，得 0＝－c²－bc＋c＝－c(b＋c－1)"
        ],
        [
          "∵",
          "c＞1"
        ],
        [
          "计算",
          "化简上述方程，得 b＝1－c"
        ],
        [
          "∴",
          "y＝－x²＋(1－c)x＋c"
        ]
      ],
      "box": [
        "y＝－x²＋(1－c)x＋c"
      ]
    },
    {
      "id": "teach:derive_path_minimum_ii:quadratic_square_path_minimum/path_reduction",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第2步：利用正方形关系化简路径",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "FM=AE/2，HF=AG/2，AE=AG"
        ],
        [
          "∴",
          "HF+FM=AG"
        ],
        [
          "∴",
          "HF+FM+MG＝AG+MG"
        ]
      ],
      "box": [
        "HF+FM+MG＝AG+MG"
      ],
      "localControls": {
        "values": {
          "u": 0.35
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 G：ME/AM",
            "min": -1.25,
            "max": 1.25,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动 E，观察正方形与动点 G 的联动关系。"
      }
    },
    {
      "id": "teach:derive_path_minimum_ii:quadratic_square_path_minimum/reflection_minimum",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第3步：确定G的轨迹并用反射求最短路径",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "G 的轨迹为 y=-c/2-1/2"
        ],
        [
          "作",
          "关于该轨迹构造 A′(-c,-c-1)"
        ],
        [
          "∵",
          "AG=A′G"
        ],
        [
          "∴",
          "AG+MG＝A′G+MG≥A′M"
        ],
        [
          "∴",
          "最小值为 √5|c+1|/2"
        ],
        [
          "∴",
          "在 G(1/4-3c/4,-c/2-1/2) 处取得"
        ]
      ],
      "box": [
        "最小值为 √5|c+1|/2",
        "取等点为 G(1/4-3c/4,-c/2-1/2)"
      ],
      "localControls": {
        "values": {
          "u": 0.35
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 G：ME/AM",
            "min": -1.25,
            "max": 1.25,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动 E，观察正方形与动点 G 的联动关系。"
      }
    },
    {
      "id": "teach:solve_parameter_c_ii",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第4步：由表达式取值反求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设要求 √5|c＋1|/2＝3√5"
        ],
        [
          "计算",
          "解方程，得 c＝－7 或 c＝5"
        ],
        [
          "∵",
          "根据 c＞1，保留 c＝5"
        ],
        [
          "∴",
          "c＝5"
        ]
      ],
      "box": [
        "c＝5"
      ]
    },
    {
      "id": "teach:evaluate_point_A_ii",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第5步：代入参数求点坐标",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "A(-c,0)，c＝5"
        ],
        [
          "计算",
          "将 c＝5 代入：x_A＝－c＝－5，y_A＝0＝0"
        ],
        [
          "∴",
          "A(-5,0)"
        ]
      ],
      "box": [
        "A(-5,0)"
      ]
    },
    {
      "id": "teach:evaluate_minimum_point_G_ii",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第6步：代入参数求点坐标",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "G(1/4-3c/4,-c/2-1/2)，c＝5"
        ],
        [
          "计算",
          "将 c＝5 代入：x_G＝1/4－3c/4＝－7/2，y_G＝－c/2－1/2＝－3"
        ],
        [
          "∴",
          "G(-7/2,-3)"
        ]
      ],
      "box": [
        "G(-7/2,-3)"
      ]
    },
    {
      "id": "teach:recover_target_point_E_ii",
      "section": "第（Ⅱ）问：求点 E 的坐标",
      "title": "第7步：由正方形求相邻顶点E",
      "t": 0.75,
      "derive": [
        [
          "作",
          "GQ⊥x轴于 Q"
        ],
        [
          "∵",
          "四边形 AEKG 是正方形"
        ],
        [
          "∴",
          "AG＝AE，∠GAE＝90°"
        ],
        [
          "∵",
          "∠GQA＝∠EMA＝90°"
        ],
        [
          "∴",
          "∠GAQ＝∠AEM"
        ],
        [
          "∴",
          "Rt△AGQ≌Rt△EAM"
        ],
        [
          "∴",
          "AM＝QG＝3，EM＝AQ＝3/2"
        ],
        [
          "∵",
          "按正方形顶点顺序选取 E"
        ],
        [
          "∴",
          "E(－2,3/2)"
        ]
      ],
      "box": [
        "E(－2,3/2)"
      ]
    }
