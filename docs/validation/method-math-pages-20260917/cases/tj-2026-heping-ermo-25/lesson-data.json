        "note": "拖动仅用于观察当前步骤中的参数变化，不改变数学定义域。"
      }
    },
    {
      "id": "teach:derive_square_vertex_G_i",
      "section": "第（Ⅰ）②问：求点 E 的坐标",
      "title": "第2步：由正方形求相邻顶点G",
      "t": 0.75,
      "derive": [
        [
          "作",
          "GQ⊥x轴于 Q"
        ],
        [
          "∵",
          "四边形 AEKG 是正方形"
        ],
        [
          "∴",
          "AE＝AG，∠EAG＝90°"
        ],
        [
          "∵",
          "∠EMA＝∠GQA＝90°"
        ],
        [
          "∴",
          "∠EAM＝∠AGQ"
        ],
        [
          "∴",
          "Rt△AEM≌Rt△GAQ"
        ],
        [
          "∴",
          "AQ＝ME＝t，GQ＝AM＝2"
        ],
        [
          "∵",
          "G 在 x 轴下方"
        ],
        [
          "∴",
          "G(t－3,－2)"
        ]
      ],
      "box": [
        "G(t－3,－2)"
      ],
      "localControls": {
        "values": {
          "t": 0.0
        },
        "controls": [
          {
            "var": "t",
            "label": "参数 t（示意）",
            "min": -4.0,
            "max": 4.0,
            "step": 0.05,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动仅用于观察当前步骤中的参数变化，不改变数学定义域。"
      }
    },
    {
      "id": "teach:solve_axis_point_candidates_i",
      "section": "第（Ⅰ）②问：求点 E 的坐标",
      "title": "第3步：代入抛物线求点E候选",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "E(－1,t) 与 G(t－3,－2) 都由同一参数 t 表示"
        ],
        [
          "∵",
          "G(t－3,－2) 在 y＝－x²－2x＋3 上"
        ],
        [
          "∴",
          "代入曲线点坐标，得 －2＝－(t－3)²－2(t－3)＋3"
        ],
        [
          "计算",
          "整理为 (t－3)²＋2(t－3)－5＝0"
        ],
        [
          "计算",
          "解得 t＝2±√6"
        ],
        [
          "∴",
          "把参数值代回 E(－1,t)，得 E(－1,2＋√6) 或 E(－1,2－√6)"
        ]
      ],
      "box": [
        "E(－1,2＋√6) 或 E(－1,2－√6)"
      ],
      "localControls": {
        "values": {
          "t": 0.0
        },
        "controls": [
          {
            "var": "t",
            "label": "参数 t（示意）",
            "min": -4.0,
            "max": 4.787469,
            "step": 0.05,
            "scale": 1,
            "precision": 2,
            "landmarks": [
              {
                "value": 4.449489742783178,
                "display": "2+√6",
                "epsilon": 0.025
              },
              {
                "value": -0.4494897427831781,
