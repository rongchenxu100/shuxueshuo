  "problem": {
    "summary": "本题二次函数综合：角度条件。",
    "lines": [
      {
        "text": "Γ: y = a*x^2 - b*x + c"
      },
      {
        "text": "b > 0"
      },
      {
        "text": "a = 1"
      },
      {
        "text": "b = 2"
      },
      {
        "text": "c = 3"
      },
      {
        "text": "P = vertex(Γ)"
      },
      {
        "text": "a = 2"
      },
      {
        "text": "A = (-1,0)"
      },
      {
        "text": "A ∈ Γ"
      },
      {
        "text": "D ∈ Γ"
      },
      {
        "text": "Γ ∩ y_axis = {C}"
      },
      {
        "text": "∠CAD = 90°"
      },
      {
        "text": "AC = AD"
      },
      {
        "text": "a = 1"
      },
      {
        "text": "A = (-1,0)"
      },
      {
        "text": "A ∈ Γ"
      },
      {
        "text": "M = (b + 1/2, y_M)"
      },
      {
        "text": "M ∈ Γ"
      },
      {
        "text": "N = (n,0)",
        "answerId": "answer_i_P",
        "answer": "P(1, 2)"
      },
      {
        "text": "n > 0",
        "answerId": "answer_ii_D",
        "answer": "D(√2, 1)"
      },
      {
        "text": "min(sqrt(2)*MN + AN) = 21/4",
        "answerId": "answer_iii_b",
        "answer": "b＝2"
      }
    ]
  },
  "ui": {
    "sliderLabel": "参数",
    "paramLabelPrefix": "b=",
    "goToProblemMode": "doubleScroll",
