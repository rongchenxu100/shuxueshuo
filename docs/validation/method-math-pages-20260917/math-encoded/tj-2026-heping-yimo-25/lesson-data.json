  "steps": [
    {
      "id": "teach:derive_y_intercept_C_i",
      "section": "题目",
      "title": "第1步：求抛物线与 y 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "y 轴上的点满足 x＝0"
        ],
        [
          "计算",
          "代入 x＝0，得 y＝a(0)²＋b(0)－3＝－3"
        ],
        [
          "∴",
          "C(0,－3)"
        ]
      ],
      "box": [
        "C(0,－3)"
      ]
    },
    {
      "id": "teach:derive_translated_D_i",
      "section": "题目",
      "title": "第2步：由平移关系求点坐标",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "C(0,－3) 按向量 (2,0) 平移"
        ],
        [
          "计算",
          "横、纵坐标分别相加：(0＋(2)，－3＋(0))"
        ],
        [
          "∴",
          "D(2,－3)"
        ]
      ],
      "box": [
        "D(2,－3)"
      ]
    },
    {
      "id": "teach:derive_parabola_i",
      "section": "第（Ⅰ）问：公共推导",
      "title": "第1步：求函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "A(－1,0) 在 y＝ax²＋bx－3 上"
        ],
        [
          "∴",
          "代入 A 点坐标，得 0＝a－b－3"
        ],
        [
          "∵",
          "D(2,－3) 在 y＝ax²＋bx－3 上"
        ],
        [
          "∴",
          "代入 D 点坐标，得 －3＝4a＋2b－3"
        ],
        [
          "计算",
          "联立上述方程，得 a＝1，b＝－2"
        ],
        [
          "∴",
          "y＝x²－2x－3＝(x－1)²－4"
        ]
      ],
      "box": [
        "y＝x²－2x－3"
      ]
    },
    {
      "id": "teach:derive_x_intercept_B_i",
      "section": "第（Ⅰ）②问：求 x 轴交点",
      "title": "第1步：求抛物线与 x 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "x 轴交点满足 y＝0，即 x²－2x－3＝0"
        ],
        [
          "计算",
          "x＝－1 或 x＝3"
        ],
        [
          "∵",
          "结合B的定义，取 x＝3"
        ],
        [
          "∴",
          "B(3,0)"
        ]
      ],
      "box": [
        "B(3,0)"
      ]
    },
    {
      "id": "teach:derive_equal_angle_i",
      "section": "第（Ⅰ）②问：求 x 轴交点",
      "title": "第2步：由角和条件推出等角关系",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "C(0,－3)、O(0,0)、B(3,0)，且 OC⊥OB"
        ],
        [
          "计算",
          "OC＝3，OB＝3"
        ],
        [
          "∴",
          "Rt△COB 为等腰直角三角形，所以 ∠CBO＝45°"
        ],
        [
          "∵",
          "∠CBO＝∠CBE＋∠OBE，且 ∠CBE＋∠ACO＝45°"
        ],
        [
          "∴",
          "两式消去公共角 ∠CBE，得 ∠OBE＝∠ACO"
        ]
      ],
      "box": [
        "∠OBE＝∠ACO"
      ]
    },
    {
      "id": "teach:derive_axis_intercept_F_i",
      "section": "第（Ⅰ）②问：求 x 轴交点",
      "title": "第3步：由等角关系求辅助点坐标",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "B、E、F 共线，所以 ∠OBF＝∠OBE＝∠ACO"
        ],
        [
          "∵",
          "Rt△BOF 与 Rt△AOC 均为直角三角形"
        ],
        [
          "∴",
          "tan∠OBF＝OF/OB，tan∠ACO＝AO/CO"
        ],
        [
          "∴",
          "OF/OB＝AO/CO"
        ],
        [
          "计算",
          "OB＝3，AO＝1，CO＝3，所以 OF＝1"
        ],
        [
          "∵",
          "F 在 y 轴负半轴上"
        ],
        [
          "∴",
          "F(0,－1)"
        ]
      ],
      "box": [
        "F(0,－1)"
      ]
    },
    {
      "id": "teach:derive_curve_intersection_E_i",
      "section": "第（Ⅰ）②问：求 x 轴交点",
      "title": "第4步：联立直线与抛物线求交点",
      "t": 0.75,
      "derive": [
        [
          "作",
          "连接 B(3,0)、F(0,－1)，得直线 y＝1/3x－1"
        ],
        [
          "计算",
          "联立 y＝1/3x－1 与 y＝x²－2x－3，得 x＝－2/3 或 x＝3"
        ],
        [
          "∵",
          "B(3,0) 是已知交点，排除 x＝3"
        ],
        [
          "∴",
          "另一交点为 E(－2/3,－11/9)"
        ]
      ],
      "box": [
        "E(－2/3,－11/9)"
      ]
    },
    {
      "id": "teach:derive_parametric_parabola_ii",
      "section": "第（Ⅱ）问：化简解析式",
      "title": "第1步：化简函数解析式",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "A(－1,0) 在 y＝ax²＋bx－3 上"
        ],
        [
          "∴",
          "代入 A 点坐标，得 0＝a－b－3"
        ],
        [
          "∵",
          "a＞0"
        ],
        [
          "计算",
          "化简上述方程，得 b＝a－3"
        ],
        [
          "∴",
          "y＝ax²＋(a－3)x－3"
        ]
      ],
      "box": [
        "y＝ax²＋(a－3)x－3"
      ]
    },
    {
      "id": "teach:derive_x_intercept_B_ii",
      "section": "第（Ⅱ）问：化简解析式",
      "title": "第2步：求抛物线与 x 轴交点",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "x 轴交点满足 y＝0，即 ax²＋(a－3)x－3＝0"
        ],
        [
          "计算",
          "x＝－1 或 x＝3/a"
        ],
        [
          "∵",
          "结合B的定义，取 x＝3/a"
        ],
        [
          "∴",
          "B(3/a,0)"
        ]
      ],
      "box": [
        "B(3/a,0)"
      ]
    },
    {
      "id": "teach:reduce_equal_length_ray_path_ii:equal_length_ray_path_reduction/path_reduction",
      "section": "第（Ⅱ）问：化简解析式",
      "title": "第3步：构造等长辅助点，把两动点路径化为单动点路径",
      "t": 0.75,
      "derive": [
        [
          "作",
          "在射线CD上构造G，使CG＝CB"
        ],
        [
          "∵",
          "CN＝CM；CB＝CG；M在线段CB上，N、G在射线CD上，故∠BCN＝∠GCM"
        ],
        [
          "∴",
          "△BCN≌△GCM（边角边），故BN＝MG"
        ],
        [
          "∴",
          "OM＋BN＝OM＋MG"
        ]
      ],
      "box": [
        "OM＋BN＝OM＋MG"
      ],
      "localControls": {
        "values": {
          "u": 0.699333
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 M：CM/CB",
            "min": 0,
            "max": 1,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          },
          {
            "var": "u",
            "label": "动点 N：CN/CG",
            "min": 0,
            "max": 1,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动线段上的动点，射线上的动点按等长条件联动。"
      }
    },
    {
      "id": "teach:reduce_equal_length_ray_path_ii:equal_length_ray_path_reduction/minimum_by_segment",
      "section": "第（Ⅱ）问：化简解析式",
      "title": "第4步：在单动点路径中求最小值",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "OM＋BN＝OM＋MG"
        ],
        [
          "∴",
          "OM＋MG≥OG"
        ],
        [
          "计算",
          "OG＝√[(3√(a²＋1)/|a|)²＋(－3)²]＝3√(2a²＋1)/|a|"
        ],
        [
          "∴",
          "路径最小值为 3√(2a²＋1)/|a|"
        ]
      ],
      "box": [
        "路径最小值为 3√(2a²＋1)/|a|"
      ],
      "localControls": {
        "values": {
          "u": 0.6993331814234481
        },
        "controls": [
          {
            "var": "u",
            "label": "动点 M：CM/CB",
            "min": 0,
            "max": 1,
            "step": 0.01,
            "scale": 1,
            "precision": 2
          }
        ],
        "note": "拖动动点，观察单动点路径何时取最小值。"
      }
    },
    {
      "id": "teach:solve_parameter_from_minimum_ii",
      "section": "第（Ⅱ）问：化简解析式",
      "title": "第5步：由表达式取值反求参数",
      "t": 0.75,
      "derive": [
        [
          "∵",
          "题设要求 3√(2a²＋1)/|a|＝√34"
        ],
        [
          "计算",
          "解方程，得 a＝－3/4 或 a＝3/4"
        ],
        [
          "∵",
          "根据 a＞0，保留 a＝3/4"
        ],
        [
          "∴",
          "a＝3/4"
        ]
      ],
      "box": [
        "a＝3/4"
      ]
    }
  ],
