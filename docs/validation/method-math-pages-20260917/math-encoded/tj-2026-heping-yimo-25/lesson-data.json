  "problem": {
    "summary": "本题二次函数综合：综合解题。",
    "lines": [
      {
        "text": "Γ: y = a*x^2+b*x-3"
      },
      {
        "text": "a > 0"
      },
      {
        "text": "A = (-1,0)"
      },
      {
        "text": "Γ ∩ x_axis = {A,B}"
      },
      {
        "text": "Γ ∩ y_axis = {C}"
      },
      {
        "text": "D = C+(2,0)"
      },
      {
        "text": "O = (0,0)"
      },
      {
        "text": "D ∈ Γ"
      },
      {
        "text": "①"
      },
      {
        "text": "E ∈ Γ"
      },
      {
        "text": "x(E) = m"
      },
      {
        "text": "-1 < m ∧ m < 0"
      },
      {
        "text": "angle(C,B,E) + angle(A,C,O) = 45°"
      },
      {
        "text": "M ∈ segment(B,C)"
      },
      {
        "text": "N ∈ ray(C,D)",
        "answerId": "answer_i_1_parabola",
        "answer": "y＝x²－2x－3"
      },
      {
        "text": "CN = CM",
        "answerId": "answer_i_2_E",
        "answer": "E(－2/3, －11/9)"
      },
      {
        "text": "min(OM+BN) = √34",
        "answerId": "answer_ii_a",
        "answer": "a＝3/4"
      }
    ]
  },
  "ui": {
    "sliderLabel": "参数",
    "paramLabelPrefix": "a=",
