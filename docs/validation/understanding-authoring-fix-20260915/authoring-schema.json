        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "id",
        "page",
        "bbox"
      ],
      "additionalProperties": false
    },
    "SourceUnit": {
      "type": "object",
