{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "problem-understanding/v1"
    },
    "transcription": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "problem-transcription/v1"
        },
        "problem_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "$ref": "#/$defs/Part"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Region"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Figure"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "source_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceGap"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "problem_id",
        "source_sha256",
        "root",
        "regions",
        "figures",
        "source_gaps"
      ],
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "problem-domain/v2"
        },
        "problem_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "transcription_revision": {
          "const": "response.transcription"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "root": {
          "$ref": "#/$defs/Scope"
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Definition"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "coverage": {
          "const": "from_source_unit_ids"
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DomainGap"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "schema_version",
        "problem_id",
        "source_sha256",
        "transcription_revision",
        "completeness",
        "root",
        "definitions",
        "coverage",
        "gaps"
      ],
      "additionalProperties": false
    },
    "match": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "problem-solver-match/v1"
            },
            "transcription_revision": {
              "const": "response.transcription"
            },
            "domain_revision": {
              "const": "response.domain"
            },
            "registry_snapshot": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "status": {
              "const": "matched"
            },
            "family_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "coverage": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MatchCoverage"
              },
              "minItems": 1,
              "maxItems": 256
            },
            "uncovered_requirements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Uncovered"
              },
              "minItems": 0,
              "maxItems": 0
            }
          },
          "required": [
            "schema_version",
            "transcription_revision",
            "domain_revision",
            "registry_snapshot",
            "reason",
            "status",
            "family_id",
            "coverage",
            "uncovered_requirements"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "problem-solver-match/v1"
            },
            "transcription_revision": {
              "const": "response.transcription"
            },
            "domain_revision": {
              "const": "response.domain"
            },
            "registry_snapshot": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "status": {
              "const": "unmatched"
            },
            "family_id": {
              "type": "null"
            },
            "coverage": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/MatchCoverage"
              },
              "minItems": 0,
              "maxItems": 256
            },
            "uncovered_requirements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Uncovered"
              },
              "minItems": 1,
              "maxItems": 256
            }
          },
          "required": [
            "schema_version",
            "transcription_revision",
            "domain_revision",
            "registry_snapshot",
            "reason",
            "status",
            "family_id",
            "coverage",
            "uncovered_requirements"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "transcription",
    "domain",
    "match"
  ],
  "additionalProperties": false,
  "$defs": {
    "Region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
