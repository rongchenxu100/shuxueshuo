          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_unit_refs": {
          "$ref": "#/$defs/shared3"
        },
        "region_refs": {
          "$ref": "#/$defs/shared3"
        }
      },
      "required": [
        "id",
        "reason",
        "description",
        "part_ref",
        "source_unit_refs",
        "region_refs"
      ],
      "additionalProperties": false
