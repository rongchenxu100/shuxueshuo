        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceUnit"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Part"
          },
          "minItems": 0,
          "maxItems": 16
