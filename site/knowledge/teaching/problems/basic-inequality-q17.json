            "resource": "amgm-semicircle",
            "case": "fixed",
            "note": "本题 $\\frac1{5n^2}\\cdot\\frac{4n^2}5=\\frac4{25}$ 是定值：定积求和。"
          },
          "title": "观察和积结构",
          "position": 3
        },
        "amgm": {
          "refs": [
            "skill-apply-amgm",
            "amgm-formula#formula"
          ],
          "tip": {
            "ref": "amgm-formula#formula",
            "resource": "amgm-semicircle",
            "case": "apply",
            "note": "本题 $\\frac1{5n^2}+\\frac{4n^2}5\\ge2\\sqrt{\\frac4{25}}=\\frac45$。"
          },
          "title": "应用基本不等式",
          "position": 4
        },
        "equality": {
          "refs": [
            "method-amgm-direct#attain",
            "amgm-formula#attainability"
          ],
          "tip": {
            "ref": "amgm-formula#attainability",
            "resource": "amgm-semicircle",
            "case": "equal",
            "note": "本题取等要 $\\frac1{5n^2}=\\frac{4n^2}5$，即 $n^2=\\frac12$，此时 $m^2=\\frac3{10}\\ge0$，取得到。"
          },
          "title": "验证取等",
          "position": 5
        }
      },
      "label": "消参法"
    }
