{
  "topic": "basic-inequality",
  "id": "basic-inequality-q27",
  "label": "Q27",
  "path": "/1/q27/",
  "types": [
    "type-sum-product-extremum"
  ],
  "routes": {
    "reciprocal": {
      "methods": [
        "method-amgm-direct"
      ],
      "steps": {
        "transform": {
          "refs": [
            "skill-inequality-transform",
            "inequality-properties#reciprocal"
          ],
          "tip": {
            "ref": "inequality-properties#reciprocal",
            "resource": "order-flip-lines",
            "note": "本题 $x>0$ 时 $y=\\frac{2x+1}{x^2+1}>0$；同正取倒数，大小顺序颠倒，$y$ 最大对应 $\\frac1y$ 最小。"
          },
          "title": "转化目标",
          "position": 1
        },
        "substitution": {
          "refs": [
            "method-substitution"
          ],
          "tip": {
            "ref": "method-substitution",
            "resource": "substitution-denominator",
            "note": "本题令 $t=2x+1>1$，$x=\\frac{t-1}2$，$x^2+1=\\frac{t^2-2t+5}4$。"
          },
          "title": "换元",
          "position": 2
        },
        "split": {
          "refs": [
            "method-fraction-split"
          ],
          "tip": {
            "ref": "method-fraction-split",
            "resource": "fraction-split-degree",
            "note": "本题 $\\frac1y=\\frac{t^2-2t+5}{4t}=\\frac14\\left(t-2+\\frac5t\\right)$。"
          },
          "title": "分式分离",
          "position": 3
        },
        "structure": {
          "refs": [
            "method-amgm-direct#check",
            "amgm-formula#checklist"
          ],
          "tip": {
            "ref": "amgm-formula#checklist",
            "resource": "amgm-semicircle",
            "case": "fixed",
            "note": "本题 $t\\cdot\\frac5t=5$ 是定值：定积求和。"
          },
          "title": "观察和积结构",
          "position": 4
        },
        "amgm": {
          "refs": [
            "skill-apply-amgm",
            "amgm-formula#formula"
          ],
          "tip": {
            "ref": "amgm-formula#formula",
            "resource": "amgm-semicircle",
            "case": "apply",
            "note": "本题 $t+\\frac5t\\ge2\\sqrt5$，$\\frac1y\\ge\\frac{2\\sqrt5-2}4=\\frac{\\sqrt5-1}2$。"
          },
          "title": "应用基本不等式",
          "position": 5
        },
        "equality": {
          "refs": [
            "method-amgm-direct#attain",
            "amgm-formula#attainability"
          ],
          "tip": {
            "ref": "amgm-formula#attainability",
            "resource": "amgm-semicircle",
            "case": "equal",
            "note": "本题取等要 $t=\\sqrt5>1$，即 $x=\\frac{\\sqrt5-1}2>0$，取得到。"
          },
          "title": "验证取等",
          "position": 6
        },
        "back": {
          "refs": [
            "skill-inequality-transform",
            "inequality-properties#reciprocal"
          ],
          "tip": {
            "ref": "inequality-properties#reciprocal",
            "resource": "order-flip-lines",
            "note": "本题 $\\frac1y\\ge\\frac{\\sqrt5-1}2>0$，取倒数变向：$y\\le\\frac2{\\sqrt5-1}=\\frac{\\sqrt5+1}2$。"
          },
          "title": "换回 y",
          "position": 7
        }
      },
      "label": "取倒数后分式分离"
    }
  },
  "statement": "若 $x>0$，求函数 $y=\\frac{2x+1}{x^2+1}$ 的最大值。",
