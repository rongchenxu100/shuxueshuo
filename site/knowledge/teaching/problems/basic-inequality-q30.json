          "refs": [
            "method-sum-product#identities"
          ],
          "tip": {
            "ref": "method-sum-product#identities",
            "resource": "sum-product-identities",
            "note": "本题交换 $a$、$b$ 后，$2ab=a+2b+3$ 变成 $2ab=b+2a+3$，$a+2b$ 也变了，都不对称。"
          },
          "title": "识别对称结构",
          "position": 1
        },
        "construct": {
          "refs": [
            "method-substitution",
            "method-sum-product#identities"
          ],
          "tip": {
            "ref": "method-sum-product#identities",
            "resource": "sum-product-identities",
            "case": "construct",
            "note": "本题令 $x=a$，$y=2b$：条件 $2ab=a+2b+3$ 化成 $xy=x+y+3$，目标 $a+2b=x+y$，都对称。"
          },
          "title": "构造对称",
          "position": 2
        },
        "substitution": {
          "refs": [
            "method-sum-product"
          ],
          "title": "和积换元",
          "position": 3
        },
        "condition": {
          "refs": [
            "method-sum-product#identities",
            "skill-equality-transform"
          ],
          "tip": {
            "ref": "method-sum-product#identities",
            "resource": "sum-product-identities",
            "note": "本题 $xy=x+y+3$，即 $p=s+3$。"
          },
          "title": "改写条件",
          "position": 4
        },
        "inequality": {
          "refs": {
            "field": "inequality_form",
            "options": {
              "p_le": [
                "square-nonnegative#sum-product",
                "method-sum-product#feasible"
              ],
              "s_ge": [
                "amgm-formula#formula",
                "skill-apply-amgm",
                "method-amgm-direct#bound"
              ]
            }
          },
          "tip": {
            "field": "inequality_form",
            "options": {
              "p_le": {
                "ref": "square-nonnegative#sum-product",
                "resource": "square-area",
                "note": "本题由 $(x-y)^2\\ge0$ 得 $p\\le\\frac{s^2}4$，代入 $p=s+3$ 得 $s^2-4s-12\\ge0$。"
              },
              "s_ge": {
                "ref": "amgm-formula#formula",
                "resource": "amgm-semicircle",
                "case": "apply",
                "note": "本题 $x,y>0$，$s\\ge2\\sqrt p$，代入 $p=s+3$ 得 $s\\ge2\\sqrt{s+3}$，两边平方得 $s^2-4s-12\\ge0$。"
              }
            }
          },
          "title": "选不等式",
          "position": 5
        },
        "solve": {
          "refs": [
            "quadratic-inequality-solve"
          ],
          "tip": {
            "ref": "quadratic-inequality-solve",
            "resource": "quadratic-sign-reading",
            "note": "本题 $s^2-4s-12=(s+2)(s-6)\\ge0$，得 $s\\le-2$ 或 $s\\ge6$；又 $s=x+y>0$，所以 $s\\ge6$。"
          },
          "title": "解不等式",
          "position": 6
        },
        "equality": {
          "refs": [
            "square-nonnegative#nonnegative",
            "function-range-extrema#attainability",
            "square-nonnegative"
          ],
          "tip": {
            "ref": "square-nonnegative",
            "resource": "square-area",
            "note": "本题取等要 $x=y$，又 $s=6$，所以 $x=y=3$，即 $a=3$，$b=\\frac32$。"
          },
          "title": "验证取等",
          "position": 7
        }
      },
      "label": "找对称结构，和积换元"
    },
    "elimination": {
      "methods": [
        "method-amgm-direct"
      ],
      "steps": {
        "eliminate": {
          "refs": [
            "method-elimination"
          ],
          "title": "消元定范围",
          "position": 1
        },
        "split": {
          "refs": [
            "method-fraction-split"
          ],
          "tip": {
            "ref": "method-fraction-split",
            "resource": "fraction-split-degree",
            "note": "本题 $\\frac{a+3}{a-1}=1+\\frac4{a-1}$，所以 $a+2b=a+1+\\frac4{a-1}=(a-1)+\\frac4{a-1}+2$。"
          },
          "title": "分式分离",
          "position": 2
        },
        "structure": {
          "refs": [
            "method-amgm-direct#check",
            "amgm-formula#checklist"
          ],
          "tip": {
            "ref": "amgm-formula#checklist",
            "resource": "amgm-semicircle",
            "case": "fixed",
            "note": "本题 $(a-1)\\cdot\\frac4{a-1}=4$ 是定值（$a>1$）：定积求和。"
          },
          "title": "观察和积结构",
          "position": 3
        },
        "amgm": {
          "refs": [
            "skill-apply-amgm",
            "amgm-formula#formula"
          ],
          "tip": {
            "ref": "amgm-formula#formula",
            "resource": "amgm-semicircle",
            "case": "apply",
            "note": "本题 $(a-1)+\\frac4{a-1}\\ge2\\sqrt4=4$，$a+2b\\ge6$。"
          },
          "title": "应用基本不等式",
          "position": 4
        },
        "equality": {
          "refs": [
            "method-amgm-direct#attain",
            "amgm-formula#attainability"
          ],
          "tip": {
            "ref": "amgm-formula#attainability",
            "resource": "amgm-semicircle",
            "case": "equal",
            "note": "本题取等要 $a-1=2$，即 $a=3$，$b=\\frac32$，取得到。"
          },
          "title": "验证取等",
          "position": 5
        }
      },
      "label": "消元后分式分离"
    }
  },
  "statement": "已知 $a>0$，$b>0$，且 $2ab=a+2b+3$，求 $a+2b$ 的最小值。",
