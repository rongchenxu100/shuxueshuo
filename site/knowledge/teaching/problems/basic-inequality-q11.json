            "resource": "homogeneous-degree-count",
            "note": "本题令 $t=a+1$，则 $t+b=3$；$\\frac2t+\\frac4b$ 是负一次，$t+b$ 是一次，相乘得零次式。"
          },
          "title": "识别齐次结构",
          "position": 2
        },
        "rewrite": {
          "refs": [
            "method-homogeneous"
          ],
          "tip": {
            "ref": "method-homogeneous",
            "resource": "homogeneous-degree",
            "note": "本题 $t+b=3$ 不等于 $1$，要乘 $\\frac{t+b}3=1$：原式 $=\\frac13\\left(\\frac2t+\\frac4b\\right)(t+b)$。"
          },
          "title": "配齐次式",
          "position": 3
        },
        "structure": {
          "refs": [
            "method-amgm-direct#check",
            "amgm-formula#checklist"
          ],
          "tip": {
            "ref": "amgm-formula#checklist",
            "resource": "amgm-semicircle",
            "case": "fixed",
            "note": "本题展开得 $\\frac13\\left(6+\\frac{2b}t+\\frac{4t}b\\right)$，$\\frac{2b}t\\cdot\\frac{4t}b=8$ 是定值：定积求和。"
          },
          "title": "观察和积结构",
          "position": 4
        },
        "amgm": {
          "refs": [
            "skill-apply-amgm",
            "amgm-formula#formula"
          ],
          "tip": {
            "ref": "amgm-formula#formula",
            "resource": "amgm-semicircle",
            "case": "apply",
            "note": "本题 $\\frac{2b}t+\\frac{4t}b\\ge2\\sqrt8=4\\sqrt2$，原式 $\\ge\\frac{6+4\\sqrt2}3$。"
          },
          "title": "应用基本不等式",
          "position": 5
        },
        "equality": {
          "refs": [
            "method-amgm-direct#attain",
            "amgm-formula#attainability"
          ],
          "tip": {
            "ref": "amgm-formula#attainability",
            "resource": "amgm-semicircle",
            "case": "equal",
            "note": "本题取等要 $b=\\sqrt2t$，与 $t+b=3$ 联立得 $t=3(\\sqrt2-1)$，在 $(1,3)$ 内，取得到。"
          },
          "title": "验证取等",
          "position": 6
        }
      },
      "label": "换元法"
    }
