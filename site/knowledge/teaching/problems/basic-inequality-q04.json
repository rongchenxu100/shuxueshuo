            "resource": "order-flip-lines",
            "note": "本题由 $(-x)+\\left(-\\frac4x\\right)\\ge4$，两边乘 $-1$ 要变向：$x+\\frac4x\\le-4$，再减 $4$ 得原式 $\\le-8$。"
          },
          "title": "回到原式",
          "position": 3
        },
        "equality": {
          "refs": [
            "method-amgm-direct#attain",
            "amgm-formula#attainability"
