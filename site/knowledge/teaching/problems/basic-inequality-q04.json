            "case": "positive",
            "note": "本题 $x<0$，$x$ 与 $\\frac4x$ 都是负数，不满足一正；先提出负号，对正数 $-x$、$-\\frac4x$ 用基本不等式。"
          },
          "title": "整理表达式",
          "position": 1
        },
        "amgm": {
          "refs": [
            "skill-apply-amgm",
            "amgm-formula#formula"
          ],
          "tip": {
            "ref": "amgm-formula#formula",
            "resource": "amgm-semicircle",
            "case": "apply",
            "note": "本题 $(-x)+\\left(-\\frac4x\\right)\\ge2\\sqrt{(-x)\\cdot\\left(-\\frac4x\\right)}=4$。"
          },
          "title": "应用基本不等式",
          "position": 2
        },
        "bound": {
          "refs": [
            "skill-inequality-transform",
            "inequality-properties#multiplication"
