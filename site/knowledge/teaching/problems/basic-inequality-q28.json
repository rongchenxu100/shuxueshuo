          "tip": {
            "ref": "square-nonnegative",
            "resource": "square-area",
            "note": "本题 $x,y$ 是任意实数，由 $(x-y)^2\\ge0$ 得 $p\\le\\frac{s^2}4$；代入 $p=\\frac{s^2-1}3$ 得 $s^2\\le4$。"
          },
          "title": "选不等式",
          "position": 4
        },
