              "tip": {
                "ref": "function-range-extrema#quantified",
                "resource": "quantified-horizontal-line",
                "case": "forall-lt",
                "note": "本题把 $m$ 当主元，$f(m)<0$ 对所有 $m\\in[1,3]$ 成立：恒成立、小于，看最高点。"
              },
              "title": "转化为最值条件",
              "position": 3
            },
            "v_extremum": {
