  "knowledgeGroups": [
    {
      "id": "representations",
      "label": "三种表示与对应关系",
      "description": "解析式、表格和图像都在表达输入与输出的对应关系。完整列表只适用于有限定义域，不能凭几个采样值确定一个未知函数。",
      "refs": [
        "function-representations",
        "function-concept"
      ]
    },
    {
      "id": "formula-foundations",
      "label": "求解析式的基础",
      "description": "识别完整的函数输入，利用题给函数类型或恒等关系恢复规则；换元与化简时保留原式限制，并说明哪些输入上的规则已经确定。",
      "refs": [
        "equality-properties",
        "square-root-expression",
        "rational-expression",
        "linear-interval-extremum",
        "quadratic-function-properties",
        "reciprocal-function"
      ]
    },
    {
      "id": "graphs",
      "label": "图像与变换",
      "description": "用关键点理解平移、对称和绝对值翻折。水平变换同时改变输入范围，空心点与实心点也要随之移动。",
      "refs": [
        "function-graph-transformations",
        "absolute-value-function",
        "absolute-value-concept"
      ]
    },
    {
      "id": "piecewise",
      "label": "分段规则与范围",
      "description": "每段表达式只在本段范围内使用。求值先选段，逆向解题后还要验段；复合时根据中间值重新选段，各段结果按原目标合并。",
      "refs": [
        "piecewise-function",
        "interval-notation",
        "set-intersection-union"
      ]
    }
  ],
