{
  "schemaVersion": 1,
  "id": "function-concepts",
  "label": "函数的概念",
  "path": "/topics/function-concepts/",
  "presentation": "topic-overview",
  "introduction": "从定义域、对应关系和值域认识函数，练习函数判等、输入范围、整体代入与值域求解。",
  "chapter": {
    "book": "人教 A 版 · 必修第一册",
    "number": "第三章",
    "label": "函数的概念与性质",
    "section": "3.1",
    "ref": "section-3-1"
  },
  "knowledge": [
    "function-concept",
    "interval-notation",
    "set-intersection-union",
    "quantifiers",
    "rational-expression",
    "square-root-expression",
    "integer-power",
    "absolute-value-concept",
    "equality-properties",
    "inequality-properties",
    "function-range-extrema",
    "function-monotonicity",
    "linear-interval-extremum",
    "quadratic-function-properties",
    "square-nonnegative",
    "reciprocal-function",
    "reciprocal-sum-function",
    "quadratic-equation",
    "quadratic-inequality",
    "function-graph-transformations"
  ],
  "knowledgeGroups": [
    {
      "id": "function-inputs",
      "label": "函数与输入范围",
      "description": "判等先比较定义域与对应关系；复合写法要区分自变量的范围与 $f$ 的输入范围。多个条件同时满足取交集，分支结果合并取并集；求参时分清“全部满足”与“至少一次成立”。",
      "refs": ["function-concept", "interval-notation", "set-intersection-union", "quantifiers"]
    },
    {
      "id": "expression-conditions",
      "label": "表达式条件与整体代入",
      "description": "从原式列出分母、根式与零次幂的限制，化简后仍保留。求值时把完整输入代入，复合调用从内到外计算；求参时，条件的解集须与题给定义域一致。",
      "refs": ["rational-expression", "square-root-expression", "integer-power", "absolute-value-concept", "equality-properties", "inequality-properties"]
    },
    {
      "id": "function-ranges",
      "label": "值域与函数性质",
      "description": "先确定定义域，再比较端点、顶点与边界。换元时同步求新变量的准确范围，有限输入逐项求值；值域的端点取舍由能否取到决定。",
      "refs": ["function-range-extrema", "function-monotonicity", "linear-interval-extremum", "quadratic-function-properties", "square-nonnegative"]
    },
    {
      "id": "range-transformations",
      "label": "分式与图像变换",
      "description": "分式先分离常数，再求分母或对勾函数的范围，分段取倒数并还原。方程有实根法要检查降次；由周期性得到整段平移时，确认完整输入段覆盖目标范围。",
      "refs": ["reciprocal-function", "reciprocal-sum-function", "quadratic-equation", "quadratic-inequality", "function-graph-transformations"]
    }
  ],
  "groups": [
    {
      "id": "domain",
      "label": "求函数的定义域",
      "type": "type-function-domain",
      "description": "结合题设范围与表达式有意义的条件，确定允许的输入。",
      "problems": [
        "function-concepts-q15",
        "function-concepts-q01",
        "function-concepts-q22-v2",
        "function-concepts-q04",
        "function-concepts-q12",
        "function-concepts-q23b"
      ]
    },
    {
      "id": "equality",
      "label": "判断是否为同一函数",
      "type": "type-function-equality",
      "description": "比较定义域与对应关系，保留原式的输入限制。",
      "problems": [
        "function-concepts-q20-v2",
        "function-concepts-q19"
      ]
    },
    {
      "id": "abstract-domain",
      "label": "求抽象函数的定义域",
      "type": "type-abstract-function-domain",
      "description": "区分自变量范围与函数输入范围，求复合式的定义域，或根据共同输入存在求参数。",
      "problems": [
        "function-concepts-q25",
        "function-concepts-q26",
        "function-concepts-abstract-mixed-q03",
        "function-concepts-parameter-variant02"
      ]
    },
    {
      "id": "evaluation",
      "label": "求函数值",
      "type": "type-function-evaluation",
      "description": "把完整输入代入函数规则，逐层求值，保留输入限制，并验证定值与配对求和。",
      "problems": [
        "function-concepts-q28a",
        "function-concepts-q28b",
        "function-concepts-q28c",
        "function-concepts-q28d",
        "function-concepts-q29b"
      ]
    },
    {
      "id": "range",
      "label": "求函数的值域",
      "type": "type-function-range",
      "groupBy": "method",
      "description": "在定义域内确定所有可能的输出，并核对边界能否取到。",
      "problems": [
        "function-concepts-range-q03",
        "function-concepts-range-q05",
        "function-concepts-range-q06",
        "function-concepts-range-q07",
        "function-concepts-range-q08",
