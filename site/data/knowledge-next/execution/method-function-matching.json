            "formula_result": "$simplified_formula_result"
          },
          "outputs": {
            "formula_result": "formula_result"
          },
          "order": 3
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "square",
          "after": "verify_formula_identity",
          "template": "function_formula_derivation",
          "bindings": {
            "description": "$description",
            "formula_result": "$formula_result",
            "phase": "square",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "formula_result"
          ]
        },
        {
          "id": "match",
          "after": "verify_formula_identity",
          "template": "function_formula_derivation",
          "bindings": {
            "description": "$description",
            "formula_result": "$formula_result",
            "phase": "match",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "formula_result"
          ]
        },
        {
          "id": "rename",
          "after": "verify_formula_identity",
          "template": "function_formula_derivation",
          "bindings": {
            "description": "$description",
            "formula_result": "$formula_result",
            "phase": "rename",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "formula_result"
          ]
        },
        {
          "id": "coverage",
          "after": "verify_formula_identity",
          "template": "function_formula_derivation",
          "bindings": {
            "description": "$description",
            "formula_result": "$formula_result",
            "phase": "coverage",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "formula_result"
          ]
        }
      ]
    },
    {
      "id": "verify",
      "calls": [],
      "judgments": [],
      "display_units": []
    }
  ],
  "outputs": {
    "formula_result": "$formula_result"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "admission": {
    "bindings": {
      "context": {
        "resolver": "constraint_context"
      }
    },
    "checks": [
      {
        "function": "function_matching",
        "inputs": {
          "context": "$context"
        }
      }
    ]
  }
}
