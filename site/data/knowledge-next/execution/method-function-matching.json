{
  "schema_version": "graph-method-execution/v1",
  "method": "method-function-matching",
  "inputs": {
    "context": {
      "role": "constraint_context"
    }
  },
  "steps": [
    {
      "id": "recover",
      "calls": [
        {
          "id": "recover",
          "capability": "solve_function_matching",
          "public_ref": null,
          "inputs": {
            "context": "$context"
          },
          "outputs": {
            "description": "description",
            "raw_formula_result": "formula_result"
          },
          "order": 0
        },
        {
          "id": "match",
          "capability": "complete_matching_identity",
          "public_ref": "method-complete-square",
          "inputs": {
