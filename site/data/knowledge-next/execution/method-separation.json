{
  "method": "method-separation",
  "inputs": {
    "relation": {
      "role": "relation"
    },
    "expression": {
      "role": "expression"
    },
    "x": {
      "role": "x"
    },
    "parameter": {
      "role": "parameter"
    },
    "domain": {
      "role": "domain"
    },
    "quantifier": {
      "role": "quantifier"
    },
    "strict": {
      "role": "strict"
    },
    "goal": {
      "role": "goal"
    },
    "constraint_context": {
      "role": "constraint_context"
    },
    "relation_kind": {
      "role": "relation_kind"
    },
    "function_name": {
      "role": "function_name"
    }
  },
  "steps": [
    {
      "id": "separate",
      "calls": [
        {
          "id": "inspect",
          "capability": "separate_parameter",
          "public_ref": null,
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {
            "separation_candidate": "candidate",
            "already_separated": "already_separated"
          },
          "order": -1
        },
        {
          "id": "inequality",
          "capability": "separation_division",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain",
            "prepared": "$separation_candidate"
          },
          "outputs": {
            "applied_separation": "candidate"
          },
          "guard": {
            "ref": "already_separated",
            "equals": false
          },
          "skip_reason": "already_satisfied",
          "order": 0
        },
        {
          "id": "equality",
          "capability": "separation_division",
          "public_ref": "skill-equality-transform",
          "inputs": {
            "relation": "$relation",
            "parameter": "$parameter",
            "variable": "$x",
            "domain": "$domain"
          },
          "outputs": {},
          "guard": {
            "ref": "relation_kind",
            "equals": "equality"
          },
          "skip_reason": "not_applicable",
          "order": 1
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "separated",
          "after": "inspect",
          "template": "separated",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$separation_candidate.separated_relation"
            ]
          },
          "depends_on": [
            "relation",
            "separation_candidate"
          ],
          "guard": {
            "ref": "already_separated",
            "equals": true
          }
        },
        {
          "id": "divided",
          "after": "inequality",
          "template": "divided",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.moved_relation",
              "$applied_separation.separated_relation"
            ],
            "divisor": "$applied_separation.divisor",
            "moved": "$applied_separation.moved_relation",
            "separated": "$applied_separation.separated_relation",
            "function": "$applied_separation.function",
            "parameter_expression": "$applied_separation.parameter_expression",
            "operator": "$applied_separation.operator",
            "x": "$x",
            "domain": "$domain",
            "function_name": "$function_name"
          },
          "depends_on": [
            "applied_separation",
            "domain",
            "function_name",
            "relation",
            "x"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "positive_division"
          }
        },
        {
          "id": "constant_divided",
          "after": "inequality",
          "template": "constant_divided",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.moved_relation",
              "$applied_separation.separated_relation"
            ],
            "divisor": "$applied_separation.divisor",
            "moved": "$applied_separation.moved_relation",
            "separated": "$applied_separation.separated_relation",
            "function": "$applied_separation.function",
            "parameter_expression": "$applied_separation.parameter_expression",
            "operator": "$applied_separation.operator",
            "x": "$x",
            "function_name": "$function_name"
          },
          "depends_on": [
            "applied_separation",
            "function_name",
            "relation",
            "x"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "constant_division"
          }
        },
        {
          "id": "moved",
          "after": "inequality",
          "template": "moved",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.separated_relation"
            ],
            "relation": "$relation",
            "moved": "$applied_separation.moved_relation",
            "separated": "$applied_separation.separated_relation",
            "function": "$applied_separation.function",
            "parameter_expression": "$applied_separation.parameter_expression",
            "operator": "$applied_separation.operator",
            "x": "$x",
            "function_name": "$function_name"
          },
          "depends_on": [
            "applied_separation",
            "function_name",
            "relation",
            "x"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "move_terms"
          }
        },
        {
          "id": "negative_divided",
          "after": "inequality",
          "template": "negative_divided",
          "bindings": {
            "before": [
              "$relation"
            ],
            "after": [
              "$applied_separation.moved_relation",
              "$applied_separation.separated_relation"
            ],
            "divisor": "$applied_separation.divisor",
            "moved": "$applied_separation.moved_relation",
            "separated": "$applied_separation.separated_relation",
            "function": "$applied_separation.function",
            "parameter_expression": "$applied_separation.parameter_expression",
            "operator": "$applied_separation.operator",
            "x": "$x",
            "domain": "$domain",
            "function_name": "$function_name"
          },
          "depends_on": [
            "applied_separation",
            "domain",
            "function_name",
            "relation",
            "x"
          ],
          "guard": {
            "ref": "applied_separation.transformation",
            "equals": "negative_division"
          }
        }
      ],
      "merges": [
        {
          "id": "separation_result",
          "order": 2,
          "branches": [
            {
              "guard": {
                "ref": "already_separated",
                "equals": true
              },
              "bindings": {
                "parameter_expression": "$separation_candidate.parameter_expression",
                "function": "$separation_candidate.function",
                "operator": "$separation_candidate.operator",
                "separated_relation": "$separation_candidate.separated_relation"
              }
            },
            {
              "guard": {
                "ref": "already_separated",
                "equals": false
              },
              "bindings": {
                "parameter_expression": "$applied_separation.parameter_expression",
                "function": "$applied_separation.function",
                "operator": "$applied_separation.operator",
                "separated_relation": "$applied_separation.separated_relation"
              }
            }
          ]
        }
