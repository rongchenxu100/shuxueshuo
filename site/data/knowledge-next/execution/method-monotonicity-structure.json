{
  "schema_version": "graph-method-execution/v1",
  "method": "method-monotonicity-structure",
  "inputs": {
    "context": {
      "role": "constraint_context"
    }
  },
  "steps": [
    {
      "id": "domain",
      "calls": [
        {
          "id": "prepare",
          "capability": "prepare_monotonicity",
          "public_ref": null,
          "inputs": {
            "context": "$context"
          },
          "outputs": {
            "description": "description",
            "domain_context": "domain_context",
            "needs_domain": "needs_domain",
            "plain_domain": "plain_domain",
            "show_square": "show_square",
            "show_answer": "show_answer",
            "domain": "domain",
            "polynomial": "polynomial",
            "variable": "variable",
            "quadratic": "quadratic"
          },
          "order": 0
        },
        {
          "id": "domain",
          "capability": "submethod",
          "public_ref": "method-domain-intersection",
          "inputs": {
            "context": "$domain_context"
          },
          "outputs": {
            "borrowed_domain": "candidate_set"
          },
          "order": 1,
          "guard": {
            "ref": "needs_domain",
            "equals": true
          }
        }
      ],
      "judgments": [],
      "display_units": [],
      "merges": [
        {
          "id": "select_domain",
          "order": 2,
          "branches": [
            {
              "guard": {
                "ref": "needs_domain",
                "equals": true
              },
              "bindings": {
                "domain": "$borrowed_domain"
              }
            },
            {
              "guard": {
                "ref": "needs_domain",
                "equals": false
              },
              "bindings": {
                "domain": "$domain"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "square",
      "calls": [
        {
          "id": "square",
          "capability": "complete_square",
          "public_ref": "method-complete-square",
          "inputs": {
            "expression": "$polynomial",
            "variable": "$variable"
          },
          "outputs": {
            "square": "square"
          },
          "order": 0,
          "guard": {
            "ref": "quadratic",
            "equals": true
          }
        }
      ],
      "judgments": [],
      "display_units": []
    },
    {
      "id": "analyze",
      "calls": [
        {
          "id": "analyze",
          "capability": "analyze_monotonicity",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "domain": "$domain"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "domain",
          "after": "analyze",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "domain",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ],
          "guard": {
            "ref": "plain_domain",
            "equals": true
          }
        },
        {
          "id": "square",
          "after": "analyze",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "square",
            "before": [],
            "after": [],
            "square": "$square"
          },
          "depends_on": [
            "description",
            "monotonicity_result",
            "square"
          ],
          "guard": {
            "all": [
              {
                "ref": "show_square",
                "equals": true
              },
              {
                "ref": "quadratic",
                "equals": true
              }
            ]
          }
        },
        {
          "id": "inner",
          "after": "analyze",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "inner",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ]
        }
      ]
    },
    {
      "id": "compose",
      "calls": [
        {
          "id": "transfer",
          "capability": "transfer_monotonicity",
          "public_ref": "skill-composite-monotonicity",
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result"
          },
          "outputs": {
            "composed_result": "monotonicity_result"
          },
          "order": 0,
          "guard": {
            "ref": "needs_domain",
            "equals": true
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "composition",
          "after": "transfer",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$composed_result",
            "phase": "composition",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "composed_result"
          ],
          "guard": {
            "ref": "needs_domain",
            "equals": true
          }
        }
      ],
      "merges": [
        {
          "id": "select_result",
          "order": 1,
          "branches": [
            {
              "guard": {
                "ref": "needs_domain",
                "equals": true
              },
              "bindings": {
                "monotonicity_result": "$composed_result"
              }
            },
            {
              "guard": {
                "ref": "needs_domain",
                "equals": false
              },
              "bindings": {
                "monotonicity_result": "$monotonicity_result"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "conclude",
      "calls": [
        {
          "id": "confirm",
          "capability": "confirm_monotonicity",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "answer",
          "after": "confirm",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "answer",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ],
          "guard": {
            "ref": "show_answer",
            "equals": true
          }
        }
      ]
    },
    {
      "id": "verify",
      "calls": [],
      "judgments": [],
      "display_units": []
    }
  ],
  "outputs": {
    "monotonicity_result": "$monotonicity_result"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "admission": {
    "bindings": {
      "context": {
        "resolver": "constraint_context"
      }
    },
    "checks": [
      {
        "function": "function_monotonicity",
        "inputs": {
          "context": "$context",
          "method": "structure"
        }
      }
    ]
  }
}
