{
  "schema_version": "graph-method-execution/v1",
  "method": "method-difference-comparison",
  "inputs": {
    "description": {
      "role": "source_description"
    },
    "monotonicity_result": {
      "role": "strict_order_certificate"
    }
  },
  "steps": [
    {
      "id": "difference",
      "calls": [
        {
          "id": "difference",
          "capability": "prepare_monotonicity_difference",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result"
          },
          "outputs": {
            "difference": "difference",
            "variable": "variable",
            "use_square": "use_square"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        }
      ],
      "judgments": [],
      "display_units": []
    },
    {
      "id": "simplify",
      "calls": [
        {
          "id": "simplify",
          "capability": "simplify_expression",
          "public_ref": "skill-simplify",
          "inputs": {
            "expression": "$difference"
          },
          "outputs": {
            "simplified": "expression"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "factor",
          "capability": "factor_monotonicity_difference",
          "public_ref": "skill-factor",
          "inputs": {
            "expression": "$simplified"
          },
          "outputs": {
            "factored": "expression"
          },
          "order": 1,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "square",
          "capability": "complete_square",
          "public_ref": "method-complete-square",
          "inputs": {
            "expression": "$simplified",
            "variable": "$variable"
          },
          "outputs": {
            "square": "square"
          },
          "order": 2,
          "guard": {
            "all": [
              {
                "ref": "description.family",
                "equals": "polynomial"
              },
              {
                "ref": "use_square",
                "equals": true
              }
            ]
          }
        },
        {
          "id": "choose",
          "capability": "choose_abstract_substitution",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "pair": "$monotonicity_result"
          },
          "outputs": {
            "abstract_proof": "abstract_proof"
          },
          "order": 3,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        },
        {
          "id": "substitute",
          "capability": "instantiate_abstract_relation",
          "public_ref": "skill-universal-substitution",
          "inputs": {
            "description": "$description",
            "abstract_proof": "$abstract_proof"
          },
          "outputs": {
            "abstract_proof": "abstract_proof"
          },
          "order": 4,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        },
        {
          "id": "isolate",
          "capability": "isolate_abstract_difference",
          "public_ref": "skill-equality-transform",
          "inputs": {
            "description": "$description",
            "abstract_proof": "$abstract_proof"
          },
          "outputs": {
            "abstract_proof": "abstract_proof"
          },
          "order": 5,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "construct",
          "after": "isolate",
          "template": "abstract_monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "proof": "$abstract_proof",
            "phase": "construct",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "abstract_proof"
          ],
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ]
    },
    {
      "id": "sign",
      "calls": [
        {
          "id": "sign",
          "capability": "prove_monotonicity_difference",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "difference": "$factored"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "order",
          "capability": "order_abstract_input",
          "public_ref": "skill-inequality-transform",
          "inputs": {
            "description": "$description",
            "abstract_proof": "$abstract_proof"
          },
          "outputs": {
            "abstract_proof": "abstract_proof"
          },
          "order": 1,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        },
        {
          "id": "sign_instance",
          "capability": "instantiate_abstract_sign",
          "public_ref": "skill-universal-substitution",
          "inputs": {
            "description": "$description",
            "abstract_proof": "$abstract_proof"
          },
          "outputs": {
            "abstract_order": "abstract_proof"
          },
          "order": 2,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "difference",
          "after": "sign",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "difference",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ],
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "sign",
          "after": "sign_instance",
          "template": "abstract_monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "proof": "$abstract_order",
            "phase": "sign",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "abstract_order"
          ],
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ]
    },
    {
      "id": "conclude",
      "calls": [],
      "judgments": [],
      "display_units": [],
      "merges": [
        {
          "id": "result",
          "order": 0,
          "branches": [
            {
              "guard": {
                "ref": "description.family",
                "equals": "polynomial"
              },
              "bindings": {
                "monotonicity_result": "$monotonicity_result"
              }
            },
            {
              "guard": {
                "ref": "description.family",
                "equals": "abstract"
              },
              "bindings": {
                "monotonicity_result": "$abstract_order"
              }
            }
          ]
        }
      ]
    }
  ],
  "outputs": {
    "monotonicity_result": "$monotonicity_result"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  }
}
