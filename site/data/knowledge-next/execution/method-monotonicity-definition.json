{
  "schema_version": "graph-method-execution/v1",
  "method": "method-monotonicity-definition",
  "inputs": {
    "context": {
      "role": "constraint_context"
    }
  },
  "steps": [
    {
      "id": "domain",
      "calls": [
        {
          "id": "prepare",
          "capability": "prepare_monotonicity",
          "public_ref": null,
          "inputs": {
            "context": "$context"
          },
          "outputs": {
            "description": "description",
            "domain_context": "domain_context",
            "needs_domain": "needs_domain",
            "plain_domain": "plain_domain",
            "domain": "domain",
            "polynomial": "polynomial",
            "variable": "variable",
            "quadratic": "quadratic"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": []
    },
    {
      "id": "analyze",
      "calls": [
        {
          "id": "analyze",
          "capability": "analyze_monotonicity",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "domain": "$domain",
            "method": "definition"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "domain",
          "after": "analyze",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "domain",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ]
        }
      ]
    },
    {
      "id": "compare",
      "calls": [
        {
          "id": "compare",
          "capability": "submethod",
          "public_ref": "method-difference-comparison",
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "pair",
          "capability": "choose_abstract_pair",
          "public_ref": null,
          "inputs": {
            "description": "$description"
          },
          "outputs": {
            "pair": "pair"
          },
          "order": 1,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        },
        {
          "id": "compare_abstract",
          "capability": "submethod",
          "public_ref": "method-difference-comparison",
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$pair"
          },
          "outputs": {
            "abstract_result": "monotonicity_result"
          },
          "order": 2,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "pair",
          "after": "pair",
          "template": "abstract_monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "proof": "$pair",
            "phase": "pair",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "pair"
          ],
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ]
    },
    {
      "id": "conclude",
      "calls": [
        {
          "id": "confirm",
          "capability": "confirm_monotonicity",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result"
          },
          "outputs": {
            "monotonicity_result": "monotonicity_result"
          },
          "order": 0,
          "guard": {
            "ref": "description.family",
            "equals": "polynomial"
          }
        },
        {
          "id": "confirm_abstract",
          "capability": "confirm_abstract_monotonicity",
          "public_ref": null,
          "inputs": {
            "description": "$description",
            "abstract_result": "$abstract_result"
          },
          "outputs": {
            "abstract_result": "abstract_result"
          },
          "order": 1,
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "answer",
          "after": "confirm",
          "template": "monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "monotonicity_result": "$monotonicity_result",
            "phase": "answer",
            "before": [],
            "after": [],
            "square": null
          },
          "depends_on": [
            "description",
            "monotonicity_result"
          ]
        },
        {
          "id": "conclude",
          "after": "confirm_abstract",
          "template": "abstract_monotonicity_derivation",
          "bindings": {
            "description": "$description",
            "proof": "$abstract_result",
            "phase": "conclude",
            "before": [],
            "after": []
          },
          "depends_on": [
            "description",
            "abstract_result"
          ],
          "guard": {
            "ref": "description.family",
            "equals": "abstract"
          }
        }
      ],
      "merges": [
        {
          "id": "result",
          "order": 2,
          "branches": [
            {
              "guard": {
                "ref": "description.family",
                "equals": "polynomial"
              },
              "bindings": {
                "monotonicity_result": "$monotonicity_result"
              }
            },
            {
              "guard": {
                "ref": "description.family",
                "equals": "abstract"
              },
              "bindings": {
                "monotonicity_result": "$abstract_result"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "verify",
      "calls": [],
      "judgments": [],
      "display_units": []
    }
  ],
  "outputs": {
    "monotonicity_result": "$monotonicity_result"
  },
  "exits": {
    "capability_gap": {
      "status": "capability_gap"
    },
    "math_failed": {
      "status": "math_failed"
    },
    "execution_error": {
      "status": "execution_error"
    }
  },
  "admission": {
    "bindings": {
      "context": {
        "resolver": "constraint_context"
      }
    },
    "checks": [
      {
        "function": "function_monotonicity",
        "inputs": {
          "context": "$context",
          "method": "definition"
        }
      }
    ]
  }
}
