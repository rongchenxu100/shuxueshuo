          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "parity_domain",
          "after": "symmetry",
          "template": "parity_derivation",
          "bindings": {
            "description": "$parity_goal",
            "evidence": "$domain_evidence",
            "phase": "domain",
            "before": [],
            "after": []
          },
