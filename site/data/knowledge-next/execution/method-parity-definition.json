          "inputs": {
            "parity_goal": "$parity_goal",
            "domain_evidence": "$domain_evidence",
            "reflected": "$reflected"
          },
          "outputs": {
            "relations": "relations"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": [
        {
          "id": "parity_compare",
          "after": "compare",
          "template": "parity_derivation",
          "bindings": {
            "description": "$parity_goal",
            "evidence": "$relations",
            "phase": "compare",
            "before": [],
            "after": []
          },
          "depends_on": [
            "parity_goal",
            "relations"
          ],
          "guard": {
            "ref": "symmetric",
            "equals": true
          }
        }
      ]
    },
    {
      "id": "conclude",
      "calls": [
        {
          "id": "conclude",
          "capability": "collect_function_parity",
          "public_ref": null,
          "inputs": {
            "parity_goal": "$parity_goal",
            "domain_evidence": "$domain_evidence",
            "relations": "$relations"
