            "function": "function"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": []
    },
    {
      "id": "domain",
      "calls": [
        {
          "id": "domain",
          "capability": "solve_original_function_domain",
          "public_ref": "method-domain-intersection",
          "inputs": {
            "function": "$function"
          },
          "outputs": {
            "solved": "solved"
          },
          "order": 0
        }
      ],
      "judgments": [],
      "display_units": []
    },
    {
      "id": "symmetry",
      "calls": [
        {
          "id": "symmetry",
          "capability": "check_domain_symmetry",
          "public_ref": "skill-domain-symmetry",
