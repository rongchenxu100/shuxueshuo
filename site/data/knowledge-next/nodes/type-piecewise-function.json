  "examples": [
    {
      "title": "分段解方程并筛选根",
      "prompt": "已知 $f(x)=\\begin{cases}x^2+1,&x>0\\\\-2x+2,&x\\le0\\end{cases}$，若 $f(x)=5$，求 $x$。",
      "solution": [
        "$x>0$ 时，$x^2+1=5\\Rightarrow x=\\pm2$；只保留 $2$。",
        "$x\\le0$ 时，$-2x+2=5\\Rightarrow x=-\\frac32$，符合该段范围。",
        "全部解为 $x=-\\frac32$ 或 $x=2$。"
      ],
      "source": "高中数学一本通·必修一（RJA版）第98页例10变式1"
    },
    {
      "title": "先求比较值，再分段解不等式",
      "prompt": "已知 $f(x)=\\begin{cases}x^2-4x+6,&x\\ge0\\\\x+6,&x<0\\end{cases}$，求 $f(x)>f(1)$ 的解集。",
      "solution": [
        "$f(1)=1^2-4+6=3$。",
        "$x\\ge0$：$(x-1)(x-3)>0$，与 $[0,+\\infty)$ 取交得 $[0,1)\\cup(3,+\\infty)$。",
        "$x<0$：$x+6>3\\Rightarrow x>-3$，与 $(-\\infty,0)$ 取交得 $(-3,0)$。",
        "合并得到 $(-3,1)\\cup(3,+\\infty)$，选择 A。"
      ],
      "source": "高中数学一本通·必修一（RJA版）第98页例10变式2"
    }
