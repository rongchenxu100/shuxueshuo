        "contract": "graph-math-step/v2",
        "display_unit": "function_symmetry_rewrite",
        "explanation": "$$\\begin{gathered}\\because\\ 2024x^{3}+2x^{2}+3x+6=2\\left(x^{2}+3\\right)+\\left(2024 x^{3}+3 x\\right)\\\\\\therefore\\ f(x)=2+\\frac{2024 x^{3}+3 x}{x^{2}+3}\\\\h(-x)=\\frac{2024(-x)^{3}+3(-x)}{(-x)^{2}+3}\\\\h(-x)=\\frac{- 2024 x^{3}- 3 x}{x^{2}+3}=-h(x)\\\\\\therefore\\ h(x)\\text{ 是奇函数}\\\\\\therefore\\ f(x)+f(-x)=\\left(2+h(x)\\right)+\\left(2-h(x)\\right)=4\\end{gathered}$$",
        "highlight": {
          "caption": "求 $f(x)+f(-x)$",
          "connector": "⇒",
          "items": [
            {
              "label": "已知",
              "math": "\\begin{gathered}f(x)=2+h(x)\\\\h(-x)=-h(x)\\end{gathered}"
            },
            {
              "label": "f(x)+f(-x)",
              "math": "f(x)+f(-x)=4"
            }
          ],
          "layout": "derivation"
        },
        "lesson_version": "e1f7a908a126f47084b005bce2d4d4a7e0e3004b68e8d542e7e1b082ea15c14f",
