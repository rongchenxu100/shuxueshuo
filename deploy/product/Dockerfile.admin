FROM postgres:17.10-bookworm@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv nodejs \
    && rm -rf /var/lib/apt/lists/* && python3 -m venv /opt/product
COPY deploy/product/requirements.lock /tmp/requirements.lock
RUN /opt/product/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock
COPY server /app/server
COPY internal/schemas /app/internal/schemas
COPY tools/export-public-knowledge.mjs /app/tools/export-public-knowledge.mjs
COPY tools/lib/public-knowledge-sources.mjs tools/lib/public-knowledge-export.mjs tools/lib/public-knowledge-teaching.mjs tools/lib/graph-walk-practice.mjs /app/tools/lib/
# The exporter derives per-problem versions with the same contract as the browser.
COPY site/assets/learning/practice-compatibility.mjs /app/site/assets/learning/practice-compatibility.mjs
# Import structured originals and the page identities checked by the publisher.
COPY site/data/knowledge-next /app/site/data/knowledge-next
COPY site/data/graph-walk /app/site/data/graph-walk
COPY site/assets/knowledge-next/model.mjs site/assets/knowledge-next/teaching-model.mjs site/assets/knowledge-next/learning-model.mjs /app/site/assets/knowledge-next/
# Diagram modules imported by the content exporter also use the shared learning mode.
COPY site/assets/practice/learning-mode.mjs /app/site/assets/practice/learning-mode.mjs
COPY site/assets/explain /app/site/assets/explain
COPY site/1 /app/site/1
COPY site/2 /app/site/2
COPY site/topics /app/site/topics
WORKDIR /app/server
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Exercise the actual image's Node/Python runtime and fail on missing publication inputs.
RUN node --version && /opt/product/bin/python -c \
    'from shuxueshuo_server.learning.content import load_content; print(load_content()["_meta"])'
ENTRYPOINT ["/opt/product/bin/python", "-m", "shuxueshuo_server.product.admin.cli"]
