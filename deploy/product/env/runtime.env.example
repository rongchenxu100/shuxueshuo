# Example only. The installer generates config/runtime.env outside the repository.
# Real passwords/cookies are generated once and must never be committed here.
BROKER_HOST=127.0.0.1
BROKER_PORT=5672
BROKER_USER=product_local
BROKER_PASSWORD=
BROKER_COOKIE=
BROKER_VHOST=product_local
API_PORT=8000
FRONTEND_PORT=3000
# Builds executed concurrently by one Worker process (1–16). Restart Worker after changing.
WORKER_CONCURRENCY=1
# Local: host rabbitmq sbin. Server: leave empty; broker runs in Compose.
RABBITMQ_BIN=
# Local: host OCR python. Server: OCR runs as compose sidecar (PRODUCT_OCR_URL); this field is unused.
OCR_PYTHON=
