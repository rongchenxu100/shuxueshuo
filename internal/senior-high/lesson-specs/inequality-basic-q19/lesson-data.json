            },
            {
              "label": "替换和与积",
              "expression": "\\(uv=u+v+3\\Rightarrow p=s+3\\)"
            },
            {
              "label": "解出 p",
              "expression": "\\(p=s+3\\)"
            }
          ]
        },
        "reading": "和积换元",
        "route": "应用基本不等式消元"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "对称式可用和与积表示，令 \\(s=u+v，p=uv\\)"
        },
        {
          "kind": "because",
          "text": "缩放变量后的条件为 \\(uv=u+v+3\\)"
        },
        {
          "kind": "therefore",
          "text": "用 \\(s，p\\) 替换和与积，得到 \\(p=s+3\\)"
        }
      ],
      "derive": [
        [
          "换元结果",
          "p=s+3"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "找对称结构",
      "title": "应用基本不等式消元",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "对称结构｜平方型基本不等式",
        "templateLabel": "代入基本不等式",
        "template": "\\(a^2+b^2\\ge2ab\\)",
        "formulaStyle": "square-sum",
        "showPositiveStep": false,
        "mappings": [
          {
            "slot": "a",
            "shape": "square",
            "value": "\\(u\\)",
            "condition": "\\(u>0\\)"
          },
          {
            "slot": "b",
            "shape": "circle",
            "value": "\\(v\\)",
            "condition": "\\(v>0\\)"
          }
        ],
        "stageLabel": "代入 u、v",
        "mapped": "\\(u^2+v^2\\ge2uv\\)",
        "replacementText": "移项配成和平方",
        "replaced": "\\((u+v)^2\\ge4uv\\)",
        "simplifyLabel": "换成 s、p",
        "substituted": "\\(s^2\\ge4p\\)",
        "conclusionLabel": "代入条件消元",
        "conclusion": "\\(s^2\\ge4(s+3)\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "由基本不等式 \\(u^2+v^2\\ge2uv\\)，得 \\((u+v)^2\\ge4uv\\)，即 \\(s^2\\ge4p\\)"
        },
        {
          "kind": "therefore",
          "text": "代入 \\(p=s+3\\)，得 \\(s^2\\ge4(s+3)\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(s^2-4s-12\\ge0\\Rightarrow(s-6)(s+2)\\ge0\\)"
        },
        {
          "kind": "because",
          "text": "\\(u>0，v>0\\)，所以 \\(s=u+v>0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(s\\ge6\\)，所以 \\(a+2b\\) 的下界为 \\(6\\)"
        }
      ],
      "derive": [
        [
          "下界",
          "6"
        ]
      ]
    },
    {
      "id": "s4",
