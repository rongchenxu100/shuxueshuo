  "problem": {
    "source": "培训教材 · 集合的表示",
    "keyPoints": {
      "title": "解题要点",
      "lead": "令 d=2-x，则 d 是 6 的非零整数因数。",
      "items": [
        "列出正、负因数后分别还原 x，避免遗漏。"
      ]
    },
    "lines": [
      {
        "text": "用列举法表示集合 \\(\\{x\\mid \\frac{6}{2-x}\\in\\mathbb Z, x\\in\\mathbb Z\\}\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "描述法",
      "title": "把分式整除转化为因数问题",
      "t": 0,
      "showDiagram": false,
      "reasoning": [
        {
          "kind": "because",
          "text": "令 \\(d=2-x\\)，且 \\(x\\in\\mathbb Z\\)、\\(\\frac{6}{2-x}\\in\\mathbb Z\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(d\\in\\mathbb Z\\)、\\(d\\ne0\\)，且 \\(d\\mid6\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(d\\in\\{-6,-3,-2,-1,1,2,3,6\\}\\)"
        },
        {
          "kind": "because",
          "text": "\\(x=2-d\\)"
        },
        {
          "kind": "therefore",
          "text": "所求集合为 \\(\\{-4,-1,0,1,3,4,5,8\\}\\)"
        }
      ],
      "derive": [
        [
          "\\(d=2-x\\)",
          "\\(d\\in\\{±1,±2,±3,±6\\}\\)"
        ],
        [
          "结论",
          "\\(\\{-4,-1,0,1,3,4,5,8\\}\\)"
        ]
      ]
    }
  ],
