    "keyPoints": {
      "title": "解题要点",
      "lead": "本题使用换元法：把根式整体换成新变量，将原函数转化为熟悉的二次函数；",
      "items": [
        "换元后必须同步写出新变量的取值范围，再在该范围内求二次函数的值域。"
      ]
    },
    "lines": [
      {
        "text": "函数 \\(f(x)=\\sqrt{x-2}-x\\)，\\(x∈(2,6]\\) 的值域为（　）　A. \\((−∞,-\\frac{7}{4}]\\)　B. \\([-4,-\\frac{7}{4}]\\)　C. \\([-4,-2]\\)　D. \\([-4,-2)\\)",
        "answerId": "answerI",
        "answer": "B"
      }
    ]
  },
  "ui": {
    "legend": [],
    "sliderLabel": "参数",
    "paramLabelPrefix": "",
    "goToProblemMode": "smooth",
    "groupTitles": {
      "求解": ""
    }
  },
  "steps": [
    {
      "id": "s1",
      "section": "求解",
      "title": "换元后结合二次函数图像求值域",
      "t": 0,
      "derive": [
        [
          "换元",
          "令 \\(t=\\sqrt{x-2}\\)"
        ],
        [
          "∵ 2<x≤6",
          "\\(0<t≤2\\)，且 \\(x=t^2+2\\)"
        ],
        [
          "转化",
          "\\(f(x)=t-(t^2+2)=-(t-\\frac{1}{2})^2-\\frac{7}{4}\\)"
        ],
        [
          "最大值",
          "当 \\(t=\\frac{1}{2}\\) 时取 \\(-\\frac{7}{4}\\)"
        ],
        [
          "最小值",
          "当 \\(t=2\\) 时取 -4"
        ],
        [
          "∴",
          "值域为 \\([-4,-\\frac{7}{4}]\\)，选 B"
        ]
      ],
      "box": [
        "换元法的关键是同步确定新变量的取值范围。"
      ]
    }
  ],
