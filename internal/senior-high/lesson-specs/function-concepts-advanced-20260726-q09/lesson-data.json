  "steps": [
    {
      "id": "s1",
      "section": "求解",
      "title": "换元并求函数 g(x) 的值域",
      "t": 1.2,
      "derive": [
        [
          "由 f(x)",
          "\\(1≤x≤2\\)"
        ],
        [
          "由 f(x²)",
          "\\(1≤x^2≤2\\)"
        ],
        [
          "∴",
          "\\(1≤x≤\\sqrt{2}\\)"
        ],
        [
          "令",
          "\\(t=\\frac{1}{x}\\)，∴ \\(\\frac{\\sqrt{2}}{2}≤t≤1\\)"
        ],
        [
          "则",
          "\\(g(x)=2t+t^2=(t+1)^2-1\\)"
        ],
        [
          "∵",
          "\\(h(t)=t^2+2t\\) 在 \\([\\frac{\\sqrt{2}}{2},1]\\) 上单调递增"
        ],
        [
          "∴",
          "\\(h(\\frac{\\sqrt{2}}{2})=\\frac{1}{2}+\\sqrt{2}≤g(x)≤h(1)=3\\)"
        ],
        [
          "∴",
          "\\(g(x)\\) 的值域为 \\([\\frac{1}{2}+\\sqrt{2},3]\\)，选 D"
        ]
      ],
      "box": [
        "先定定义域，再换元；换元后必须同步写出新变量的取值范围。"
      ]
    }
  ],
