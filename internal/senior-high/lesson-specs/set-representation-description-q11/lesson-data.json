    "keyPoints": {
      "title": "解题要点",
      "lead": "条件 x-y∈A 等价于 x≥y。",
      "items": [
        "固定 x 时，y 可取 0 到 x，共 x+1 个。"
      ]
    },
    "lines": [
      {
        "text": "若 \\(A=\\{0,1,2,3\\}\\)，\\(B=\\{(x,y)\\mid x\\in A,y\\in A,x-y\\in A\\}\\)，求 B 中元素的个数。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "描述法",
      "title": "逐行列出符合条件的有序数对",
      "t": 0,
      "showDiagram": false,
      "table": {
        "headers": [
          "x",
          "可取的 y",
          "得到的有序数对",
          "个数"
        ],
        "rows": [
          [
            "0",
            "0",
            "(0,0)",
            "1"
          ],
          [
            "1",
            "0,1",
            "(1,0),(1,1)",
            "2"
          ],
          [
            "2",
            "0,1,2",
            "(2,0),(2,1),(2,2)",
            "3"
          ],
          [
            "3",
            "0,1,2,3",
            "(3,0),(3,1),(3,2),(3,3)",
            "4"
          ]
        ]
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(x,y\\in A=\\{0,1,2,3\\}\\)，且 \\(x-y\\in A\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x-y\\ge0\\)，即 \\(x\\ge y\\)"
        },
        {
          "kind": "because",
          "text": "固定 \\(x=0,1,2,3\\) 时，\\(y\\) 分别有 \\(1,2,3,4\\) 种取值"
        },
        {
          "kind": "therefore",
          "text": "\\(|B|=1+2+3+4=10\\)"
        }
      ],
      "derive": [
        [
          "各行个数",
          "\\(1,2,3,4\\)"
        ],
        [
          "结论",
          "\\(|B|=1+2+3+4=10\\)"
        ]
      ]
    }
  ],
