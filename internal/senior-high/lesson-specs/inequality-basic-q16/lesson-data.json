                  },
                  {
                    "value": "\\(1\\)",
                    "role": "keep",
                    "mark": "零次不动"
                  }
                ]
              }
            ],
            "ariaLabel": "在目标整式的两个括号里，分别圈出负一次项一除以 x、一除以 y；零次常数一先不动"
          },
          "localHomogenizationHint": {
            "method": "局部乘入定值",
            "originalLabel": "圈出的负一次项",
            "original": "\\(\\frac{1}{x}\\)",
            "originalDegree": "−1",
            "conditionLabel": "乘入定值",
            "condition": "\\(x+y=1\\)",
            "conditionDegree": "+1",
            "resultDegree": "0",
            "resultLabel": "0 次式",
            "result": "\\(\\frac{x+y}{x}\\)",
            "balance": "\\((-1)+(+1)=0\\)",
            "scopes": [
              {
                "label": "左括号",
                "expression": "\\(\\frac{1}{x}+1\\)"
              },
              {
                "label": "右括号",
                "expression": "\\(\\frac{1}{y}+1\\)"
              }
            ],
            "scopeNote": "各配一次",
            "ariaLabel": "局部乘入定值复用配齐次核心公式：圈出的负一次项乘以一次定值，配成零次式；左右括号各配一次"
          }
        },
        "reading": "局部次数不齐",
        "route": "局部配齐次式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "每个括号都由负一次项与零次常数项组成，括号内部次数不齐"
        },
        {
          "kind": "because",
          "text": "条件 \\(x+y=1\\) 可对负一次项局部乘入，把 \\(\\frac{1}{x}\\) 配成零次式 \\(\\frac{x+y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "不改造整个目标，只在两个括号内配齐被圈出的负一次项"
        }
      ],
      "derive": [
        [
          "路线判断",
          "局部配齐次式"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "配齐次式",
      "title": "局部配齐次式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "用于配齐的条件",
          "expression": "\\(1=x+y\\)",
          "tag": "一次式"
        },
        "target": {
          "label": "原来的两个括号",
          "expression": "\\((\\frac{1}{x}+1)，(\\frac{1}{y}+1)\\)",
          "tag": "次数混合"
        },
        "organization": {
          "label": "局部配齐：只配负一次项，零次不动",
          "steps": [
            "\\(\\frac{1}{x}+1=\\frac{1}{x}\\cdot(x+y)+1=\\frac{2x+y}{x}\\)",
            "\\(\\frac{1}{y}+1=\\frac{1}{y}\\cdot(x+y)+1=\\frac{x+2y}{y}\\)",
            "\\((\\frac{1}{x}+1)(\\frac{1}{y}+1)=5+\\frac{2x}{y}+\\frac{2y}{x}\\)"
          ],
          "note": "只配齐两个括号中的负一次项，不乘入整个目标"
        },
        "pattern": {
          "first": {
            "value": "\\(\\frac{2x}{y}\\)",
            "shape": "square"
          },
          "second": {
            "value": "\\(\\frac{2y}{x}\\)",
            "shape": "circle"
          },
          "condition": {
            "operator": "·",
            "tag": "定积 4"
          },
          "target": {
            "operator": "+",
            "tag": "求最小值"
          },
          "ariaLabel": "局部配齐并展开后，两个比值正项的积固定，求和的最小值"
        },
        "reading": "定积求和",
        "route": "应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "由 \\(x+y=1\\)，可只对负一次项乘入定值：\\(\\frac{1}{x}=\\frac{1}{x}\\cdot(x+y)=\\frac{x+y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{1}{x}+1=\\frac{x+y}{x}+1=\\frac{2x+y}{x}\\)，同理 \\(\\frac{1}{y}+1=\\frac{x+2y}{y}\\)"
        },
        {
          "kind": "therefore",
          "text": "原式 \\(=\\frac{(2x+y)(x+2y)}{xy}=5+\\frac{2x}{y}+\\frac{2y}{x}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{2x}{y}\\cdot\\frac{2y}{x}=4\\)"
        },
        {
          "kind": "therefore",
          "text": "局部配齐后得到「定积求和」结构"
        }
      ],
      "derive": [
        [
          "配齐结果",
          "5＋两个定积正项"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "配齐次式",
      "title": "应用基本不等式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "局部配齐｜定积求和",
        "templateLabel": "代入基本不等式",
        "template": "\\(u+v\\ge2\\sqrt{uv}\\)",
        "formulaStyle": "sum-geometric",
        "showPositiveStep": true,
        "mappings": [
          {
            "slot": "第一个正项",
            "shape": "square",
            "value": "\\(\\frac{2x}{y}\\)",
            "condition": "\\(\\frac{2x}{y}>0\\)"
          },
          {
            "slot": "第二个正项",
            "shape": "circle",
            "value": "\\(\\frac{2y}{x}\\)",
            "condition": "\\(\\frac{2y}{x}>0\\)"
          }
        ],
        "mappedSum": "\\(\\frac{2x}{y}+\\frac{2y}{x}\\)",
        "mappedProduct": "\\(4\\)",
        "mapped": "\\(\\frac{2x}{y}+\\frac{2y}{x}\\ge2\\sqrt4\\)",
        "stageLabel": "代入定积",
        "fixedSourceTarget": "product",
        "fixedSourceLabel": "已知",
        "fixedCondition": "\\(\\frac{2x}{y}\\cdot\\frac{2y}{x}=4\\)",
        "replacementText": "应用基本不等式",
        "replaced": "\\(\\frac{2x}{y}+\\frac{2y}{x}\\ge4\\)",
        "simplifyLabel": "代回配齐式",
        "substituted": "\\((\\frac{1}{x}+1)(\\frac{1}{y}+1)\\ge5+4\\)",
        "conclusionLabel": "得到下界",
        "conclusion": "\\((\\frac{1}{x}+1)(\\frac{1}{y}+1)\\ge9\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{2x}{y}>0，\\frac{2y}{x}>0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{2x}{y}+\\frac{2y}{x}\\ge2\\sqrt{\\frac{2x}{y}\\cdot\\frac{2y}{x}}=4\\)"
        },
        {
          "kind": "because",
          "text": "原式 \\(=5+\\frac{2x}{y}+\\frac{2y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "原式 \\(\\ge9\\)"
        }
      ],
      "derive": [
        [
          "下界",
          "9"
        ]
      ]
    },
    {
      "id": "s4",
      "section": "配齐次式",
      "title": "验证取等",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-equality-check",
        "templateLabel": "基本不等式取等",
        "first": {
          "value": "\\(\\frac{2x}{y}\\)",
          "shape": "square"
        },
        "second": {
          "value": "\\(\\frac{2y}{x}\\)",
          "shape": "circle"
        },
        "conditionLabel": "结合原条件",
        "condition": "\\(x+y=1\\)",
        "solved": "\\(x=y=\\frac{1}{2}\\)",
        "verificationLabel": "代回目标",
        "verification": "\\((\\frac{1}{x}+1)(\\frac{1}{y}+1)=9\\)",
        "conclusion": "原式的最小值为 \\(9\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "基本不等式取等 ⇔ 两个正项相等"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{2x}{y}=\\frac{2y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x=y\\)"
        },
        {
          "kind": "because",
          "text": "\\(x+y=1\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x=y=\\frac{1}{2}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\((\\frac{1}{x}+1)(\\frac{1}{y}+1)=9\\)，最小值为 \\(9\\)"
        }
      ],
      "derive": [
        [
          "最小值",
          "9"
        ],
        [
          "等号条件",
          "x=y=1/2"
        ]
      ]
    }
