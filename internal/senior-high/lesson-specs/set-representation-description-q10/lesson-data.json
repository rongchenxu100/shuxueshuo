    "keyPoints": {
      "title": "解题要点",
      "lead": "把 A、B 中元素的所有搭配代入 2a-b。",
      "items": [
        "结果相同的数在集合中只保留一次。"
      ]
    },
    "lines": [
      {
        "text": "若 \\(A=\\{1,2,3\\},B=\\{3,5\\}\\)，用列举法表示 \\(A*B=\\{2a-b\\mid a\\in A,b\\in B\\}\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "描述法",
      "title": "列出全部运算结果并去重",
      "t": 0,
