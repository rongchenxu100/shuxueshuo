  "steps": [
    {
      "id": "s1",
      "section": "求解",
      "title": "用判别式法求函数值域",
      "showDiagram": false,
      "t": 0,
      "derive": [
        [
          "令",
          "\\(y=\\frac{3x^2+x+3}{x^2+1}\\)"
        ],
        [
          "整理",
          "\\((y-3)x^2-x+y-3=0\\)"
        ],
        [
          "当 y=3",
          "方程化为 \\(-x=0\\)，有实数解 \\(x=0\\)，∴ \\(y=3\\) 可取"
        ],
        [
          "当 y≠3",
          "方程有实数解，∴ \\(Δ=1-4(y-3)^2≥0\\)"
        ],
        [
          "解得",
          "\\(\\frac{5}{2}≤y≤\\frac{7}{2}\\)"
        ],
        [
          "综上",
          "函数值域为 \\([\\frac{5}{2},\\frac{7}{2}]\\)，∴ \\(b=\\frac{5}{2}\\)，\\(a=\\frac{7}{2}\\)，\\(a+b=6\\)，选 B"
        ]
      ],
      "box": [
        "先讨论 \\(y=3\\) 使二次项系数为 0 的退化情形，再对 \\(y≠3\\) 使用判别式。"
      ]
    }
  ],
