        "reading": "待补取等关系数 2",
        "route": "应用基本不等式 2 次"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "目标含两个变量 \\(a，b\\)，题设只给出正性条件 \\(ab>0\\)"
        },
        {
          "kind": "because",
          "text": "正性条件不提供取等关系"
        },
        {
          "kind": "therefore",
          "text": "还需补出两条取等关系，计划应用基本不等式 \\(2\\) 次"
        }
      ],
      "derive": [
        [
          "应用次数",
          "2 次"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "多次应用基本不等式",
      "title": "应用基本不等式消元",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "第 1 次｜合并变量消元",
        "conditionFlowLabel": "判断如何消元",
        "conditionFlow": [
          "目标分别含 \\(a、b\\)",
          "\\(a^4\\cdot4b^4=4(ab)^4\\)",
          "合并变量，消元只剩整体 \\(ab\\)"
        ],
        "templateLabel": "代入基本不等式",
        "template": "\\(u+v\\ge2\\sqrt{uv}\\)",
        "formulaStyle": "sum-geometric",
        "showPositiveStep": false,
        "mappings": [
          {
            "slot": "第一个正项",
            "shape": "square",
            "value": "\\(a^4\\)",
            "condition": "\\(a^4>0\\)"
          },
          {
            "slot": "第二个正项",
            "shape": "circle",
            "value": "\\(4b^4\\)",
            "condition": "\\(4b^4>0\\)"
          }
        ],
        "mappedSum": "\\(a^4+4b^4\\)",
        "mappedProduct": "\\(4(ab)^4\\)",
        "mapped": "\\(a^4+4b^4\\ge2\\sqrt{4(ab)^4}\\)",
        "stageLabel": "代入正项",
        "fixedSourceLabel": "相乘后",
        "fixedSourceTarget": "product",
        "fixedCondition": "\\(a^4\\cdot4b^4=4(ab)^4\\)",
        "replacementText": "化简根式",
        "replaced": "\\(a^4+4b^4\\ge4(ab)^2\\)",
        "simplifyLabel": "除以 ab，加回剩余项",
        "substituted": "\\(\\frac{a^4+4b^4+1}{ab}\\ge4ab+\\frac{1}{ab}\\)",
        "conclusionLabel": "消元结果",
        "conclusion": "原式不小于 \\(4ab+\\frac{1}{ab}\\)，只剩整体 \\(ab\\)",
        "equalityTemplate": "\\(u=v\\)",
        "equalityMapped": "\\(a^4=4b^4\\)",
        "equalityContextLabel": "结合 ab>0",
        "equalityResult": "\\(a^2=2b^2\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "判断如何消元：选择相乘后只含整体 \\(ab\\) 的 \\(a^4\\) 与 \\(4b^4\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(a^4+4b^4\\ge4(ab)^2\\)"
        },
        {
          "kind": "therefore",
          "text": "除以正数 \\(ab\\) 并加回剩余项，原式不小于 \\(4ab+\\frac{1}{ab}\\)，变量 \\(a、b\\) 已合并为整体 \\(ab\\)"
        }
      ],
      "derive": [
        [
          "消元结果",
          "只剩整体 ab"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "多次应用基本不等式",
      "title": "再次应用基本不等式取极值",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "第 2 次｜定积求和",
        "templateLabel": "代入基本不等式",
        "template": "\\(u+v\\ge2\\sqrt{uv}\\)",
        "formulaStyle": "sum-geometric",
        "showPositiveStep": true,
        "mappings": [
          {
            "slot": "第一个正项",
            "shape": "square",
            "value": "\\(4ab\\)",
            "condition": "\\(4ab>0\\)"
          },
          {
            "slot": "第二个正项",
            "shape": "circle",
            "value": "\\(\\frac{1}{ab}\\)",
            "condition": "\\(\\frac{1}{ab}>0\\)"
          }
        ],
        "mappedSum": "\\(4ab+\\frac{1}{ab}\\)",
        "mappedProduct": "\\(4\\)",
        "mapped": "\\(4ab+\\frac{1}{ab}\\ge2\\sqrt4\\)",
        "stageLabel": "代入定积",
        "fixedSourceLabel": "已知",
        "fixedSourceTarget": "product",
        "fixedCondition": "\\(4ab\\cdot\\frac{1}{ab}=4\\)",
        "replacementText": "把乘积换成 4",
        "replaced": "\\(4ab+\\frac{1}{ab}\\ge4\\)",
        "simplifyLabel": "对应原式",
        "substituted": "\\(\\frac{a^4+4b^4+1}{ab}\\ge4\\)",
        "conclusionLabel": "得到下界",
        "conclusion": "原式不小于 \\(4\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(ab>0\\)，所以 \\(4ab>0，\\frac{1}{ab}>0\\)"
        },
        {
          "kind": "because",
          "text": "\\(4ab\\cdot\\frac{1}{ab}=4\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(4ab+\\frac{1}{ab}\\ge4\\)，所以原式不小于 \\(4\\)"
        }
      ],
      "derive": [
        [
          "下界",
          "4"
        ]
      ]
    },
    {
      "id": "s4",
      "section": "多次应用基本不等式",
      "title": "验证取等",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-equality-check",
        "templateLabel": "联立两次取等条件",
        "equalities": [
          {
            "label": "第 1 次取等",
            "first": {
              "value": "\\(a^4\\)",
              "shape": "square"
            },
            "second": {
              "value": "\\(4b^4\\)",
              "shape": "circle"
            },
            "result": "\\(a^2=2b^2\\)"
          },
          {
            "label": "第 2 次取等",
            "first": {
              "value": "\\(4ab\\)",
              "shape": "square"
            },
            "second": {
              "value": "\\(\\frac{1}{ab}\\)",
              "shape": "circle"
            },
            "result": "\\(ab=\\frac{1}{2}\\)"
          }
        ],
        "solved": "\\((a，b)=(2^{-\\frac{1}{4}}，2^{-\\frac{3}{4}})\\) 或 \\((-2^{-\\frac{1}{4}}，-2^{-\\frac{3}{4}})\\)",
        "verificationLabel": "代回原式",
        "verification": "\\(\\frac{a^4+4b^4+1}{ab}=4\\)",
        "conclusion": "原式的最小值为 \\(4\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "第一次取等要求 \\(a^4=4b^4\\)，即 \\(a^2=2b^2\\)"
        },
        {
          "kind": "because",
          "text": "第二次取等要求 \\(4ab=\\frac{1}{ab}\\)，结合 \\(ab>0\\) 得 \\(ab=\\frac{1}{2}\\)"
        },
        {
          "kind": "therefore",
          "text": "联立两次取等条件，可得两组同号解，代回原式均等于 \\(4\\)"
        }
      ],
      "derive": [
        [
          "最小值",
          "4"
        ],
        [
          "等号条件",
          "ab=1/2，a²=2b²"
        ]
      ]
    }
