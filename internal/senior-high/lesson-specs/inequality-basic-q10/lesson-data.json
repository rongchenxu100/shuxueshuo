        },
        {
          "kind": "therefore",
          "text": "\\(2^a+2^{-3b}\\ge2\\sqrt{\\frac{1}{64}}=\\frac{1}{4}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(2^a+\\frac{1}{8^b}\\ge\\frac{1}{4}\\)"
        }
