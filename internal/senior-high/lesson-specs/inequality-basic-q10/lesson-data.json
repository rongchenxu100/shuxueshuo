        },
        "target": {
          "label": "目标整式",
          "expression": "\\(2^a+\\frac{1}{8^b}\\)",
          "tag": "底数不同"
        },
        "organization": {
          "label": "整理目标整式：统一底数显条件",
          "motive": "看底数：\\(8=2^3\\)",
          "baseHint": {
            "kind": "common-base",
            "sourceLabel": "底数不同",
            "source": "\\(A^u+B^v\\)",
            "relationLabel": "寻找共同底数",
            "relations": [
              "\\(A=c^m\\)",
              "\\(B=c^n\\)"
            ],
            "resultLabel": "统一底数",
            "result": "\\(c^{mu}+c^{nv}\\)",
            "productLabel": "乘积指数",
            "productExponent": "\\(mu+nv\\)",
            "targetLabel": "对照条件量",
            "ariaLabel": "统一底数的一般方法：把底数 A 和 B 都表示为共同底数 c 的幂，目标改写为 c 的 mu 次方加 c 的 nv 次方，乘积指数 mu 加 nv 再与条件量对照"
          },
          "steps": [
            {
              "label": "化倒数",
              "expression": "\\(\\frac{1}{8^b}=8^{-b}\\)"
            },
            {
              "label": "统一底数",
              "expression": "\\(8^{-b}=(2^3)^{-b}=2^{-3b}\\)",
              "marks": {
                "bracket": "指数 −3b"
              }
            },
            {
              "label": "重写目标",
              "expression": "\\(2^a+\\frac{1}{8^b}=2^a+2^{-3b}\\)"
            }
          ],
          "note": "两项同底，乘积指数出现条件量 \\(a-3b\\)"
        },
        "pattern": {
          "first": {
            "value": "\\(2^a\\)",
            "shape": "square"
          },
          "second": {
            "value": "\\(2^{-3b}\\)",
            "shape": "circle"
          },
          "condition": {
            "operator": "·",
            "tag": "定积 1/64"
          },
          "target": {
            "operator": "+",
            "tag": "求最小值"
          },
          "ariaLabel": "统一底数后，同一组正项的积固定为六十四分之一，求和的最小值"
        },
        "reading": "定积求和",
        "route": "直接应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(a-3b+6=0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(a-3b=-6\\)"
        },
        {
          "kind": "because",
          "text": "目标中的两个指数式底数分别是 \\(2\\)、\\(8\\)，且 \\(8=2^3\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{1}{8^b}=8^{-b}=(2^3)^{-b}=2^{-3b}\\)"
        },
        {
          "kind": "because",
          "text": "\\(2^a\\cdot2^{-3b}=2^{a-3b}=2^{-6}=\\frac{1}{64}\\)"
        },
        {
          "kind": "therefore",
          "text": "整理后是「定积求和」，直接应用基本不等式"
        }
      ],
      "derive": [
        [
          "结构判断",
          "统一底数显条件｜定积求和"
        ]
      ]
    },
