        "mappedSum": "\\(2^a+2^{-3b}\\)",
        "mappedProduct": "\\(\\frac{1}{64}\\)",
        "mapped": "\\(2^a+2^{-3b}\\ge2\\sqrt{\\frac{1}{64}}\\)",
        "stageLabel": "代入定积",
        "fixedSourceLabel": "已知",
        "fixedSourceTarget": "product",
        "fixedCondition": "\\(2^a\\cdot2^{-3b}=2^{a-3b}=2^{-6}=\\frac{1}{64}\\)",
