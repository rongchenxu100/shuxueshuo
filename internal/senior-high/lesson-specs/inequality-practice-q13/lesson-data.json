    "lines": [
      {
        "text": "13. 解下列不等式："
      },
      {
        "text": "（1）\\(|x+1|+|x-1|\\ge3\\)；"
      },
      {
        "text": "（2）\\(|x-3|-|x+1|<1\\)。"
      }
    ]
  },
