            "interval": "\\(x\\ge1\\)",
            "signs": "\\(x+1>0，x-1\\ge0\\)",
            "rewrite": "\\((x+1)+(x-1)=2x\\)",
            "inequality": "\\(2x\\ge3\\)",
            "result": "\\(x\\ge\\frac{3}{2}\\)"
          }
