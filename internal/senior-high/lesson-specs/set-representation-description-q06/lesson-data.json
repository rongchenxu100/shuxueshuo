    "keyPoints": {
      "title": "解题要点",
      "lead": "代表元素是有序数对 (x,y)，不能只列出 x 或 y。",
      "items": [
        "按 x=1,2,3 依次计算对应的 y。"
      ]
    },
    "lines": [
      {
        "text": "用列举法表示集合 \\(\\{(x,y)\\mid y=2x, x\\in\\mathbb N, 1\\le x<4\\}\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "描述法",
      "title": "逐个生成有序数对",
      "t": 0,
      "showDiagram": false,
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(x\\in\\mathbb N\\)，且 \\(1\\le x<4\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x=1,2,3\\)"
        },
        {
          "kind": "because",
          "text": "\\(y=2x\\)"
        },
        {
          "kind": "therefore",
          "text": "对应的有序数对依次为 \\((1,2),(2,4),(3,6)\\)"
        },
        {
          "kind": "therefore",
          "text": "所求集合为 \\(\\{(1,2),(2,4),(3,6)\\}\\)"
        }
      ],
      "derive": [
        [
          "\\(x=1,2,3\\)",
          "\\(y=2,4,6\\)"
        ],
        [
          "结论",
          "\\(\\{(1,2),(2,4),(3,6)\\}\\)"
        ]
      ]
    }
  ],
