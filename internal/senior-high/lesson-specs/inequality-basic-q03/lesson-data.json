            "slot": "第二个正项",
            "shape": "circle",
            "value": "\\(\\frac{4y}{x}\\)",
            "condition": "\\(\\frac{4y}{x}>0\\)"
          }
        ],
        "stageLabel": "代入定积",
        "mapped": "\\(\\frac{x}{y}+\\frac{4y}{x}\\ge2\\sqrt4\\)",
        "mappedSum": "\\(\\frac{x}{y}+\\frac{4y}{x}\\)",
        "mappedProduct": "\\(4\\)",
        "fixedSourceTarget": "product",
        "fixedSourceLabel": "已知",
        "fixedCondition": "\\(\\frac{x}{y}\\cdot\\frac{4y}{x}=4\\)",
        "replacementText": "应用基本不等式",
        "replaced": "\\(\\frac{x}{y}+\\frac{4y}{x}\\ge4\\)",
        "simplifyLabel": "代回整理式",
        "substituted": "\\(x+4y\\ge5+4\\)",
        "conclusionLabel": "得到下界",
        "conclusion": "\\(x+4y\\ge9\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{x}{y}>0，\\frac{4y}{x}>0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{x}{y}+\\frac{4y}{x}\\ge2\\sqrt{\\frac{x}{y}\\cdot\\frac{4y}{x}}=4\\)"
        },
        {
          "kind": "because",
          "text": "\\(x+4y=5+\\frac{x}{y}+\\frac{4y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x+4y\\ge9\\)"
        }
      ],
      "derive": [
        [
          "下界",
          "x+4y≥9"
        ]
      ]
    },
    {
      "id": "s4",
      "section": "配齐次式",
      "title": "验证取等",
