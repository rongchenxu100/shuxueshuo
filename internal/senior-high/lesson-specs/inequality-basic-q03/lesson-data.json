            {
              "slot": "\\(b\\)",
              "value": "\\(\\frac{4y}{x}\\)"
            }
          ],
          "inequality": "\\(\\frac{x}{y}+\\frac{4y}{x}\\ge2\\sqrt4=4\\)",
          "combine": "\\(x+4y=5+\\frac{x}{y}+\\frac{4y}{x}\\ge9\\)",
          "conclusion": "最小值为 \\(9\\)"
        },
        "equality": {
          "condition": "\\(\\frac{x}{y}=\\frac{4y}{x}\\)",
          "relation": "\\(x=2y\\)",
          "result": "\\(x=3，y=\\frac{3}{2}\\)"
        },
        "caption": "先以“构造定积”为目标寻找倒数，再通过展开后的交叉项发现固定乘积。"
