      "reasoning": [
        {
          "kind": "because",
          "text": "\\((x+4y)(\\frac{1}{x}+\\frac{1}{y})=5+\\frac{x}{y}+\\frac{4y}{x}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{x}{y}>0，\\frac{4y}{x}>0\\)，且两项乘积为 \\(4\\)，所以它们的和不小于 \\(4\\)"
        },
        {
          "kind": "therefore",
          "text": "由 \\(\\frac{1}{x}+\\frac{1}{y}=1\\) 得 \\(x+4y\\ge5+4=9\\)"
        },
        {
          "kind": "therefore",
          "text": "当 \\(\\frac{x}{y}=\\frac{4y}{x}\\)，即 \\(x=2y\\) 时取等号；代入条件得 \\(x=3，y=\\frac{3}{2}\\)"
        }
      ],
