        "clue": {
          "question": "题设中有什么能让变量相消？",
          "condition": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)",
          "observation": "条件含有 \\(x、y\\) 的倒数，并且整体等于 \\(1\\)：乘入它不会改变目标式。"
        },
        "construction": {
          "label": "乘入等于 1 的条件",
          "identity": "\\(x+4y=(x+4y)(\\frac{1}{x}+\\frac{1}{y})\\)",
