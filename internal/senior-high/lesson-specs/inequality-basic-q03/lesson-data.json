        "condition": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)",
        "solved": "\\(x=3，y=\\frac{3}{2}\\)",
        "verificationLabel": "代回目标",
        "verification": "\\(x+4y=9\\)",
        "conclusion": "\\(x+4y\\) 的最小值为 \\(9\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "基本不等式取等 ⇔ 两个正项相等"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{x}{y}=\\frac{4y}{x}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x=2y\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x=3，y=\\frac{3}{2}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(x+4y=9\\)，最小值为 \\(9\\)"
        }
      ],
      "derive": [
