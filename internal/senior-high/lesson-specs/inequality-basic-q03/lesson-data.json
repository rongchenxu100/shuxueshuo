          "tag": "负一次"
        },
        "target": {
          "label": "目标整式",
          "expression": "\\(x+4y\\)",
          "tag": "正一次"
        },
        "organization": {
          "homogenizationHint": {
            "originalLabel": "原有整式",
            "original": "\\(x+4y\\)",
            "originalDegree": "+1",
            "conditionLabel": "乘入定值",
            "condition": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)",
            "conditionDegree": "−1",
            "resultDegree": "0",
            "resultLabel": "0 次式",
            "result": "\\(5+\\frac{x}{y}+\\frac{4y}{x}\\)",
            "balance": "\\((+1)+(-1)=0\\)",
            "ariaLabel": "目标正一次式与条件负一次式相乘配成零次齐次式，展开后只含变量比值"
