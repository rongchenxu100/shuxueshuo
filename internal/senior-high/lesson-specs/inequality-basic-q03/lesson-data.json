      "reasoning": [
        {
          "kind": "because",
          "text": "\\(x>0，4y>0\\)，但 \\(x\\cdot4y=4xy\\) 不是定值"
        },
        {
          "kind": "because",
          "text": "目标 \\(x+4y\\) 是正一次式，条件左边 \\(\\frac{1}{x}+\\frac{1}{y}\\) 是负一次式"
        },
        {
          "kind": "therefore",
          "text": "两者相乘的总次数为 \\(0\\)，可用题设配成零次齐次式"
        }
      ],
      "derive": [
        [
          "路线判断",
          "配齐次式"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "配齐次式",
      "title": "配齐次式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "乘入的定值式",
          "expression": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)",
          "tag": "负一次"
        },
        "target": {
          "label": "原有整式",
          "expression": "\\(x+4y\\)",
          "tag": "正一次"
        },
        "organization": {
          "label": "配齐次式：乘入条件并展开",
          "steps": [
            "\\(x+4y=(x+4y)(\\frac{1}{x}+\\frac{1}{y})\\)",
            "\\(x+4y=5+\\frac{x}{y}+\\frac{4y}{x}\\)"
          ],
          "note": "条件整式等于 1，乘入后目标值不变"
        },
        "pattern": {
          "first": {
            "value": "\\(\\frac{x}{y}\\)",
            "shape": "square"
          },
          "second": {
            "value": "\\(\\frac{4y}{x}\\)",
            "shape": "circle"
          },
          "condition": {
            "operator": "·",
            "tag": "定积 4"
          },
          "target": {
            "operator": "+",
            "tag": "求最小值"
          },
          "ariaLabel": "配齐次后，同一组正项表达式的积固定，求和的最小值"
        },
        "reading": "定积求和",
        "route": "应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{1}{x}+\\frac{1}{y}=1\\)，乘入条件左边不改变目标值"
        },
        {
          "kind": "therefore",
          "text": "\\(x+4y=(x+4y)(\\frac{1}{x}+\\frac{1}{y})=5+\\frac{x}{y}+\\frac{4y}{x}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{x}{y}>0，\\frac{4y}{x}>0\\)，且 \\(\\frac{x}{y}\\cdot\\frac{4y}{x}=4\\)"
        },
        {
          "kind": "therefore",
          "text": "配齐后得到「定积求和」结构"
        }
      ],
      "derive": [
        [
          "配齐结果",
          "5＋两个定积正项"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "配齐次式",
      "title": "应用基本不等式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "配齐次式｜定积求和",
        "templateLabel": "代入基本不等式",
        "template": "\\(u+v\\ge2\\sqrt{uv}\\)",
        "formulaStyle": "sum-geometric",
        "showPositiveStep": true,
        "mappings": [
