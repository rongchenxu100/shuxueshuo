        "substituted": "\\(\\sqrt{xy}\\ge2\\)",
        "conclusionLabel": "正数平方，方向不变",
        "conclusion": "\\(xy\\ge4\\)",
        "equalityTemplate": "两个槽位相等",
        "equalityMapped": "\\(\\frac{1}{x}=\\frac{1}{y}\\iff x=y\\)",
        "equalityContextLabel": "结合原条件",
