    "breadcrumbTitle": "集合的表示 · 把四个实数集合写成区间",
    "breadcrumbLabel": "集合的表示",
    "breadcrumbPath": "site/senior-high/index.html",
    "breadcrumbSearch": "?chapter=sets&section=set-concepts-and-representation&module=set-representation"
  },
  "problem": {
    "source": "培训教材 · 集合的表示",
    "keyPoints": {
      "title": "解题要点",
      "lead": "先把每个集合转化为连续的实数取值范围。",
      "items": [
        "有限端点能取用方括号，不能取用圆括号；无穷端点永远用圆括号。"
      ]
    },
    "lines": [
      {
        "text": "请用区间法表示下列集合："
      },
      {
        "text": "（1）\\(\\{x\\mid |x|\\le1\\}\\)；（2）\\(\\{y\\mid y=\\sqrt{x}+2\\}\\)；（3）\\(\\{y\\mid y=-x^2+2x\\}\\)；（4）\\(\\{y\\mid y=x^2-2x+1,x>0\\}\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "区间表示法",
      "title": "逐项确定端点与开闭",
      "t": 0,
      "showDiagram": false,
      "table": {
        "headers": [
          "原集合",
          "范围依据",
          "区间"
        ],
        "rows": [
          [
            "\\(\\{x\\mid |x|\\le1\\}\\)",
            "\\(-1\\le x\\le1\\)",
            "\\([-1,1]\\)"
          ],
          [
            "\\(\\{y\\mid y=\\sqrt{x}+2\\}\\)",
            "\\(y\\ge2\\)",
            "\\([2,+∞)\\)"
          ],
          [
            "\\(\\{y\\mid y=-x^2+2x\\}\\)",
            "\\(y=-(x-1)^2+1\\le1\\)",
            "\\((-∞,1]\\)"
          ],
          [
            "\\(\\{y\\mid y=x^2-2x+1,x>0\\}\\)",
            "\\(y=(x-1)^2\\ge0\\)，且 0 可取",
            "\\([0,+∞)\\)"
          ]
        ]
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(|x|\\le1\\iff-1\\le x\\le1\\)"
        },
        {
          "kind": "therefore",
          "text": "第（1）问表示为 \\([-1,1]\\)"
        },
        {
          "kind": "because",
          "text": "\\(x\\ge0\\)，所以 \\(\\sqrt{x}\\ge0\\)，且 \\(x=0\\) 时 \\(y=2\\)"
        },
        {
          "kind": "therefore",
          "text": "第（2）问中 \\(y\\ge2\\)，表示为 \\([2,+∞)\\)"
        },
        {
          "kind": "because",
          "text": "\\(y=-x^2+2x=-(x-1)^2+1\\le1\\)，且 \\(x=1\\) 时等号成立"
        },
        {
          "kind": "therefore",
          "text": "第（3）问表示为 \\((-∞,1]\\)"
        },
        {
          "kind": "because",
          "text": "\\(y=x^2-2x+1=(x-1)^2\\ge0\\)，且 \\(x=1>0\\) 时 \\(y=0\\)"
        },
        {
          "kind": "therefore",
          "text": "第（4）问表示为 \\([0,+∞)\\)"
        }
      ],
      "derive": [
        [
          "结论",
          "\\([-1,1];[2,+∞);(-∞,1];[0,+∞)\\)"
        ]
      ]
    }
  ],
