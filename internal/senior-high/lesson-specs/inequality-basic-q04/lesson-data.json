        },
        "reading": "定积求和",
        "route": "应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(a+3b=2\\)，乘入条件左边后得到原目标的 \\(2\\) 倍"
        },
        {
          "kind": "therefore",
          "text": "\\(2(\\frac{3}{a}+\\frac{4}{b})=(\\frac{3}{a}+\\frac{4}{b})(a+3b)=15+\\frac{9b}{a}+\\frac{4a}{b}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{9b}{a}>0，\\frac{4a}{b}>0\\)，且 \\(\\frac{9b}{a}\\cdot\\frac{4a}{b}=36\\)"
        },
        {
          "kind": "therefore",
          "text": "配齐后得到「定积求和」结构"
        }
      ],
      "derive": [
        [
          "配齐结果",
          "2 倍目标＝15＋两个定积正项"
        ]
      ]
