    "keyPoints": {
      "title": "解题要点",
      "lead": "能成为任何集合子集的集合只能是空集。",
      "items": [
        "先把集合条件翻译为方程无实根；",
        "无实根要求判别式严格小于 0。"
      ]
    },
    "lines": [
      {
        "text": "已知 \\(a\\) 是实数，若集合 \\(\\{x\\mid x^2+x+a=0\\}\\) 是任何集合的子集，则 \\(a\\) 的取值范围是______。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "量词与集合",
      "title": "转化为空集条件",
      "t": 0,
      "showDiagram": false,
      "table": {
        "headers": [
          "要求",
          "等价条件"
        ],
        "rows": [
          [
            "是任何集合的子集",
            "该集合为 \\(\\varnothing\\)"
          ],
          [
            "方程无实根",
            "\\(\\Delta=1-4a<0\\)"
          ],
          [
            "解不等式",
            "\\(a>\\frac{1}{4}\\)"
          ]
        ]
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "空集是任何集合的子集；若解集含有元素，就不可能是某个不含该元素的集合的子集"
        },
        {
          "kind": "therefore",
          "text": "\\(a>\\frac{1}{4}\\)"
        }
      ],
      "derive": [
        [
          "答案",
          "\\(a>\\frac{1}{4}\\)"
        ]
      ]
    }
