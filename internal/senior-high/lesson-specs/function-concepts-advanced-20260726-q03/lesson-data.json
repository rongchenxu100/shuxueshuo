  "steps": [
    {
      "id": "s1",
      "section": "求解",
      "title": "第1步：由 f(x+2) 的定义域确定 f(x) 的定义域",
      "showDiagram": false,
      "t": 0,
      "derive": [
        [
          "∵",
          "\\(f(x+2)\\) 的定义域为 \\((-3,4)\\)，即 \\(-3<x<4\\)"
        ],
        [
          "令",
          "\\(u=x+2\\)，则 \\(-1<u<6\\)"
        ],
        [
          "∴",
          "函数 \\(f(x)\\) 的定义域为 \\((-1,6)\\)"
        ]
      ],
      "box": [
        "已知复合函数 \\(f(x+2)\\) 的定义域，先求内层式 \\(x+2\\) 的取值范围。"
      ]
    },
    {
      "id": "s2",
      "section": "求解",
      "title": "第2步：确定 g(x) 的定义域",
      "showDiagram": true,
      "t": 0,
      "derive": [
        [
          "由分子",
          "\\(x+1∈(-1,6)\\)，∴ \\(-2<x<5\\)"
        ],
        [
          "由分母",
          "\\(\\sqrt{3x-1}\\) 有意义且不为 0，∴ \\(3x-1>0\\)，即 \\(x>\\frac{1}{3}\\)"
        ],
        [
          "综上",
          "\\(x∈(-2,5)\\) 且 \\(x∈(\\frac{1}{3},+∞)\\)，∴ \\(x∈(\\frac{1}{3},5)\\)，选 D"
        ]
      ],
      "box": [
        "分子中的复合函数和根式分母必须同时有意义。"
      ]
    }
  ],
