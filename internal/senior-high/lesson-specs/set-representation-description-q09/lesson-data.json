    "lines": [
      {
        "text": "已知 \\(A=\\{1,2,4,5,6\\}\\)，\\(B=\\{(x,y)\\mid x\\in A,y\\in A,xy\\in A\\}\\)，求集合 B 的元素个数。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "描述法",
      "title": "枚举所有符合条件的有序数对",
      "t": 0,
      "showDiagram": false,
      "table": {
        "headers": [
          "x",
          "可取的 y",
          "个数"
        ],
        "rows": [
          [
            "1",
            "1,2,4,5,6",
            "5"
          ],
          [
            "2",
            "1,2",
            "2"
          ],
          [
            "4",
            "1",
            "1"
          ],
          [
            "5",
            "1",
            "1"
          ],
          [
            "6",
            "1",
            "1"
          ]
        ]
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(B\\) 的元素是满足 \\(x,y\\in A\\) 且 \\(xy\\in A\\) 的有序数对"
        },
        {
          "kind": "therefore",
          "text": "固定 \\(x=1,2,4,5,6\\) 时，符合条件的 \\(y\\) 的个数依次为 \\(5,2,1,1,1\\)"
        },
        {
          "kind": "because",
          "text": "不同的 \\(x\\) 或 \\(y\\) 产生不同的有序数对"
        },
        {
          "kind": "therefore",
          "text": "\\(|B|=5+2+1+1+1=10\\)"
        }
      ],
      "derive": [
        [
          "合计",
          "\\(5+2+1+1+1=10\\)"
        ]
      ]
