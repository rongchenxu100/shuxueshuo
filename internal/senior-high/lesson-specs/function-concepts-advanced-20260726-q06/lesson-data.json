    {
      "id": "s1",
      "section": "求解",
      "title": "分别解函数值不等式并取并集",
      "showDiagram": false,
      "t": 0,
      "derive": [
        [
          "当 f(x)>0",
          "\\(\\frac{1}{x-1}>0\\)，解得 \\(x>1\\)"
        ],
        [
          "当 -1<f(x)<0",
          "\\(-1<\\frac{1}{x-1}<0\\)，解得 \\(x<0\\)"
        ],
        [
          "综上",
          "定义域为 \\((-∞,0)∪(1,+∞)\\)"
        ]
      ],
