  "problem": {
    "source": "培训教材 · 集合的表示",
    "keyPoints": {
      "title": "解题要点",
      "lead": "元素 3 可能由集合中的任一含参式产生。",
      "items": [
        "得到候选值后必须利用元素互异性排除使元素重复的情况。"
      ]
    },
    "lines": [
      {
        "text": "设集合 \\(A=\\{2,a+2,2a^2+a\\}\\)，若 \\(3\\in A\\)，求 \\(a\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "列举法",
      "title": "分类产生候选参数",
      "t": 0,
      "showDiagram": false,
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(3\\in A\\)，且集合中已有元素 \\(2\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(a+2=3\\) 或 \\(2a^2+a=3\\)"
        },
        {
          "kind": "therefore",
          "text": "候选值为 \\(a=1\\) 或 \\(a=-\\frac{3}{2}\\)"
        }
      ],
      "derive": [
        [
          "\\(a+2=3\\)",
          "\\(a=1\\)"
        ],
        [
          "\\(2a^2+a=3\\)",
          "\\(a=1\\) 或 \\(a=-\\frac{3}{2}\\)"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "列举法",
      "title": "代回集合检查互异性",
      "t": 1,
      "showDiagram": false,
      "reasoning": [
        {
          "kind": "because",
          "text": "当 \\(a=1\\) 时，\\(A=\\{2,3,3\\}\\)，元素重复"
        },
        {
          "kind": "therefore",
          "text": "舍去 \\(a=1\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(a=-\\frac{3}{2}\\)"
        }
      ],
      "derive": [
        [
          "\\(a=1\\)",
          "\\(A=\\{2,3,3\\}\\)，不满足三个元素互异"
        ],
        [
          "结论",
          "\\(a=-\\frac{3}{2}\\)"
        ]
      ]
    }
  ],
  "policies": {
    "s1": {
