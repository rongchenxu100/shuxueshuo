    "lines": [
      {
        "text": "一元二次不等式 \\(-x^2+2x-3>0\\) 的解集是（　　）"
      },
      {
        "text": "A. \\(\\varnothing\\)　B. \\((-3,1)\\)　C. \\((-1,3)\\)　D. \\((-3,-1)\\)"
      }
    ]
