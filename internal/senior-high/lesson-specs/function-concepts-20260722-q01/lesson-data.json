    ],
    "sliderLabel": "检查输入 x",
    "paramLabelPrefix": "x＝",
    "goToProblemMode": "smooth",
    "groupTitles": { "逐项检查": "按两个必要条件检查四个选项" }
  },
  "steps": [
    {
      "id": "s1",
      "section": "逐项检查",
      "title": "第1步：用唯一对应和值域子集检查选项 A",
      "t": 2,
      "derive": [
        ["条件一", "任取 x∈[0,4]，竖线与 \\(y=\\frac{x}{2}\\) 的图像只有一个交点"],
        ["条件二", "x∈[0,4] 时，实际值域 \\(R_A=[0,2]\\subseteq B\\)"],
        ["∴", "选项 A 可以表示从 A 到 B 的函数"]
      ],
      "box": ["拖动 x：每个输入只得到一个函数值", "实际值域必须是 B 的子集"]
    },
    {
      "id": "s2",
      "section": "逐项检查",
      "title": "第2步：用唯一对应和值域子集检查选项 B",
      "t": 2,
      "derive": [
        ["条件一", "任取 x∈[0,4]，\\(y=\\frac{x}{3}\\) 唯一确定"],
        ["条件二", "实际值域 \\(R_B=[0,\\frac{4}{3}]\\subseteq B=[0,2]\\)"],
        ["∴", "选项 B 符合要求"]
      ],
      "box": ["实际值域不必等于 B，只需包含于 B"]
    },
    {
      "id": "s3",
      "section": "逐项检查",
      "title": "第3步：选项 C 在值域条件上失败",
      "t": 4,
      "derive": [
        ["条件一", "每个 x∈[0,4] 都有唯一的 \\(y=\\frac{2x}{3}\\)"],
        ["但", "实际值域 \\(R_C=[0,\\frac{8}{3}]\\)"],
        ["∵", "\\(\\frac{8}{3}>2\\)，所以 \\(R_C\\nsubseteq B\\)"],
        ["∴", "选项 C 不能表示从 A 到 B 的函数"]
      ],
      "box": ["C 不是违反唯一对应，而是函数值超出了 B"]
    },
    {
      "id": "s4",
      "section": "逐项检查",
      "title": "第4步：检查选项 D 并作出结论",
      "t": 2,
      "derive": [
        ["条件一", "任取 x∈[0,4]，\\(\\sqrt{x}\\) 唯一确定"],
        ["条件二", "实际值域 \\(R_D=[0,2]\\subseteq B\\)"],
        ["∴", "选项 D 符合要求"],
        ["综上", "不能表示从 A 到 B 的函数的是 C"]
      ],
      "box": ["答案：C", "两个条件必须同时满足"]
    }
