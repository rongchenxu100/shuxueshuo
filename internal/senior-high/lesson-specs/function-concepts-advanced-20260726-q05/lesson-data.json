      "section": "求解",
      "title": "结合函数图像逐项判断定义区间",
      "t": 0,
      "derive": [
        [
          "配方",
          "\\(f(x)=(x-1)^2-4\\)"
        ],
        [
          "图像",
          "\\(f(1)=-4\\)，\\(f(-2)=f(4)=5\\)"
        ],
        [
          "A",
          "\\([-2,4]\\) 的值域为 \\([-4,5]\\)"
        ],
        [
          "B",
          "\\([-2,1]\\) 的值域为 \\([-4,5]\\)"
        ],
        [
          "C",
          "\\([1,4]\\) 的值域为 \\([-4,5]\\)"
        ],
        [
          "D",
          "\\([-1,1]\\) 的最大值为 \\(f(-1)=0\\)，不可能得到 5，选 D"
        ]
      ],
