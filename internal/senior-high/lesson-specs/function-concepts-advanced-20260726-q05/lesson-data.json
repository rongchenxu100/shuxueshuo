    "lines": [
      {
        "text": "已知函数 \\(f(x)=x^2-2x-3\\) 的定义域为 \\([a,b]\\)，值域为 \\([-4,5]\\)，则实数对 \\((a,b)\\) 不可能为（　）　A. \\((-2,4)\\)　B. \\((-2,1)\\)　C. \\((1,4)\\)　D. \\((-1,1)\\)",
        "answerId": "answerI",
        "answer": "D"
      }
    ]
