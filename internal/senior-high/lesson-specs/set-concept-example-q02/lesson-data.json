    "keyPoints": {
      "title": "解题要点",
      "lead": "题目明确集合中含有三个元素，因此三个代数式必须两两不相等。",
      "items": [
        "分别写出三组不等关系，不要漏掉任意一对；",
        "把导致元素相等的参数值全部排除。"
      ]
    },
    "lines": [
      {
        "text": "已知集合 \\(A\\) 中含有三个元素：\\(3,2-x,3x+1\\)，求实数 \\(x\\) 应满足的条件。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "互异性",
      "title": "让三个元素两两不相等",
      "t": 0,
      "showDiagram": false,
      "derive": [
        [
          "\\(3\\ne2-x\\)",
          "解得 \\(x\\ne-1\\)"
        ],
        [
          "\\(2-x\\ne3x+1\\)",
          "解得 \\(x\\ne\\frac14\\)"
        ],
        [
          "\\(3\\ne3x+1\\)",
          "解得 \\(x\\ne\\frac23\\)"
        ],
        [
          "结论",
          "\\(x\\in\\mathbb R\\) 且 \\(x\\ne-1,\\frac14,\\frac23\\)"
        ]
      ]
    }
  ],
