  "problem": {
    "source": "高一暑假目标班 · 第4讲",
    "keyPoints": {
      "title": "解题要点",
      "lead": "引用核心知识：每一小题都按“看 a 定开口—看 Δ 定交点—看图像在 x 轴上方还是下方”读出解集。",
      "items": [
        "有两个实根时，图像被两个交点分成内、外两部分；开口方向决定哪部分为正、哪部分为负。",
        "有重根时图像与 x 轴相切，两侧不变号；没有实根时结合开口方向判断恒正或恒负。",
        "不等式含等号时取相应交点；严格不等式不取零点。"
      ]
    },
    "lines": [
      {
        "text": "求下列不等式的解集："
      },
      {
        "text": "（1）\\(x^2-5x+6\\le 0\\)；（2）\\(-2x^2+5x-3\\le0\\)；"
      },
      {
        "text": "（3）\\(x^2-6x+9>0\\)；（4）\\(x^2+x+1>0\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "一元二次不等式",
      "title": "逐图判断开口、交点与正负区域",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "quadratic-function-sign-graphs",
        "ariaLabel": "四个一元二次不等式分别对应两根、两根、重根和无实根四种二次函数图像",
        "title": "四种典型图像一次对照",
        "intro": "黄色线段表示满足不等式的 x；实心端点表示含等号，空心端点表示不取零点。",
        "graphs": [
          {
            "label": "（1）",
            "expression": "\\(y=x^2-5x+6\\)",
            "opening": "up",
            "discriminant": "positive",
            "roots": [
              "2",
              "3"
            ],
            "facts": [
              "\\(a>0\\)，开口向上",
              "两根为 \\(2、3\\)，图像在两根之间不高于 x 轴"
            ],
            "target": "\\(f(x)\\le0\\)",
            "solutionMode": "middle-closed",
            "solution": "\\([2,3]\\)"
          },
          {
            "label": "（2）",
            "expression": "\\(y=-2x^2+5x-3\\)",
            "opening": "down",
            "discriminant": "positive",
            "roots": [
              "1",
              "3/2"
            ],
            "facts": [
              "\\(a<0\\)，开口向下",
              "图像在两根外侧不高于 x 轴"
            ],
            "target": "\\(f(x)\\le0\\)",
            "solutionMode": "outside-closed",
            "solution": "\\((-\\infty,1]\\cup[\\frac32,+\\infty)\\)"
          },
          {
            "label": "（3）",
            "expression": "\\(y=(x-3)^2\\)",
            "opening": "up",
            "discriminant": "zero",
            "roots": [
              "3"
            ],
            "facts": [
              "\\(\\Delta=0\\)，图像在 \\(x=3\\) 处与 x 轴相切",
              "除切点外，图像都在 x 轴上方"
            ],
            "target": "\\(f(x)>0\\)",
            "solutionMode": "except-root",
            "solution": "\\(\\mathbb R\\setminus\\{3\\}\\)"
          },
          {
            "label": "（4）",
            "expression": "\\(y=x^2+x+1\\)",
            "opening": "up",
            "discriminant": "negative",
            "roots": [],
            "facts": [
              "\\(a>0\\) 且 \\(\\Delta=-3<0\\)",
              "图像与 x 轴无交点并且恒在 x 轴上方"
            ],
            "target": "\\(f(x)>0\\)",
            "solutionMode": "all",
            "solution": "\\(\\mathbb R\\)"
          }
        ],
        "caption": "这四幅图依次覆盖两个实根、两个实根且开口向下、重根、无实根四种典型情况。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "（1）\\(a>0\\)，图像开口向上并与 x 轴交于 2、3；读取图像不高于 x 轴的部分，得 \\([2,3]\\)"
        },
        {
          "kind": "because",
          "text": "（2）\\(a<0\\)，图像开口向下并与 x 轴交于 1、\\(\\frac32\\)；不高于 x 轴的部分在两根外侧，得 \\((-\\infty,1]\\cup[\\frac32,+\\infty)\\)"
        },
        {
          "kind": "because",
          "text": "（3）\\((x-3)^2\\) 的图像在 \\(x=3\\) 处与 x 轴相切；严格大于 0 不取切点，得 \\(\\mathbb R\\setminus\\{3\\}\\)"
        },
        {
          "kind": "therefore",
          "text": "（4）\\(a>0\\) 且 \\(\\Delta=-3<0\\)，图像恒在 x 轴上方，所以解集为 \\(\\mathbb R\\)"
        }
      ],
      "derive": [
        [
          "（1）",
          "[2,3]"
        ],
        [
          "（2）",
          "(−∞,1]∪[3/2,+∞)"
        ],
        [
          "（3）",
          "ℝ∖{3}"
        ],
        [
          "（4）",
          "ℝ"
        ]
      ]
    }
  ],
