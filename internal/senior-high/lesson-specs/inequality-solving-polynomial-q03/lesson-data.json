  "problem": {
    "source": "高一暑假目标班 · 第4讲",
    "keyPoints": {
      "title": "解题要点",
      "lead": "引用高次不等式知识点，因式分解后把根的重数直接标在穿针图上。",
      "items": [
        "因式分解为 \\((x+1)(x-3)(x-2)^2\\)。",
        "最高次项系数为正，从最右侧的“+”开始穿。",
        "x=−1、3 是一次根，要穿过并变号；x=2 是二次根，只接触数轴后返回。",
        "目标是小于 0，读取两段负号阴影；严格不等式仍要排除偶次根 2。"
      ]
    },
    "lines": [
      {
        "text": "不等式 \\((x^2-2x-3)(x^2-4x+4)<0\\) 的解集是（　　）"
      },
      {
        "text": "A. \\(x<-1\\) 或 \\(x>3\\)　B. \\(-1<x<3\\)　C. \\(x<-3\\) 或 \\(x>1\\)　D. \\(-1<x<2\\) 或 \\(2<x<3\\)"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "高次不等式",
      "title": "偶次根处不变号",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "polynomial-threading-graph",
        "ariaLabel": "曲线在根负 1 和 3 处穿过数轴，在二重根 2 处接触后返回，阴影位于负 1 到 2 和 2 到 3",
        "title": "二重根处回弹：符号不变但根仍要排除",
        "intro": "平方因式产生偶数重根；图上用虚线外环标记“偶不穿”。",
        "standardized": "\\((x+1)(x-2)^2(x-3)<0\\)",
        "roots": [
          { "label": "−1", "multiplicity": 1 },
          { "label": "2", "multiplicity": 2 },
          { "label": "3", "multiplicity": 1 }
        ],
        "signs": ["+", "-", "-", "+"],
        "selectSign": "-",
        "inclusive": false,
        "target": "取负号区间",
        "solution": "\\((-1,2)\\cup(2,3)\\)",
        "facts": [
          "经过一次根 3 时从正变负；到二次根 2 时接触数轴后返回，左右仍为负。",
          "经过一次根 −1 时再由负变正；因为是不含等号的小于 0，三个根均不取。"
        ],
        "caption": "两段阴影符号相同，但被不能取的二重根 2 分成两个开区间。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\((x^2-2x-3)(x^2-4x+4)=(x+1)(x-3)(x-2)^2\\)，根依次为 −1、2、3，重数为 1、2、1"
        },
        {
          "kind": "because",
          "text": "引用穿针引线法：从最右侧正号开始，在 3、−1 两个奇数重根处穿过，在偶数重根 2 处接触后返回，所以 2 两侧均为负"
        },
        {
          "kind": "therefore",
          "text": "取负号阴影并排除所有根，解集为 \\((-1,2)\\cup(2,3)\\)，选择 D"
        }
      ],
      "derive": [
        [
          "答案",
          "D"
        ]
      ]
    }
  ],
