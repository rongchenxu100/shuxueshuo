          "tag": "正一次"
        },
        "target": {
          "label": "目标整式",
          "expression": "\\(\\frac{a+2b}{ab}\\)",
          "tag": "负一次"
        },
        "organization": {
          "homogenizationHint": {
            "originalLabel": "原有整式",
            "original": "\\(\\frac{a+2b}{ab}\\)",
            "originalDegree": "−1",
            "conditionLabel": "乘入定值",
            "condition": "\\(a+b=1\\)",
            "conditionDegree": "+1",
            "resultDegree": "0",
            "resultLabel": "0 次式",
            "result": "\\(3+\\frac{a}{b}+\\frac{2b}{a}\\)",
            "balance": "\\((-1)+(+1)=0\\)",
            "ariaLabel": "目标负一次式与条件正一次式相乘配成零次齐次式，展开后只含常数与变量比值"
          }
        },
        "reading": "次数配成 0",
        "route": "配齐次式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{a+2b}{ab}=\\frac{1}{b}+\\frac{2}{a}\\)，但两项乘积 \\(\\frac{2}{ab}\\) 不是定值"
        },
        {
          "kind": "because",
          "text": "目标 \\(\\frac{a+2b}{ab}\\) 是负一次式，条件左边 \\(a+b\\) 是正一次式"
        },
        {
          "kind": "therefore",
          "text": "两者相乘的总次数为 \\(0\\)，可用题设配成零次齐次式"
        }
      ],
      "derive": [
        [
          "路线判断",
          "配齐次式"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "配齐次式",
      "title": "配齐次式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "乘入的定值式",
          "expression": "\\(a+b=1\\)",
          "tag": "正一次"
        },
        "target": {
          "label": "原有整式",
          "expression": "\\(\\frac{a+2b}{ab}\\)",
          "tag": "负一次"
        },
        "organization": {
          "label": "配齐次式：乘入条件并展开",
          "steps": [
            "\\(\\frac{a+2b}{ab}=\\frac{a+2b}{ab}(a+b)\\)",
            "\\(\\frac{a+2b}{ab}=3+\\frac{a}{b}+\\frac{2b}{a}\\)"
          ],
          "note": "条件整式等于 1，乘入后目标值不变"
        },
        "pattern": {
          "first": {
            "value": "\\(\\frac{a}{b}\\)",
            "shape": "square"
          },
          "second": {
            "value": "\\(\\frac{2b}{a}\\)",
