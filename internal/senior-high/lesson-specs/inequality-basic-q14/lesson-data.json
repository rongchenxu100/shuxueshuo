        "mappedProduct": "\\(2\\)",
        "fixedSourceTarget": "product",
        "fixedSourceLabel": "已知",
        "fixedCondition": "\\(\\frac{a}{b}\\cdot\\frac{2b}{a}=2\\)",
        "replacementText": "应用基本不等式",
        "replaced": "\\(\\frac{a}{b}+\\frac{2b}{a}\\ge2\\sqrt2\\)",
        "simplifyLabel": "代回整理式",
        "substituted": "\\(\\frac{a+2b}{ab}\\ge3+2\\sqrt2\\)",
        "conclusionLabel": "得到下界",
        "conclusion": "\\(\\frac{a+2b}{ab}\\ge3+2\\sqrt2\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{a}{b}>0，\\frac{2b}{a}>0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{a}{b}+\\frac{2b}{a}\\ge2\\sqrt{\\frac{a}{b}\\cdot\\frac{2b}{a}}=2\\sqrt2\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{a+2b}{ab}=3+\\frac{a}{b}+\\frac{2b}{a}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{a+2b}{ab}\\ge3+2\\sqrt2\\)"
