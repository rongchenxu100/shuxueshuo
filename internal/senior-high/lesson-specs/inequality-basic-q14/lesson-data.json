            "tag": "定积 2"
          },
          "target": {
            "operator": "+",
            "tag": "求最小值"
          },
          "ariaLabel": "配齐次后，同一组正项表达式的积固定为二，求和的最小值"
        },
        "reading": "定积求和",
        "route": "应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(a+b=1\\)，乘入条件左边不改变目标值"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{a+2b}{ab}=\\frac{a+2b}{ab}(a+b)=3+\\frac{a}{b}+\\frac{2b}{a}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{a}{b}>0，\\frac{2b}{a}>0\\)，且 \\(\\frac{a}{b}\\cdot\\frac{2b}{a}=2\\)"
        },
        {
          "kind": "therefore",
          "text": "配齐后得到「定积求和」结构"
        }
      ],
      "derive": [
        [
          "配齐结果",
          "3＋两个定积正项"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "配齐次式",
      "title": "应用基本不等式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "配齐次式｜定积求和",
