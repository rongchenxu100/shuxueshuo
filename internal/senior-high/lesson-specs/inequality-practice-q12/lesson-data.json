  "problem": {
    "source": "高一暑假目标班 · 第4讲",
    "keyPoints": {
      "title": "解题要点",
      "lead": "先认出单个绝对值与正常数的比较，再直接套用对应规则。",
      "items": [
        "大于取两边：|u|≥a⇔u≤−a 或 u≥a。",
        "小于取中间：|u|≤a⇔−a≤u≤a；双边限制分别求解后取交集。"
      ]
    },
    "lines": [
      {
        "text": "12. 解下列不等式："
      },
      {
        "text": "（1）\\(|5x-2|\\ge8\\)；"
      },
      {
        "text": "（2）\\(2\\le|x-2|\\le4\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "绝对值不等式",
      "title": "（1）直接套用“大于取两边”",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "absolute-direct-rule-map",
        "mode": "single",
        "method": "直接法",
        "title": "认准结构，大于取两边",
        "intro": "把题目中的绝对值内部整体放进公式槽位，不需要先改写成距离。",
        "original": "\\(|5x-2|\\ge8\\)",
        "rules": [
          {
            "index": "01",
            "name": "大于取两边",
            "template": "\\(|u|\\ge a\\iff u\\le-a\\text{ 或 }u\\ge a\\)",
            "mappings": [
              "\\(u←5x-2\\)",
              "\\(a←8\\)"
            ],
            "substituted": "\\(5x-2\\le-8\\text{ 或 }5x-2\\ge8\\)",
            "solved": "\\(x\\le-\\frac{6}{5}\\text{ 或 }x\\ge2\\)",
            "solution": "\\(( -\\infty,-\\frac{6}{5}]\\cup[2,+\\infty)\\)"
          }
        ],
        "caption": "公式中的 u 是一个整体；先对号入座，再分别解两边的一元一次不等式。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "令 u=5x−2，a=8，由 |u|≥a⇔u≤−a 或 u≥a"
        },
        {
          "kind": "because",
          "text": "代入得 5x−2≤−8 或 5x−2≥8"
        },
        {
          "kind": "therefore",
          "text": "解得 x≤−6/5 或 x≥2"
        }
      ],
      "derive": [
        [
          "（1）",
          "(-∞,-6/5]∪[2,+∞)"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "绝对值不等式",
      "title": "（2）分别直接求解，再取交集",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "absolute-direct-rule-map",
        "mode": "intersection",
        "method": "直接法",
        "title": "双边限制：拆成两条，再取交集",
        "intro": "一个 x 要同时满足左右两侧限制，所以先把连写不等式拆成“且”。",
        "original": "\\(2\\le|x-2|\\le4\\)",
        "rules": [
          {
            "index": "01",
            "name": "大于取两边",
            "template": "\\(|u|\\ge a\\iff u\\le-a\\text{ 或 }u\\ge a\\)",
            "mappings": [
              "\\(u←x-2\\)",
              "\\(a←2\\)"
            ],
            "substituted": "\\(x-2\\le-2\\text{ 或 }x-2\\ge2\\)",
            "solved": "\\(x\\le0\\text{ 或 }x\\ge4\\)",
            "solution": "\\(( -\\infty,0]\\cup[4,+\\infty)\\)"
          },
          {
            "index": "02",
            "name": "小于取中间",
            "template": "\\(|u|\\le a\\iff-a\\le u\\le a\\)",
            "mappings": [
              "\\(u←x-2\\)",
              "\\(a←4\\)"
            ],
            "substituted": "\\(-4\\le x-2\\le4\\)",
            "solved": "\\(-2\\le x\\le6\\)",
            "solution": "\\([-2,6]\\)"
          }
        ],
        "intersection": {
          "label": "同时成立＝取交集",
          "expression": "\\((( -\\infty,0]\\cup[4,+\\infty))\\cap[-2,6]\\)",
          "result": "\\([-2,0]\\cup[4,6]\\)"
        },
        "caption": "双边绝对值不等式的关键不是分类讨论，而是把两条直接法结果取交集。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "2≤|x−2|≤4 等价于 |x−2|≥2 且 |x−2|≤4"
        },
        {
          "kind": "because",
          "text": "大于取两边得 x≤0 或 x≥4；小于取中间得 −2≤x≤6"
        },
        {
          "kind": "therefore",
          "text": "两个解集取交集，得到 [-2,0]∪[4,6]"
        }
      ],
      "derive": [
        [
          "（2）",
          "[-2,0]∪[4,6]"
        ]
      ]
    }
  ],
