    "lines": [
      { "text": "已知二次函数 \\(f(x)\\) 满足 \\(f(0)=0\\)，\\(f(x+1)-f(x)=2x-3\\)。" },
      { "text": "（1）求二次函数 \\(f(x)\\) 的解析式；" },
      { "text": "（2）求不等式 \\(f(x)≥18-x\\) 的解集。", "answerId": "answerI", "answer": "（1）\\(f(x)=x^2-4x\\)；（2）\\((−∞,-3]∪[6,+∞)\\)" }
    ]
  },
  "ui": { "legend": [], "sliderLabel": "参数", "paramLabelPrefix": "", "goToProblemMode": "smooth", "groupTitles": { "（1）": "确定解析式", "（2）": "解不等式" } },
  "steps": [
    {
      "id": "s1",
      "section": "（1）",
      "title": "比较差分式的系数",
      "t": 0,
      "showDiagram": false,
      "derive": [["设", "\\(f(x)=ax^2+bx+c\\)（\\(a≠0\\)）"], ["作差", "\\(f(x+1)-f(x)=2ax+a+b\\)"], ["比较系数", "\\(2a=2\\)，\\(a+b=-3\\)，所以 \\(a=1,b=-4\\)"], ["初值", "\\(f(0)=c=0\\)"], ["∴", "\\(f(x)=x^2-4x\\)"]],
      "box": ["二次函数的一阶差分是一次式，可直接比较系数"]
    },
