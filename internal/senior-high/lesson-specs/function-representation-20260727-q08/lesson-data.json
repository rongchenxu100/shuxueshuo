      "derive": [["代入解析式", "\\(x^2-4x≥18-x\\)"], ["整理", "\\(x^2-3x-18≥0\\)"], ["因式分解", "\\((x+3)(x-6)≥0\\)"], ["∴", "解集为 \\((−∞,-3]∪[6,+∞)\\)"]],
      "box": ["开口向上的二次式在两个零点外侧非负"]
    }
