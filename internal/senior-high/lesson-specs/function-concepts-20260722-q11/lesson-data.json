  "steps": [
    { "id": "s1", "section": "求值域", "title": "第1步：分离常数，找出反比例结构", "t": 1.25, "showDiagram": false, "derive": [["∵", "\\(x-1=(x+1)-2\\)"], ["∴", "\\(f(x)=\\frac{x-1}{x+1}=\\frac{(x+1)-2}{x+1}=1-\\frac{2}{x+1}\\)"]], "box": ["先把分式改写成“常数 + 反比例式”"] },
    { "id": "s2", "section": "求值域", "title": "第2步：确定分母 x+1 的取值范围", "t": 1.25, "showDiagram": false, "derive": [["∵", "\\(\\frac{1}{2}≤x≤2\\)"], ["∴", "\\(\\frac{3}{2}≤x+1≤3\\)"]], "box": ["区间整体加 1，两个端点都能取到"] },
    { "id": "s3", "section": "求值域", "title": "第3步：确定 \\(-\\frac{2}{x+1}\\) 的取值范围", "t": 1.25, "showDiagram": false, "derive": [["取倒数", "\\(\\frac{1}{3}≤\\frac{1}{x+1}≤\\frac{2}{3}\\)"], ["乘以 -2", "\\(-\\frac{4}{3}≤-\\frac{2}{x+1}≤-\\frac{2}{3}\\)"]], "box": ["取倒数会交换端点；乘负数要改变不等号方向"] },
    { "id": "s4", "section": "求值域", "title": "第4步：加上常数，确定函数值域", "t": 1.25, "derive": [["两边加 1", "\\(-\\frac{1}{3}≤1-\\frac{2}{x+1}≤\\frac{1}{3}\\)"], ["即", "\\(-\\frac{1}{3}≤f(x)≤\\frac{1}{3}\\)"], ["∴", "函数的值域为 \\([-\\frac{1}{3},\\frac{1}{3}]\\)"]], "box": ["两个端点都能取到，使用闭区间"] }
  ],
