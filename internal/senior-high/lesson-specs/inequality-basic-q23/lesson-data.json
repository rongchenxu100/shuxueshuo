  "problem": {
    "source": "",
    "keyPoints": {
      "title": "解题要点",
      "lead": "",
      "items": [
        "观察原式结构：识别目标中的两个完整分母 \\(x+1\\)、\\(2y+1\\)，并把条件整理为它们的带权定和",
        "整体换元：令 \\(u=x+1>0，v=2y+1>0\\)，同步改写逆关系、条件与目标",
        "观察换元后的结构：目标为负一次式，条件左边为正一次式，相乘可配成 0 次齐次式",
        "配齐次式：乘入带权定和并展开，得到 \\(7(\\frac{1}{u}+\\frac{1}{v})=3+\\frac{2u}{v}+\\frac{v}{u}\\)",
        "应用基本不等式：\\(\\frac{2u}{v}+\\frac{v}{u}\\ge2\\sqrt2\\)，所以目标不小于 \\(\\frac{3+2\\sqrt2}{7}\\)",
        "验证取等并还原：\\(v=\\sqrt2u\\)，再结合 \\(2u+v=7\\) 还原 \\(x，y\\)"
      ]
    },
    "lines": [
      {
        "text": "已知 \\(x，y\\in\\mathbb R，x+y=2\\)，且 \\(x>-1，y>-\\frac{1}{2}\\)，求 \\(\\frac{1}{x+1}+\\frac{1}{2y+1}\\) 的最小值。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "换元法",
      "title": "观察原式结构",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "condition": {
          "label": "条件整式",
          "expression": "\\(x+y=2，x>-1，y>-\\frac{1}{2}\\)",
          "tag": "可整理成带权定和"
        },
        "target": {
          "label": "目标整式",
          "expression": "\\(\\frac{1}{x+1}+\\frac{1}{2y+1}\\)",
          "tag": "两个完整分母"
        },
        "organization": {
          "substitutionHint": {
            "mappings": [
              {
                "numerator": "1",
                "denominator": "\\(x+1\\)",
                "variable": "\\(u\\)",
                "assignment": "\\(x+1>0\\)"
              },
              {
                "numerator": "1",
                "denominator": "\\(2y+1\\)",
                "variable": "\\(v\\)",
                "assignment": "\\(2y+1>0\\)"
              }
            ],
            "ariaLabel": "识别目标中的两个完整分母 x 加 1 与 2y 加 1，分别令 u 与 v 整体换元"
          }
        },
        "reading": "完整分母",
        "route": "整体换元"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "由 \\(x>-1，y>-\\frac{1}{2}\\)，得 \\(x+1>0，2y+1>0\\)"
        },
        {
          "kind": "because",
          "text": "目标的两个分母分别是完整整式 \\(x+1\\)、\\(2y+1\\)"
        },
        {
          "kind": "therefore",
          "text": "把条件整理为 \\(2(x+1)+(2y+1)=7\\)，可对两个完整分母分别整体换元"
        }
      ],
      "derive": [
        [
          "路线判断",
          "完整分母整体换元"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "换元法",
      "title": "整体换元",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "原条件",
          "expression": "\\(x+y=2\\)"
        },
        "target": {
          "label": "原目标",
          "expression": "\\(\\frac{1}{x+1}+\\frac{1}{2y+1}\\)"
        },
        "organization": {
          "label": "整体换元：定义域、条件与目标同步改写",
          "steps": [
            {
              "label": "定义",
              "expression": "\\(u=x+1>0，v=2y+1>0\\)"
            },
            {
              "label": "逆关系",
              "expression": "\\(x=u-1，y=\\frac{v-1}{2}\\)"
            },
            {
              "label": "改写条件",
              "expression": "\\(2u+v=7\\)"
            },
            {
              "label": "改写目标",
              "expression": "\\(\\frac{1}{u}+\\frac{1}{v}\\)"
            }
          ]
        },
        "reading": "完成换元",
        "route": "重新观察结构"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "令 \\(u=x+1>0，v=2y+1>0\\)，则 \\(x=u-1，y=\\frac{v-1}{2}\\)"
        },
        {
          "kind": "therefore",
          "text": "条件 \\(x+y=2\\) 改写为 \\(2u+v=7\\)"
        },
        {
          "kind": "therefore",
          "text": "目标同步改写为 \\(\\frac{1}{u}+\\frac{1}{v}\\)"
        }
      ],
      "derive": [
        [
          "换元结果",
          "2u+v=7｜目标为 1/u+1/v"
        ]
      ]
    },
    {
      "id": "s3",
      "section": "换元法",
      "title": "观察换元后的结构",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "condition": {
          "label": "条件整式",
          "expression": "\\(2u+v=7\\)",
          "tag": "正一次"
        },
        "target": {
          "label": "目标整式",
          "expression": "\\(\\frac{1}{u}+\\frac{1}{v}\\)",
          "tag": "负一次"
        },
        "organization": {
          "homogenizationHint": {
            "originalLabel": "原有整式",
            "original": "\\(\\frac{1}{u}+\\frac{1}{v}\\)",
            "originalDegree": "−1",
            "conditionLabel": "乘入定值",
            "condition": "\\(2u+v=7\\)",
            "conditionDegree": "+1",
            "resultDegree": "0",
            "resultLabel": "0 次式",
            "result": "\\(3+\\frac{2u}{v}+\\frac{v}{u}\\)",
            "balance": "\\((-1)+(+1)=0\\)",
            "ariaLabel": "换元后的负一次目标与正一次带权定和相乘，配成零次齐次式"
          }
        },
        "reading": "次数配成 0",
        "route": "配齐次式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{1}{u}>0，\\frac{1}{v}>0\\)，但两项乘积 \\(\\frac{1}{uv}\\) 不是定值"
        },
        {
          "kind": "because",
          "text": "换元后的目标是负一次式，条件左边 \\(2u+v\\) 是正一次式"
        },
        {
          "kind": "therefore",
          "text": "两者相乘的总次数为 \\(0\\)，可用新条件配成零次齐次式"
        }
      ],
      "derive": [
        [
          "路线判断",
          "配齐次式"
        ]
      ]
    },
    {
      "id": "s4",
      "section": "换元法",
      "title": "配齐次式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "乘入的定值式",
          "expression": "\\(2u+v=7\\)",
          "tag": "正一次"
        },
        "target": {
          "label": "原有整式",
          "expression": "\\(\\frac{1}{u}+\\frac{1}{v}\\)",
          "tag": "负一次"
        },
        "organization": {
          "label": "配齐次式：乘入条件并展开",
          "steps": [
            "\\(7(\\frac{1}{u}+\\frac{1}{v})=(2u+v)(\\frac{1}{u}+\\frac{1}{v})\\)",
            "\\(7(\\frac{1}{u}+\\frac{1}{v})=3+\\frac{2u}{v}+\\frac{v}{u}\\)"
          ],
          "note": "条件整式等于 7，展开式是原目标的 7 倍"
        },
        "pattern": {
          "first": {
            "value": "\\(\\frac{2u}{v}\\)",
            "shape": "square"
          },
          "second": {
            "value": "\\(\\frac{v}{u}\\)",
            "shape": "circle"
          },
          "condition": {
            "operator": "·",
            "tag": "定积 2"
          },
          "target": {
            "operator": "+",
            "tag": "求最小值"
          },
          "ariaLabel": "配齐次后，正项 2u 比 v 与 v 比 u 的积固定为 2，求和的最小值"
        },
        "reading": "定积求和",
        "route": "应用基本不等式"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(2u+v=7\\)，乘入条件左边后得到原目标的 \\(7\\) 倍"
        },
        {
          "kind": "therefore",
          "text": "\\(7(\\frac{1}{u}+\\frac{1}{v})=(2u+v)(\\frac{1}{u}+\\frac{1}{v})=3+\\frac{2u}{v}+\\frac{v}{u}\\)"
        },
        {
          "kind": "because",
          "text": "\\(\\frac{2u}{v}>0，\\frac{v}{u}>0\\)，且 \\(\\frac{2u}{v}\\cdot\\frac{v}{u}=2\\)"
        },
        {
          "kind": "therefore",
          "text": "配齐后得到「定积求和」结构"
        }
      ],
      "derive": [
        [
          "配齐结果",
          "7 倍目标＝3＋两个定积正项"
        ]
      ]
    },
    {
      "id": "s5",
      "section": "换元法",
      "title": "应用基本不等式",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-mapping",
        "methodTag": "配齐次式｜定积求和",
        "templateLabel": "代入基本不等式",
        "template": "\\(u+v\\ge2\\sqrt{uv}\\)",
        "formulaStyle": "sum-geometric",
        "showPositiveStep": true,
        "mappings": [
          {
            "slot": "第一个正项",
            "shape": "square",
            "value": "\\(\\frac{2u}{v}\\)",
            "condition": "\\(\\frac{2u}{v}>0\\)"
          },
          {
            "slot": "第二个正项",
            "shape": "circle",
            "value": "\\(\\frac{v}{u}\\)",
            "condition": "\\(\\frac{v}{u}>0\\)"
          }
        ],
        "mappedSum": "\\(\\frac{2u}{v}+\\frac{v}{u}\\)",
        "mappedProduct": "\\(2\\)",
        "mapped": "\\(\\frac{2u}{v}+\\frac{v}{u}\\ge2\\sqrt2\\)",
        "stageLabel": "代入定积",
        "fixedSourceTarget": "product",
        "fixedSourceLabel": "已知",
        "fixedCondition": "\\(\\frac{2u}{v}\\cdot\\frac{v}{u}=2\\)",
        "replacementText": "应用基本不等式",
        "replaced": "\\(\\frac{2u}{v}+\\frac{v}{u}\\ge2\\sqrt2\\)",
        "simplifyLabel": "代回配齐式",
        "substituted": "\\(7(\\frac{1}{u}+\\frac{1}{v})\\ge3+2\\sqrt2\\)",
        "conclusionLabel": "两边除以 7",
        "conclusion": "\\(\\frac{1}{u}+\\frac{1}{v}\\ge\\frac{3+2\\sqrt2}{7}\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "\\(\\frac{2u}{v}>0，\\frac{v}{u}>0\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{2u}{v}+\\frac{v}{u}\\ge2\\sqrt{\\frac{2u}{v}\\cdot\\frac{v}{u}}=2\\sqrt2\\)"
        },
        {
          "kind": "because",
          "text": "\\(7(\\frac{1}{u}+\\frac{1}{v})=3+\\frac{2u}{v}+\\frac{v}{u}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{1}{u}+\\frac{1}{v}\\ge\\frac{3+2\\sqrt2}{7}\\)"
        }
      ],
      "derive": [
        [
          "下界",
          "(3+2√2)/7"
        ]
      ]
    },
    {
      "id": "s6",
      "section": "换元法",
      "title": "验证取等并还原",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-equality-check",
        "templateLabel": "基本不等式取等",
        "first": {
          "value": "\\(\\frac{2u}{v}\\)",
          "shape": "square"
        },
        "second": {
          "value": "\\(\\frac{v}{u}\\)",
          "shape": "circle"
        },
        "conditionLabel": "结合新条件并还原",
        "condition": "\\(2u+v=7，x=u-1，y=\\frac{v-1}{2}\\)",
        "solved": "\\(v=\\sqrt2u\\Rightarrow x=6-\\frac{7\\sqrt2}{2}，y=\\frac{7\\sqrt2-8}{2}\\)",
        "verificationLabel": "代回原目标",
        "verification": "\\(\\frac{1}{x+1}+\\frac{1}{2y+1}=\\frac{3+2\\sqrt2}{7}\\)",
        "conclusion": "原式的最小值为 \\(\\frac{3+2\\sqrt2}{7}\\)"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "基本不等式取等 ⇔ 两个正项相等"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{2u}{v}=\\frac{v}{u}\\Rightarrow v=\\sqrt2u\\)"
        },
        {
          "kind": "because",
          "text": "\\(2u+v=7\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(u=7-\\frac{7\\sqrt2}{2}，v=7\\sqrt2-7\\)"
        },
        {
          "kind": "therefore",
          "text": "由 \\(x=u-1，y=\\frac{v-1}{2}\\)，得 \\(x=6-\\frac{7\\sqrt2}{2}，y=\\frac{7\\sqrt2-8}{2}\\)"
        },
        {
          "kind": "therefore",
          "text": "代回原式得 \\(\\frac{3+2\\sqrt2}{7}\\)，故最小值可以取得"
        }
      ],
      "derive": [
        [
          "最小值",
          "(3+2√2)/7"
        ],
        [
          "取等",
          "x=6-7√2/2，y=(7√2-8)/2"
        ]
      ]
    }
