    "lines": [
      {
        "text": "已知函数 \\(f(x)=\\sqrt{ax^2-2ax+1}\\) 的定义域为 R，则实数 \\(a\\) 的取值范围是（　）　A. \\((0,1]\\)　B. \\((0,+∞)\\)　C. \\([1,+∞)\\)　D. \\([0,1]\\)",
        "answerId": "answerI",
        "answer": "D"
      }
    ]
  },
