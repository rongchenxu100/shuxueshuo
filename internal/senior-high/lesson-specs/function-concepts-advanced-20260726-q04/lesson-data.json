  "steps": [
    {
      "id": "s1",
      "section": "求解",
      "title": "转化恒成立条件并分类讨论参数 a",
      "t": 0,
      "derive": [
        [
          "∵",
          "定义域为 R"
        ],
        [
          "∴",
          "\\(ax^2-2ax+1≥0\\) 对任意 \\(x∈R\\) 恒成立"
        ],
        [
          "当 a=0",
          "被开方式恒为 1，符合要求"
        ],
        [
          "当 a>0",
          "\\(Δ=(-2a)^2-4a=4a(a-1)≤0\\)，∴ \\(0<a≤1\\)"
        ],
        [
          "当 a<0",
          "抛物线开口向下，不可能恒非负"
        ],
        [
          "∴",
          "\\(0≤a≤1\\)，选 D"
        ]
      ],
      "box": [
        "二次项系数可能为 0，必须先单独检查退化情形。"
      ]
    }
  ],
