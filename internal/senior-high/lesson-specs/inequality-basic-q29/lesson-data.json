            {
              "label": "整理倒数",
              "expression": "\\(\\frac{a^2-a+1}{a+1}=(a+1)+\\frac{3}{a+1}-3\\)"
            }
          ]
        },
        "reading": "正数取倒数",
        "route": "重新观察结构",
        "caption": "取倒数只改变最值方向；继续整理，才能显露可直接配对的两个正项。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "原式 \\(=\\frac{a+1}{a^2-a+1}>0\\)，求其最大值等价于求其倒数的最小值"
        },
        {
          "kind": "therefore",
          "text": "原式的倒数为 \\(\\frac{a^2-a+1}{a+1}\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(\\frac{a^2-a+1}{a+1}=(a+1)+\\frac{3}{a+1}-3\\)"
        }
      ],
      "derive": [
        [
          "整理结果",
          "原式最大 ⇔ 倒数最小"
        ]
      ]
    },
