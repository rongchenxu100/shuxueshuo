          ],
          "note": "条件可直接写成 \\(b=1-a\\) → 条件消元法"
        },
        "reading": "条件可直接表示变量",
        "route": "条件消元法",
        "caption": "条件消元是兜底路线：先确认常用结构不直接适用，再抓住条件能够表示变量这一正向特征。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "原目标中两个正分式的乘积不是定值，不能直接应用基本不等式"
        },
        {
          "kind": "because",
          "text": "交换 \\(a、b\\) 后系数与分式位置改变，不是对称结构"
        },
        {
          "kind": "because",
          "text": "两个分母内部次数混合，不能直接配齐次；若对分母整体换元，分子仍保留原变量"
        },
        {
          "kind": "therefore",
          "text": "条件可直接写成 \\(b=1-a\\)，代入后能把二元目标降为一元目标，选择条件消元法"
        }
      ],
      "derive": [
        [
          "路线判断",
          "条件可直接表示变量｜条件消元法"
        ]
      ]
    },
    {
      "id": "s2",
      "section": "条件消元法",
      "title": "条件消元",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "basic-inequality-structure-scan",
        "showFocus": false,
        "condition": {
          "label": "条件整式",
          "expression": "\\(a+b=1\\)",
          "tag": "表示 b"
        },
        "target": {
          "label": "原目标",
          "expression": "\\(\\frac{2a}{a^2+b}+\\frac{b}{a+b^2}\\)",
          "tag": "消去 b"
        },
        "organization": {
          "eliminationHint": {
            "variable": "\\(b\\)",
            "isolated": "\\(1-a\\)",
            "independentVariable": "\\(a\\)",
            "targetBefore": "\\(\\frac{2a}{a^2+b}+\\frac{b}{a+b^2}\\)",
            "targetAfter": "\\(\\frac{a+1}{a^2-a+1}\\)",
            "ariaLabel": "由条件用 a 表示 b，代入目标后两个分母统一，二元目标降为只含 a 的一元目标"
          }
        },
        "reading": "二元目标降为一元目标",
        "route": "取倒数并整理一元目标"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "由 \\(a+b=1\\)，得 \\(b=1-a\\)；又因 \\(a，b>0\\)，所以 \\(0<a<1\\)"
        },
        {
          "kind": "therefore",
          "text": "\\(a^2+b=a^2-a+1\\)，且 \\(a+b^2=a+(1-a)^2=a^2-a+1\\)"
        },
        {
          "kind": "therefore",
          "text": "原式 \\(=\\frac{2a+1-a}{a^2-a+1}=\\frac{a+1}{a^2-a+1}>0\\)"
        }
      ],
      "derive": [
        [
          "消元结果",
          "二元目标降为一元正分式"
        ]
      ]
    },
    {
