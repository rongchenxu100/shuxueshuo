          "steps": [
            {
              "label": "直接应用",
              "expression": "两正分式的乘积不是定值"
            },
            {
              "label": "找对称",
              "expression": "交换 a、b 后题设改变"
            },
            {
              "label": "配齐次式",
              "expression": "分母内部次数混合"
            },
            {
              "label": "整体换元",
              "expression": "换分母后仍保留 a、b"
