    "keyPoints": {
      "title": "解题要点",
      "lead": "主方法仍是分式穿针；本题先用二次函数图像证明分母恒正，再只判断分子的符号。",
      "items": [
        "移项通分得 \\(\\frac{(x-3)(x+1)}{x^2+x+1}>0\\)。",
        "对分母 \\(y=x^2+x+1\\)，有 \\(a>0、\\Delta=-3<0\\)，抛物线恒在 x 轴上方，所以分母恒正且没有禁值点。",
        "分式符号因此只由分子决定；在 −1、3 两个分子零点处穿针，读取正号外侧。"
      ]
    },
    "lines": [
      {
        "text": "解不等式 \\(\\frac{2x^2-x-2}{x^2+x+1}>1\\)。"
      }
    ]
  },
  "steps": [
    {
      "id": "s1",
      "section": "分式不等式",
      "title": "证明分母恒正后穿针判号",
      "t": 0,
      "showDiagram": false,
      "visual": {
        "kind": "rational-threading-graph",
        "ariaLabel": "辅助抛物线说明分母恒正，主穿针图在分子零点负 1 和 3 处变号，正号阴影位于两点外侧",
        "title": "二次函数作辅助，分式穿针作主图",
        "intro": "先证明分母始终为正且没有禁值点，再把问题化为分子乘积大于 0。",
        "denominatorEvidence": {
          "expression": "\\(y=x^2+x+1\\)",
          "conclusion": "\\(a=1>0、\\Delta=-3<0\\)，图像恒在 x 轴上方，所以 \\(x^2+x+1>0\\)。"
        },
        "standardized": "\\(\\frac{(x-3)(x+1)}{x^2+x+1}>0\\iff(x-3)(x+1)>0\\)",
        "roots": [
          { "label": "−1", "kind": "numerator", "included": false },
          { "label": "3", "kind": "numerator", "included": false }
        ],
        "signs": ["+", "-", "+"],
        "selectSign": "+",
        "target": "取正号区间",
        "solution": "\\((-\\infty,-1)\\cup(3,+\\infty)\\)",
        "facts": [
          "分母没有实数零点，因此数轴上没有分母禁值点。",
          "−1、3 都是分子一次零点；题目严格大于 0，两个端点均为空心。"
        ],
        "caption": "二次函数图像只负责证明分母恒正；最终解集仍从分式穿针图读取。"
      },
      "reasoning": [
        {
          "kind": "because",
          "text": "移项通分得 \\(\\frac{2x^2-x-2}{x^2+x+1}-1=\\frac{x^2-2x-3}{x^2+x+1}=\\frac{(x-3)(x+1)}{x^2+x+1}>0\\)"
        },
        {
          "kind": "because",
          "text": "对分母二次函数，\\(a=1>0\\) 且 \\(\\Delta=1-4=-3<0\\)，图像恒在 x 轴上方，所以分母恒正且无禁值点"
        },
        {
          "kind": "because",
          "text": "引用分式穿针知识点，分式符号只由 \\((x-3)(x+1)\\) 决定；从最右侧正号开始，在 3、−1 两个一次零点处穿过并变号"
        },
        {
          "kind": "therefore",
          "text": "读取正号外侧且不取分子零点，解集为 \\((-\\infty,-1)\\cup(3,+\\infty)\\)"
        }
      ],
      "derive": [
        [
          "解集",
          "(-∞,-1)∪(3,+∞)"
        ]
      ]
    }
