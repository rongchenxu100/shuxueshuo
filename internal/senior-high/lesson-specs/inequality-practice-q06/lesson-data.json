    "breadcrumbTitle": "实战演练 · 第 6 题",
    "breadcrumbLabel": "解不等式与基本不等式",
    "breadcrumbPath": "site/senior-high/index.html",
    "breadcrumbSearch": "?chapter=inequalities&section=inequality-relations&module=inequality-practice"
