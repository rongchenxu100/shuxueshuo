    {
      "id": "s2",
      "section": "（2）",
      "title": "按 a 的取值范围分类求解",
      "t": 1,
      "showDiagram": false,
      "derive": [["当 -1≤a<0 时", "\\(\\frac{1}{a}=1\\) 得 \\(a=1\\)，不符合 \\(-1≤a<0\\)，舍去"], ["当 0≤a≤3 时", "\\(a^2-2a=1\\) 得 \\(a=1±\\sqrt{2}\\)，只有 \\(a=1+\\sqrt{2}\\) 符合 \\(0≤a≤3\\)"], ["当 3<a≤4 时", "\\(-2a+9=1\\) 得 \\(a=4\\)，符合 \\(3<a≤4\\)"], ["∴", "\\(a=1+\\sqrt{2}\\) 或 \\(a=4\\)"]],
      "box": ["代数方程的根只有落在当前分段范围内才有效"]
    },
    {
      "id": "s3",
      "section": "（3）",
      "title": "合并三段图象的值域",
      "t": 2,
      "derive": [["当 -1≤x<0 时", "\\(y=\\frac{1}{x}\\) 的值域为 \\((−∞,-1]\\)"], ["当 0≤x≤3 时", "\\(y=(x-1)^2-1\\) 的值域为 \\([-1,3]\\)"], ["当 3<x≤4 时", "\\(y=-2x+9\\) 的值域为 \\([1,3)\\)"], ["取并集", "\\((−∞,-1]∪[-1,3]∪[1,3)=(−∞,3]\\)"]],
      "box": ["值 3 已在 x=3 时由 y=(x-1)²-1 取得，因此总值域右端点闭合"]
    }
  ],
