{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuxueshuo.local/schemas/function-spec.schema.json",
  "title": "FunctionSpec",
  "type": "object",
  "required": ["version", "id", "panels"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "parameter": {
      "type": "object",
      "required": ["name", "initial"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "initial": { "type": "number" }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expr"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "expr": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/panel" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "openMin": { "type": "boolean" },
        "openMax": { "type": "boolean" },
        "extendsMin": { "type": "boolean" },
        "extendsMax": { "type": "boolean" },
        "id": { "type": "string" },
        "label": { "type": "string" },
        "minLabel": { "type": "string" },
        "maxLabel": { "type": "string" },
        "color": { "type": "string" }
      },
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "xExpr": { "type": "string" },
        "yExpr": { "type": "string" },
        "label": { "type": "string" },
        "labelDx": { "type": "number" },
        "labelDy": { "type": "number" }
      },
      "allOf": [
        { "anyOf": [{ "required": ["x"] }, { "required": ["xExpr"] }] },
        { "anyOf": [{ "required": ["y"] }, { "required": ["yExpr"] }] }
      ],
      "additionalProperties": false
    },
    "panel": {
      "type": "object",
      "required": ["id", "kind", "viewport"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "enum": ["mapping", "relationPlot", "numberLine", "functionGraph", "valueTable", "constraintList", "contextGeometry"] },
        "title": { "type": "string" },
        "viewport": { "$ref": "#/$defs/viewport" },
        "sourceSet": { "$ref": "#/$defs/set" },
        "targetSet": { "$ref": "#/$defs/set" },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "expr"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "expr": { "type": "string" },
              "valid": { "type": "boolean" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "x1", "y1", "x2", "y2"],
            "properties": {
              "id": { "type": "string" },
              "x1": { "type": "number" }, "y1": { "type": "number" },
              "x2": { "type": "number" }, "y2": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "guidePoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "showX": { "type": "boolean" },
              "showY": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "referenceLines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "orientation", "value"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "orientation": { "enum": ["vertical", "horizontal"] },
              "value": { "type": "number" },
              "label": { "type": "string" },
              "color": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "gridStepX": { "type": "number", "exclusiveMinimum": 0 },
        "gridStepY": { "type": "number", "exclusiveMinimum": 0 },
        "axisPadding": {
          "type": "object",
          "properties": {
            "minX": { "type": "number", "minimum": 0 },
            "maxX": { "type": "number", "minimum": 0 },
            "minY": { "type": "number", "minimum": 0 },
            "maxY": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "axis": {
          "type": "object",
          "required": ["min", "max"],
          "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "label": { "type": "string" } },
          "additionalProperties": false
        },
        "intervals": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
        "excludedPoints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "value"],
            "properties": { "id": { "type": "string" }, "value": { "type": "number" }, "label": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "domain": {
          "type": "object",
          "required": ["minX", "maxX", "minY", "maxY"],
          "properties": {
            "minX": { "type": "number" }, "maxX": { "type": "number" },
            "minY": { "type": "number" }, "maxY": { "type": "number" }
          },
          "additionalProperties": false
        },
        "function": {
          "type": "object",
          "required": ["variable", "expr", "label"],
          "properties": {
            "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "expr": { "type": "string" },
            "label": { "type": "string" },
            "intervals": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
            "range": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
            "finiteValues": { "type": "array", "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "variable", "expr", "label"],
            "properties": {
              "id": { "type": "string" },
              "variable": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "expr": { "type": "string" },
              "label": { "type": "string" },
              "intervals": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
              "range": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
              "finiteValues": { "type": "array", "items": { "type": "number" } }
            },
            "additionalProperties": false
          }
        },
        "studyIntervals": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
        "range": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "cells"],
            "properties": { "id": { "type": "string" }, "cells": { "type": "array", "items": { "type": "string" } } },
            "additionalProperties": false
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "expression", "result"],
            "properties": {
              "id": { "type": "string" }, "label": { "type": "string" },
              "expression": { "type": "string" }, "result": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "geometry": {
          "type": "object",
          "properties": {
            "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "startPointId", "endPointId", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "startPointId": { "type": "string" },
                  "endPointId": { "type": "string" },
                  "label": { "type": "string" },
                  "color": { "type": "string" },
                  "dashed": { "type": "boolean" },
                  "labelDx": { "type": "number" },
                  "labelDy": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "polygons": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "pointIds"],
                "properties": { "id": { "type": "string" }, "pointIds": { "type": "array", "items": { "type": "string" } }, "label": { "type": "string" } },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "set": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" }, "label": { "type": "string" },
        "intervals": { "type": "array", "items": { "$ref": "#/$defs/interval" } },
        "values": { "type": "array", "items": { "type": "number" } }
      },
      "additionalProperties": false
    }
  }
}
