{
  "example_id": "curve_candidate_parameter_solve",
  "annotation": {
    "purpose": "从几何候选中筛选满足曲线与参数条件的目标点。",
    "use_when": "几何构造产生有限候选，且曲线条件与参数范围可以唯一筛选。",
    "key_idea": "先生成候选集合，再用曲线和参数约束统一筛选。",
    "do_not_use_when": [
      "没有有限候选集合。",
      "缺少曲线或参数筛选条件。"
    ]
  },
  "problem_goal": {
    "goal_ref": "example.answer",
    "kind": "point_coordinate",
    "target_ref": "target_point",
    "answer_type": "Point"
  },
  "plan": {
    "format": "functional_plan/v3",
    "root_scope": {
      "scope_ref": "example",
      "goals": [
        {
          "goal_ref": "example.answer",
          "steps": [
            {
              "step_id": "derive_parametric_curve",
              "capability_id": "quadratic_from_constraints",
              "args": {
                "known_coefficients": "known_coefficient",
                "curve_point": "anchor_point",
                "free_parameters": "parameter"
              },
              "return_bindings": {
                "parabola": {"kind": "existing", "ref": "curve"}
              },
              "intent": "得到单参数函数。"
            },
            {
              "step_id": "derive_reference_point",
              "capability_id": "quadratic_y_axis_intercept_point",
              "args": {
                "quadratic": "curve"
              },
              "return_bindings": {
                "point": {"kind": "existing", "ref": "reference_point"}
              },
              "intent": "由函数求几何参考点。"
            },
            {
              "step_id": "derive_point_candidates",
              "capability_id": "right_angle_equal_length_candidates",
              "args": {
                "right_angle_equal_length": "construction_relation",
                "target": "target_point"
              },
              "intent": "生成目标点候选集合。"
            },
            {
              "step_id": "select_curve_candidate",
              "capability_id": "curve_candidate_parameter_solve",
              "args": {
                "candidates": {
                  "step_id": "derive_point_candidates",
                  "return": "candidates"
                },
                "parabola": "curve",
                "target_point": "target_point",
                "point_on_curve": "curve_membership",
                "symbol_constraint": "parameter_constraint"
              },
              "intent": "筛选满足全部条件的候选。"
            }
          ],
          "answer_from": {
            "step_id": "select_curve_candidate",
            "return": "selected_curve_point"
          }
        }
      ]
    }
  }
}
