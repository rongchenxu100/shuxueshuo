{
  "example_id": "square_path_reduction",
  "annotation": {
    "purpose": "利用正方形结构降低多段路径维度。",
    "use_when": "题目给出正方形、中点、中心和相关路径目标。",
    "key_idea": "先明确选择路径变换动点并验证等价路径，再建立该动点的轨迹。",
    "do_not_use_when": [
      "缺少正方形结构关系。",
      "路径与正方形顶点无关。"
    ]
  },
  "plan": {
    "format": "functional_plan/v3",
    "root_scope": {
      "scope_ref": "example",
      "steps": [
        {
          "step_id": "derive_parametric_curve",
          "capability_id": "quadratic_from_constraints",
          "args": {
            "curve_point": "known_curve_point",
            "free_parameters": "parameter"
          },
          "return_bindings": {
            "parabola": {"kind": "existing", "ref": "curve"}
          },
          "intent": "得到单参数函数。"
        },
        {
          "step_id": "parameterize_axis_point",
          "capability_id": "quadratic_axis_parameterized_point",
          "args": {
            "parabola": "curve"
          },
          "return_bindings": {
            "point": {"kind": "existing", "ref": "axis_point"}
          },
          "intent": "参数化轴上点。"
        },
        {
          "step_id": "derive_adjacent_vertex",
          "capability_id": "square_adjacent_vertex_from_side",
          "args": {
            "side_start": "known_curve_point",
            "side_end": "axis_point",
            "square": "square_relation"
          },
          "return_bindings": {
            "adjacent_vertex": {"kind": "existing", "ref": "moving_vertex"}
          },
          "intent": "构造并更新题面已有的动点。"
        },
        {
          "step_id": "reduce_square_path",
          "capability_id": "square_path_dimension_reduction",
          "args": {
            "path_minimum_target": "path_goal",
            "square": "square_relation",
            "midpoint_definition": "midpoint_relation",
            "square_center": "center_relation",
            "moving_point": "moving_vertex"
          },
          "intent": "明确选择动点，并把多段路径降为单动点折线。"
        }
      ],
      "goals": [
        {
          "goal_ref": "example.answer",
          "steps": [
            {
              "step_id": "derive_moving_locus",
              "capability_id": "parameterized_point_locus_line",
              "args": {
                "point": "moving_vertex"
              },
              "intent": "得到动点轨迹。"
            }
          ],
          "answer_from": {
            "step_id": "derive_moving_locus",
            "return": "line"
          }
        },
        {
          "goal_ref": "example.target_point",
          "steps": [
            {
              "step_id": "derive_answer_vertex",
              "capability_id": "square_adjacent_vertex_from_side",
              "args": {
                "side_start": "answer_side_start",
                "side_end": "answer_side_end",
                "square": "answer_square_relation"
              },
              "intent": "目标点本身就是本Goal答案时，不写return_bindings。"
            }
          ],
          "answer_from": {
            "step_id": "derive_answer_vertex",
            "return": "adjacent_vertex"
          }
        }
      ]
    }
  }
}
