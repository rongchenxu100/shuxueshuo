{
  "method_id": "organize_expressions",
  "title": "整理式子",
  "description": "整理式子：验证 LLM 推导，保留原结构，返回同对象的一个最终状态。",
  "summary": "按 parameters.steps 验证完整有理式推导链；只返回最终表达式，不求极值。",
  "solves": [
    "organize_expressions"
  ],
  "inputs": {
    "expression": {
      "required": true,
      "domain_type": "Expression",
      "runtime_type": "Expression",
      "view": {
        "mode": "latest_state",
        "domain_type": "Expression",
        "state_kind": "expression"
      }
    },
    "conditions": {
      "required": false,
      "domain_type": "ConditionList",
      "runtime_type": "ConditionList",
      "view": {
        "mode": "immutable_value",
        "domain_type": "ConditionList"
      }
    }
  },
  "outputs": {
