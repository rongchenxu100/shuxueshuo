{
  "method_id": "filter_point_candidates_by_quadratic_curve",
  "title": "用二次函数条件筛选点候选",
  "description": "用当前二次函数表达式和参数约束筛选点候选。",
  "summary": "输入: 候选点与抛物线；输出: 在抛物线上的候选点列表。",
  "solves": [
    "filter_point_candidates_by_quadratic_curve"
  ],
  "inputs": {
    "candidates": {
      "required": true,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "PointList",
      "runtime_type": "PointList",
      "view": {
        "mode": "exact_result",
        "domain_type": "PointList"
      }
    },
    "target": {
      "required": true,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "Point",
      "runtime_type": "PointRef",
      "view": {
        "mode": "identity",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "parabola": {
      "required": true,
      "symbolic_basis_role": "state_anchor",
      "domain_type": "QuadraticFunction",
      "runtime_type": "Parabola",
      "view": {
        "mode": "latest_state",
        "domain_type": "QuadraticFunction",
        "object_kind": "function",
        "state_kind": "expression"
      }
    },
    "x": {
      "required": true,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    },
    "parameter": {
      "required": true,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    },
    "parameter_constraint": {
      "required": false,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "Fact",
      "runtime_type": "Constraint",
      "view": {
        "mode": "immutable_value",
        "domain_type": "Fact"
      }
    },
    "quadratic_template": {
      "required": false,
      "functional_exposed": false,
      "domain_type": "QuadraticFunction",
      "runtime_type": "Expression",
      "view": {
        "mode": "immutable_value",
        "domain_type": "QuadraticFunction",
        "object_kind": "function",
        "state_kind": "expression"
      }
    }
  },
  "outputs": {
    "filtered_candidates": "PointList",
    "rejected_candidates": "PointList",
    "selected_candidate": "Point"
  },
  "is_pure": true,
  "output_activation": {
    "selected_candidate": {
      "kind": "runtime_condition",
      "runtime_condition": "exactly_one_candidate"
    }
  },
  "preconditions": [
    "parabola 已代入当前问能确定的已知条件",
    "candidates 来自几何构造"
  ],
  "postconditions": [
    "filtered_candidates 中每个候选在参数约束下可满足曲线条件",
    "若唯一保留候选，则 selected_candidate 为该候选点"
  ]
}
