    ],
    "role_schema": {
      "p1": "线段第一个端点。",
      "p2": "线段第二个端点。",
      "midpoint": "计算所得中点。"
    },
    "role_binder_id": "midpoint_point"
  },
  "visual": {
    "role_schema": {
      "p1": "线段第一个端点。",
