{
  "method_id": "point_candidates_from_curve_point_condition",
  "title": "由曲线点条件求目标点候选",
  "description": "把同参数曲线点代入二次函数，反求另一个目标点的候选。",
  "summary": "Given 待返回的目标点 P(t)、仅用于施加曲线条件的点 Q(t) 和已解抛物线, derive 使 Q(t) 在曲线上的 P 候选列表。返回值是一个整体的 PointList；列表中的每个候选保持 target_point=P 的对象身份，curve_point=Q 只提供约束。PointList 不能绑定为单个 Point。适用于几何构造先得到两个同参数点，再用 Q 落曲线来反求 P 的场景。",
  "solves": [
    "derive_point_candidates_from_curve_point_condition"
  ],
  "inputs": {
    "target_point": {
      "required": true,
      "symbolic_basis_role": "align_to_anchor",
      "description": "需要返回候选坐标的目标 Point；candidates 列表中的每个候选保持这个对象身份，但 candidates 本身仍是 PointList。",
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "curve_point": {
      "required": true,
      "symbolic_basis_role": "align_to_anchor",
      "description": "代入 parabola 建立参数方程的 Point；只提供约束，不作为返回对象。",
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "parabola": {
      "required": true,
      "symbolic_basis_role": "state_anchor",
      "domain_type": "QuadraticFunction",
      "runtime_type": "Parabola",
      "view": {
        "mode": "latest_state",
        "domain_type": "QuadraticFunction",
        "object_kind": "function",
        "state_kind": "expression"
      }
    },
    "x": {
      "required": true,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    },
    "parameter": {
      "required": true,
      "description": "target_point与curve_point共享的确切运动参数Symbol；应引用生成参数化点的前序call之parameter返回值",
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    }
  },
  "outputs": {
    "candidates": "PointList"
  },
  "is_pure": true,
  "preconditions": [
    "parameter必须以同一Symbol身份同时出现在target_point与curve_point中",
    "parabola 已代入当前问已知条件",
    "若目标答案是 P，应令 target_point=P；不要把曲线上的 Q 同时填写为 target_point"
  ],
  "postconditions": [
    "输出每个目标点候选对应的 curve_point 都在抛物线上"
  ],
  "explanation": {
    "role_schema": {
      "target_label": "目标点点名。",
      "curve_kind": "曲线类型的学生化名称。",
      "curve_point": "带参数的曲线点。",
      "curve_equation": "当前问已经确定的曲线方程。",
      "substitution_equation": "把曲线点代入曲线后的方程。",
      "parameter_equation": "整理后的参数方程。",
      "auxiliary_parameter": "为简化方程引入的辅助参数。",
      "auxiliary_equation": "辅助参数满足的方程。",
      "auxiliary_solutions": "辅助参数的解。",
      "parameter_solutions": "原参数的解。",
      "target_candidates": "目标点候选列表。"
    },
    "student_goal_template": "把同参数曲线点代入已知曲线，解出参数并回代目标点。",
    "student_title_template": "代入{curve_kind}求点{target_label}候选",
    "student_title_templates_by_goal": {},
    "derive_templates": [
      "∵{curve_point} 在 {curve_equation} 上",
      "∴{substitution_equation}",
      "∴{parameter_equation}",
      "设{auxiliary_parameter}",
      "∴{auxiliary_equation}",
      "∴{auxiliary_solutions}",
      "∴{parameter_solutions}",
      "∴{target_candidates}"
    ],
    "box_templates": [
      "{target_candidates}"
    ],
    "explanation_level": "template",
    "role_binding_strategy": "role_name_registry",
    "role_binder_id": "point_candidates_from_curve_point_condition",
    "student_nav_title_template": "求点{target_label}候选"
  },
  "visual": {
    "role_schema": {
      "target_candidates": "由曲线条件得到的目标点候选。",
      "candidate_context_regions": "可选的候选几何上下文区域，例如候选正方形。"
    },
    "scene_templates": [
      {
        "component": "CurvePointCandidateMarker",
        "persistence": "carry_forward",
        "fill": "rgba(14, 165, 233, 0.08)",
        "color": "rgba(2, 132, 199, 0.42)",
        "edge_color": "#0f766e"
      }
    ],
    "annotation_templates": [],
    "timeline_templates": [],
    "role_binder_id": "generic_visual"
  }
}
