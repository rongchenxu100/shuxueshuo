{
  "method_id": "quadratic_x_axis_intercept_point",
  "title": "求二次函数与 x 轴交点",
  "description": "由二次函数解析式求与 x 轴的交点。",
  "summary": "从当前抛物线求指定的 x 轴交点，坐标可以保留参数。known_point 仅表示另一个已经求出坐标的 x 轴交点；未知时应省略，不能填写当前目标点。",
  "solves": [
    "derive_quadratic_x_axis_intercept_point"
  ],
  "inputs": {
    "quadratic": {
      "required": true,
      "symbolic_basis_role": "state_anchor",
      "domain_type": "QuadraticFunction",
      "runtime_type": "Parabola",
      "view": {
        "mode": "latest_state",
        "domain_type": "QuadraticFunction",
        "object_kind": "function",
        "state_kind": "expression"
      }
    },
    "x": {
      "required": true,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      },
      "binding": {
        "schema_version": "method-input-binding/v1",
        "input_name": "x",
        "required": true,
        "derivation": {
          "kind": "canonical_symbol",
          "symbol_name": "x"
        }
      }
    },
    "target": {
      "required": true,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "Point",
      "runtime_type": "PointRef",
      "view": {
        "mode": "identity",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "target_state": {
      "required": false,
      "functional_exposed": false,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "known_point": {
      "required": false,
      "symbolic_basis_role": "align_to_anchor",
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    }
  },
  "outputs": {
    "point": "Point"
  },
  "is_pure": true,
  "preconditions": [
    "quadratic 是关于 x 的函数表达式，可以含未定系数"
  ],
  "do_not_use_when": [
    "不要把当前正在求解的目标交点同时作为 known_point。",
    "只有 PointRef 或点名、尚无坐标状态的点不能作为 known_point。",
    "同一目标点已有可见含参坐标时，不要从无状态依赖的另一条抛物线直接覆盖；应继续闭合已有点状态，或确保当前抛物线状态可证明由前序抛物线状态闭合得到。"
  ],
  "postconditions": [
    "输出点纵坐标为 0 且在曲线上；若给定 known_point，则输出另一个 x 轴交点；若目标 PointRef 声明 side=left/right，则输出对应左右交点"
  ],
  "teaching_unit": {
    "unit_key": "quadratic_x_axis_intercept_point/solve_intercept",
    "title_template": "求抛物线与 x 轴交点",
