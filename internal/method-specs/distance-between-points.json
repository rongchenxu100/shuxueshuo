{
  "method_id": "distance_between_points",
  "title": "计算两点距离",
  "description": "计算两点距离，并可选代入参数值得到具体距离。",
  "summary": "输入两点及可选参数值，输出两点距离。端点仍含未定参数时结果是开放表达式；所有参数已确定时结果是可直接使用的闭合值。代入一个参数不保证其他参数也已闭合。",
  "solves": [
    "derive_distance_between_points"
  ],
  "inputs": {
    "p1": {
      "required": true,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "p2": {
      "required": true,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "parameter": {
      "required": false,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    },
    "parameter_value": {
      "required": false,
      "domain_type": "Symbol",
      "runtime_type": "ParameterValue",
      "view": {
        "mode": "latest_state",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    }
  },
  "outputs": {
    "distance": "MinimumExpression",
    "evaluated_distance": "MinimumExpression"
  },
  "is_pure": true,
  "output_activation": {
    "evaluated_distance": {
      "kind": "requires_inputs",
      "required_inputs": [
        "parameter",
        "parameter_value"
      ]
    }
  },
  "scalar_result_forms": {
    "distance": {
      "possible_forms": [
        "open_expression",
        "closed_value"
      ],
      "description": "端点仍含未确定参数时为 open_expression；不存在自由参数时为 closed_value，可直接作为数值答案。",
      "closure_policy": "no_free_symbols"
    },
    "evaluated_distance": {
      "possible_forms": [
        "open_expression",
        "closed_value"
      ],
      "description": "代入指定参数后若仍含其他未确定参数则为 open_expression；不存在自由参数时为 closed_value。",
      "closure_policy": "no_free_symbols",
      "applied_substitutions": [
        [
          "parameter",
          "parameter_value"
        ]
      ]
    }
  },
  "teaching_unit": {
    "unit_key": "distance_between_points/compute_distance",
    "title_template": "用距离公式计算线段长度",
    "nav_title_template": "计算距离",
    "goal_template": "计算两点之间的距离，得到当前需要的长度表达式。",
    "derive_templates": [
      [
        "∵",
        "两端点为 {p1} 与 {p2}"
      ],
      [
        "计算",
        "由两点距离公式得到 {distance}"
      ]
    ],
    "box_templates": [
      "{distance}"
    ],
    "role_schema": {
      "p1": "第一个端点。",
      "p2": "第二个端点。",
      "distance": "实际物化的距离结果。"
    },
    "role_binder_id": "distance_between_points"
  },
  "visual": {
    "role_schema": {
      "p1": "第一个端点。",
      "p2": "第二个端点。",
      "distance": "两点距离。"
    },
    "scene_templates": [
      {
        "component": "DistanceBetweenPointsMarker",
        "endpoint_roles": [
          "p1",
          "p2"
        ],
        "output_role": "distance",
        "persistence": "step_only"
      }
    ],
    "annotation_templates": [],
    "timeline_templates": [],
    "role_binder_id": "generic_visual"
  },
  "interchangeable_arg_groups": [
    [
      "p1",
      "p2"
    ]
  ]
}
