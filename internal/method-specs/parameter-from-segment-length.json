{
  "method_id": "parameter_from_segment_length",
  "title": "由线段长度求参数",
  "description": "由线段长度条件求参数。",
  "summary": "输入: 线段端点和长度/线段比例条件；输出: 满足条件的参数值。支持 MN²=10 与 AD=2BC 这类原始线段关系。",
  "solves": [
    "derive_parameter_from_segment_length"
  ],
  "inputs": {
    "p1": {
      "required": true,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "p2": {
      "required": true,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "reference_p1": {
      "required": false,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "reference_p2": {
      "required": false,
      "domain_type": "Point",
      "runtime_type": "Point",
      "view": {
        "mode": "latest_state",
        "domain_type": "Point",
        "object_kind": "point",
        "state_kind": "coordinate"
      }
    },
    "parameter": {
      "required": true,
      "domain_type": "Symbol",
      "runtime_type": "Symbol",
      "view": {
        "mode": "identity",
        "domain_type": "Symbol",
        "object_kind": "symbol",
        "state_kind": "value"
      }
    },
    "condition": {
      "required": true,
      "domain_type": "Fact",
      "runtime_type": "Condition",
      "view": {
        "mode": "immutable_value",
        "domain_type": "Fact"
      }
    },
    "constraint": {
      "required": false,
      "domain_type": "Fact",
      "runtime_type": "Constraint",
      "view": {
        "mode": "immutable_value",
        "domain_type": "Fact"
      }
    }
  },
  "outputs": {
    "parameter_value": "ParameterValue"
  },
  "is_pure": true,
  "preconditions": [
    "p1/p2 必须是 condition 所声明线段的两个端点，顺序可以交换",
    "condition.value 表示绝对长度平方，或 condition.type=segment_length_relation 且提供对应参照线段的 reference_p1/reference_p2",
    "若长度方程有多个分支，constraint 必须唯一筛选一个合法分支"
  ],
  "do_not_use_when": [
    "parameter 没有实际出现在由端点和长度条件建立的方程中。",
    "线段比例条件缺少对应 reference_p1/reference_p2；不能按点名或条件文本猜测参照端点。",
    "长度方程有多个合法参数分支但没有提供足以唯一筛选的结构化 constraint；不会默认选择第一个解。"
  ],
  "postconditions": [
    "求得参数满足长度方程；若有参数范围约束，按范围筛选唯一解"
  ],
  "interchangeable_arg_groups": [
    [
      "p1",
      "p2"
    ],
    [
      "reference_p1",
      "reference_p2"
    ]
  ],
  "symbolic_closure": {
    "target_arg": "parameter",
    "equation_builder": "segment_length_equals_value",
    "known_substitutions": [],
    "known_mapping_args": [],
    "constraint_args": [
      "constraint"
    ],
    "preserved_symbol_args": [],
    "substitution_outputs": [
      "parameter_value"
    ],
    "require_unique_target": true,
    "constraint_filter": "parameter_value_constraint",
    "constraint_args_optional": true,
    "output_validator": "parameter_value_closure_outputs"
  }
}
