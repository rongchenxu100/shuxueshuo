      "allows_anonymous_result": true,
      "role": "同一原目标的准确换元结果；提供时对换元后的目标和条件消元",
      "domain_type": "Substitution",
      "runtime_type": "Substitution",
      "view": {
        "mode": "exact_result",
        "domain_type": "Substitution"
      }
    }
  },
