                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "call_count": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "search_signature": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "provenance_signature": {
              "type": "string",
              "minLength": 1
            },
            "witness_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
