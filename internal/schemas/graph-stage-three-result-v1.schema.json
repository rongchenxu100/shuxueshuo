{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-stage-three-result/v1",
  "type": "object",
  "required": [
    "contract",
    "run_id",
    "lesson_version",
    "stage_two",
    "stage_one",
    "input_validation",
    "input_diagnostics",
    "status",
    "goals",
    "events",
    "llm"
  ],
  "properties": {
    "contract": {
      "const": "graph-stage-three-result/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lesson_version": {
      "type": "string",
      "minLength": 1
    },
    "stage_two": {
      "type": "object",
      "required": [
        "reference",
        "sha256",
        "run_id"
      ],
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stage_one": {
      "type": "object",
      "required": [
        "reference",
        "sha256",
        "run_id"
      ],
      "properties": {
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "input_validation": {
      "type": "object",
      "required": [
        "ok",
        "diagnostics"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "input_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "input_error"
      ]
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Goal"
      }
    },
    "events": {
      "type": "object",
      "required": [
        "stream_id",
        "last_seq",
        "snapshot"
      ],
      "properties": {
        "stream_id": {
          "type": "string",
          "minLength": 1
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "semantic_calls",
        "network_attempts",
        "new_semantic_calls",
        "new_network_attempts"
      ],
      "properties": {
        "semantic_calls": {
          "const": 0
        },
        "network_attempts": {
          "const": 0
        },
        "new_semantic_calls": {
          "const": 0
        },
        "new_network_attempts": {
          "const": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "input_error"
          }
        }
      },
      "then": {
        "properties": {
          "goals": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "goals": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "Goal": {
      "type": "object",
      "required": [
        "target_ref",
        "label",
        "stage_two_status",
        "primary",
        "status",
        "selection",
        "d3",
        "d4",
        "routes",
        "route_status",
        "feasible_set",
        "answer",
        "diagnostics"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "pattern": "^/root(?:/children/[0-9]+)*/goals/[0-9]+$"
        },
        "label": {
          "type": "string"
        },
        "stage_two_status": {
          "enum": [
            "resolved",
            "unsupported",
            "selection_failed"
          ]
        },
        "primary": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "solved",
            "no_verified_route",
            "no_applicable_method",
            "conflict",
            "execution_error",
            "unsupported_type",
            "skipped",
            "capability_gap"
          ]
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "rule",
                "branches",
                "recommendation_rule"
              ],
              "properties": {
                "rule": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "branches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "branch",
                      "target",
                      "route_id",
                      "trigger",
                      "applicability",
                      "recommendation",
                      "route_plan",
                      "checks",
                      "missing_capabilities"
                    ],
                    "properties": {
                      "branch": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      },
                      "route_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "trigger": {
                        "enum": [
                          "triggered",
                          "not_triggered",
                          "unknown"
                        ]
                      },
                      "applicability": {
                        "enum": [
                          "applicable",
                          "not_applicable",
                          "unknown",
                          null
                        ]
                      },
                      "recommendation": {
                        "enum": [
                          "preferred",
                          "optional",
                          "superseded",
                          null
                        ]
                      },
                      "route_plan": {
                        "enum": [
                          "planned",
                          "capability_gap",
                          "not_planned"
                        ]
                      },
                      "checks": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      },
                      "missing_capabilities": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "minItems": 1
                },
                "recommendation_rule": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "recommendation_checks": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "d3": {
          "anyOf": [
            {
              "$ref": "#/$defs/D3"
            },
            {
              "type": "null"
            }
          ]
        },
        "d4": {
          "anyOf": [
            {
              "$ref": "#/$defs/D4"
            },
            {
              "type": "null"
            }
          ]
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route_id",
              "branch",
              "method",
              "status"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "verified",
                  "capability_gap",
                  "math_failed",
                  "execution_error"
                ]
              },
              "trajectory": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "answer": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/goalAnswer"
                  }
                ]
              }
            }
          }
        },
        "route_status": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "feasible_set": {},
        "answer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/goalAnswer"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "solved"
              }
            }
          },
          "then": {
            "properties": {
              "feasible_set": {
                "not": {
                  "type": "null"
                }
              },
              "answer": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "feasible_set": {
                "type": "null"
              },
              "answer": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "D3": {
      "type": "object",
      "required": [
        "id",
        "title",
        "interaction",
        "expected_answer",
        "verdicts"
      ],
      "properties": {
        "id": {
          "const": "D3"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "interaction": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "x",
                "y",
                "coverage"
              ],
              "properties": {
                "type": {
                  "const": "plane"
                },
                "x": {
                  "type": "object"
                },
                "y": {
                  "type": "object"
                },
                "coverage": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "read"
                }
              }
            }
          ]
        },
        "expected_answer": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "cell"
              ],
              "properties": {
                "cell": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            {
              "type": "object",
              "maxProperties": 0
            }
          ]
        },
        "verdicts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "value",
              "message"
            ],
            "properties": {
              "value": {
                "enum": [
                  "fit",
                  "superseded",
                  "not_triggered",
                  "unfit"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "D4": {
      "type": "object",
      "required": [
        "id",
        "title",
        "options"
      ],
      "properties": {
        "id": {
          "const": "D4"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "route_id",
              "branch",
              "method",
              "recommendation",
              "route_plan",
              "message"
            ],
            "properties": {
              "route_id": {
                "type": "string",
                "minLength": 1
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "recommendation": {
                "enum": [
                  "preferred",
                  "optional"
                ]
              },
              "route_plan": {
                "enum": [
                  "planned",
                  "capability_gap"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "mathValue": {
      "type": "object",
      "required": [
        "expression",
        "latex"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "exactScalar": {
      "type": "object",
      "required": [
        "expression",
        "latex",
        "exact"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "latex": {
          "type": "string"
        },
        "exact": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "goalAnswer": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "status",
            "set"
          ],
          "properties": {
            "kind": {
              "enum": [
                "find_range",
                "find_domain"
              ]
            },
            "status": {
              "const": "set"
            },
            "set": {
              "$ref": "#/$defs/mathValue"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "find_minimum"
            },
            "status": {
              "const": "attained"
            },
            "value": {
              "$ref": "#/$defs/exactScalar"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status",
            "bound"
          ],
          "properties": {
            "kind": {
              "const": "find_minimum"
            },
            "status": {
              "const": "not_attained"
            },
            "bound": {
              "$ref": "#/$defs/exactScalar"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "find_minimum"
            },
            "status": {
              "const": "empty_feasible_set"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "find_minimum"
            },
            "status": {
              "const": "unbounded_below"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "find_maximum"
            },
            "status": {
              "const": "attained"
            },
            "value": {
              "$ref": "#/$defs/exactScalar"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status",
            "bound"
          ],
          "properties": {
            "kind": {
              "const": "find_maximum"
            },
            "status": {
              "const": "not_attained"
            },
            "bound": {
              "$ref": "#/$defs/exactScalar"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "find_maximum"
            },
            "status": {
              "const": "empty_feasible_set"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "const": "find_maximum"
            },
            "status": {
              "const": "unbounded_above"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
