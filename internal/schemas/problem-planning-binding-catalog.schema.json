{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-planning-binding-catalog.schema.json",
  "title": "ProblemPlanningBindingCatalog authority payload",
  "type": "object",
  "required": [
    "schema_version",
    "planning_context_id",
    "bundle_authority_token",
    "planner_state_context_id",
    "problem_id",
    "family_id",
    "bindings",
    "goal_input_refs",
    "goal_answer_refs",
    "goal_visible_scope_ids",
    "binding_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "problem-planning-binding-catalog/v1"
    },
    "planning_context_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_authority_token": {
      "type": "object",
      "required": [
        "extraction_context_id",
        "dependency_hash",
        "problem_revision_id",
        "problem_semantic_hash",
        "bundle_id"
      ],
      "properties": {
        "extraction_context_id": {
          "type": "string",
          "minLength": 1
        },
        "dependency_hash": {
          "type": "string",
          "minLength": 1
        },
        "problem_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "problem_semantic_hash": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "planner_state_context_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "family_id": {
      "type": "string",
      "minLength": 1
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "semantic_ref",
          "runtime_node_id",
          "source_unit_ids",
          "owner_scope_id",
          "visible_goal_unit_ids",
          "usage",
          "typed_sources"
        ],
        "properties": {
          "semantic_ref": {
            "$ref": "#/$defs/semantic_ref"
          },
          "runtime_node_id": {
            "type": "string",
            "minLength": 1
          },
          "source_unit_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner_scope_id": {
            "type": "string",
            "minLength": 1
          },
          "visible_goal_unit_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "usage": {
            "enum": [
              "input",
              "answer"
            ]
          },
          "typed_sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/problem_typed_source"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "goal_input_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/semantic_ref_key"
        }
      }
    },
    "goal_answer_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/semantic_ref_key"
      }
    },
    "goal_visible_scope_ids": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "binding_signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "math_object_id": {
      "type": "object",
      "required": [
        "value",
        "kind",
        "origin_scope_id"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "origin_scope_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "logical_state_key": {
      "type": "object",
      "required": [
        "object_id",
        "state_kind",
        "runtime_type"
      ],
      "properties": {
        "object_id": {
          "$ref": "#/$defs/math_object_id"
        },
        "state_kind": {
          "type": "string",
          "minLength": 1
        },
        "runtime_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "state_slot_id": {
      "type": "object",
      "required": [
        "logical_key",
        "storage_scope_id"
      ],
      "properties": {
        "logical_key": {
          "$ref": "#/$defs/logical_state_key"
        },
        "storage_scope_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "state_version_id": {
      "type": "object",
      "required": [
        "slot_id",
        "ordinal"
      ],
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/state_slot_id"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "semantic_ref": {
      "type": "object",
      "required": [
        "ref",
        "kind"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "problem_typed_source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "math_object_id"
          ],
          "properties": {
            "kind": {
              "const": "math_object"
            },
            "runtime_type": {
              "type": "string",
              "minLength": 1
            },
            "math_object_id": {
              "$ref": "#/$defs/math_object_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "math_object_id"
          ],
          "properties": {
            "kind": {
              "const": "answer_target"
            },
            "runtime_type": {
              "type": "string",
              "minLength": 1
            },
            "math_object_id": {
              "$ref": "#/$defs/math_object_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "state_version_id",
            "state_slot_id"
          ],
          "properties": {
            "kind": {
              "const": "state_version"
            },
            "runtime_type": {
              "type": "string",
              "minLength": 1
            },
            "math_object_id": {
              "$ref": "#/$defs/math_object_id"
            },
            "state_version_id": {
              "$ref": "#/$defs/state_version_id"
            },
            "state_slot_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "condition_id"
          ],
          "properties": {
            "kind": {
              "const": "condition"
            },
            "runtime_type": {
              "type": "string",
              "minLength": 1
            },
            "condition_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "functional_source": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "state_version_id"
          ],
          "properties": {
            "kind": {
              "const": "state_version"
            },
            "state_version_id": {
              "$ref": "#/$defs/state_version_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "condition_id"
          ],
          "properties": {
            "kind": {
              "const": "condition"
            },
            "condition_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "math_object_id"
          ],
          "properties": {
            "kind": {
              "const": "math_object"
            },
            "math_object_id": {
              "$ref": "#/$defs/math_object_id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "compiler_selector_id"
          ],
          "properties": {
            "kind": {
              "const": "compiler_selector"
            },
            "compiler_selector_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "source_call_id",
            "source_return_name"
          ],
          "properties": {
            "kind": {
              "const": "call_result"
            },
            "source_call_id": {
              "type": "string",
              "minLength": 1
            },
            "source_return_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "semantic_ref_key": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": false
    },
    "binding": {
      "type": "object",
      "required": [
        "semantic_ref",
        "runtime_node_id",
        "source_unit_ids",
        "owner_scope_id",
        "visible_goal_unit_ids",
        "usage",
        "typed_sources"
      ],
      "properties": {
        "semantic_ref": {
          "$ref": "#/$defs/semantic_ref"
        },
        "runtime_node_id": {
          "type": "string",
          "minLength": 1
        },
        "source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner_scope_id": {
          "type": "string",
          "minLength": 1
        },
        "visible_goal_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usage": {
          "enum": [
            "input",
            "answer"
          ]
        },
        "typed_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/problem_typed_source"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
