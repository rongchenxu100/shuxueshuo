{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-method-execution/v1",
  "type": "object",
  "required": [
    "schema_version",
    "method",
    "inputs",
    "steps",
    "outputs",
    "exits"
  ],
  "properties": {
    "schema_version": {
      "const": "graph-method-execution/v1"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "calls",
          "judgments",
          "display_units"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "calls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "public_ref",
                "capability",
                "inputs",
                "outputs"
              ],
              "properties": {
                "public_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "capability": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "type": "object"
                },
                "outputs": {
                  "type": "object"
                },
                "guard": {
                  "$ref": "#/$defs/guard"
                },
                "presentation": {
                  "enum": [
                    "expanded",
                    "fold"
                  ]
                }
              }
            }
          },
          "judgments": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "depends_on",
                "function",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "function": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "guard": {
                  "$ref": "#/$defs/guard"
                }
              }
            }
          },
          "cases": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "source",
              "binding",
              "through",
              "collect",
              "outputs",
              "entry"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "binding": {
                "type": "string",
                "minLength": 1
              },
              "through": {
                "type": "string",
                "minLength": 1
              },
              "collect": {
                "type": "string",
                "minLength": 1
              },
              "outputs": {
                "type": "object",
                "minProperties": 1
              },
              "entry": {
                "$ref": "#/properties/steps/items"
              }
            }
          },
          "display_units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "depends_on",
                "template",
                "bindings"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "template": {
                  "type": "string",
                  "minLength": 1
                },
                "bindings": {
                  "type": "object"
                },
                "source_scope": {
                  "type": "object",
                  "oneOf": [
                    {
                      "required": [
                        "step"
                      ]
                    },
                    {
                      "required": [
                        "steps"
                      ]
                    }
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "step": {
                      "type": "string",
                      "minLength": 1
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "actions": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "guard": {
                  "$ref": "#/$defs/guard"
                }
              }
            }
          },
          "guard": {
            "$ref": "#/$defs/guard"
          },
          "merges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "order",
                "branches"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer"
                },
                "guard": {
                  "$ref": "#/$defs/guard"
                },
                "branches": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "guard",
                      "bindings"
                    ],
                    "properties": {
                      "guard": {
                        "$ref": "#/$defs/guard"
                      },
                      "bindings": {
                        "type": "object",
                        "minProperties": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "options": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "source",
              "binding",
              "through",
              "collect",
              "outputs",
              "entry"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "binding": {
                "type": "string",
                "minLength": 1
              },
              "through": {
                "type": "string",
                "minLength": 1
              },
              "collect": {
                "type": "string",
                "minLength": 1
              },
              "outputs": {
                "type": "object",
                "minProperties": 1
              },
              "entry": {
                "$ref": "#/properties/steps/items"
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "outputs": {
      "type": "object"
    },
    "exits": {
      "type": "object"
    },
    "admission": {
      "type": "object",
      "required": [
        "bindings",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "resolver"
                ],
                "properties": {
                  "resolver": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "constant"
                ],
                "properties": {
                  "constant": {}
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "function",
              "inputs"
            ],
            "additionalProperties": false,
            "properties": {
              "function": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "constant"
          ],
          "properties": {
            "constant": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ref",
            "equals"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "equals": {}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/guard"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
