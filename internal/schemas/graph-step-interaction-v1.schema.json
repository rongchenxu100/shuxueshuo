{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shuxueshuo.local/schemas/graph-step-interaction-v1.schema.json",
  "title": "Stage-three step interaction result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "run_id",
    "lesson_version",
    "target_ref",
    "route_id",
    "interaction_id",
    "status",
    "steps",
    "interaction_revision",
    "interaction_sha256",
    "parts"
  ],
  "properties": {
    "contract": {
      "const": "graph-step-interaction/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lesson_version": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": "string",
      "minLength": 1
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "interaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{24}$"
    },
    "status": {
      "enum": [
        "interactive",
        "readonly"
      ]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "math_step_sha256"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "math_step_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "interaction_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interaction_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "interactive"
          }
        }
      },
      "then": {
        "properties": {
          "parts": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "reason"
          ]
        }
      },
      "else": {
        "required": [
          "reason"
        ],
        "properties": {
          "parts": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "planeAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "options"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "$ref": "#/$defs/text"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(?:(o|s[0-9]+o)[0-9]+|equal|different)$"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "feedback": {
          "$ref": "#/$defs/text"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "graphPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "open": {
          "type": "boolean"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "place": {
          "enum": [
            "above-right",
            "above-left",
            "below-right",
            "below-left"
          ]
        }
      }
    },
    "graphTick": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/text"
        }
      ],
      "items": false
    },
    "functionGraphParams": {
      "type": "object",
      "required": [
        "bounds",
        "title",
        "description",
        "variable",
        "interval",
        "interval_closed",
        "points",
        "xTicks"
      ],
      "properties": {
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "variable": {
          "$ref": "#/$defs/text"
        },
        "interval": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "minItems": 2,
          "maxItems": 2
        },
        "interval_closed": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphPoint"
          }
        },
        "xTicks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphTick"
          }
        }
      }
    },
    "quadraticGraphParams": {
      "allOf": [
        {
          "$ref": "#/$defs/functionGraphParams"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "coefficient",
        "vertex"
      ],
      "properties": {
        "coefficient": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "vertex": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "yLabel": {
          "type": "string"
        },
        "showVertex": {
          "type": "boolean"
        },
        "vertexLabel": {
          "type": "string"
        },
        "markSign": {
          "enum": [
            "above",
            "below"
          ]
        },
        "strict": {
          "type": "boolean"
        }
      }
    },
    "linearGraphParams": {
      "allOf": [
        {
          "$ref": "#/$defs/functionGraphParams"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "slope",
        "intercept"
      ],
      "properties": {
        "slope": {
          "type": "number"
        },
        "intercept": {
          "type": "number"
        },
        "markSign": {
          "enum": [
            "above",
            "below"
          ]
        },
        "strict": {
          "type": "boolean"
        }
      }
    },
    "reciprocalGraphParams": {
      "allOf": [
        {
          "$ref": "#/$defs/functionGraphParams"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "a",
        "b",
        "negative"
      ],
      "properties": {
        "a": {
          "type": "number"
        },
        "b": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "c": {
          "type": "number"
        },
        "negative": {
          "type": "boolean"
        }
      }
    },
    "axisExplorerParams": {
      "allOf": [
        {
          "$ref": "#/$defs/functionGraphParams"
        }
      ],
      "unevaluatedProperties": false,
      "required": [
        "coefficient",
        "constant",
        "axis",
        "target"
      ],
      "properties": {
        "coefficient": {
          "type": "number",
          "not": {
            "const": 0
          }
        },
        "constant": {
          "type": "number"
        },
        "constant_by_axis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "linear",
            "quadratic"
          ],
          "properties": {
            "linear": {
              "type": "number"
            },
            "quadratic": {
              "type": "number"
            }
          }
        },
        "parameter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "scale",
            "offset"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/text",
              "minLength": 1
            },
            "scale": {
              "type": "number",
              "not": {
                "const": 0
              }
            },
            "offset": {
              "type": "number"
            }
          }
        },
        "axis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "step",
            "value"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "value": {
              "type": "number"
            }
          }
        },
        "marks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "label"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "target": {
          "enum": [
            "min",
            "max"
          ]
        }
      }
    },
    "numberLinePiece": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "left_closed",
        "right_closed"
      ],
      "properties": {
        "from": {
          "type": [
            "number",
            "null"
          ]
        },
        "to": {
          "type": [
            "number",
            "null"
          ]
        },
        "left_closed": {
          "type": "boolean"
        },
        "right_closed": {
          "type": "boolean"
        }
      }
    },
    "numberLineParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounds",
        "title",
        "description",
        "variable",
        "pieces",
        "points",
        "ticks"
      ],
      "properties": {
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "variable": {
          "$ref": "#/$defs/text"
        },
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/numberLinePiece"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphPoint"
          }
        },
        "ticks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphTick"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "params"
      ],
      "properties": {
        "kind": {
          "enum": [
            "quadratic",
            "linear",
            "reciprocal_sum",
            "number_line",
            "axis_explorer"
          ]
        },
        "params": {
          "type": "object"
        },
        "caption": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "quadratic"
            },
            "params": {
              "$ref": "#/$defs/quadraticGraphParams"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "linear"
            },
            "params": {
              "$ref": "#/$defs/linearGraphParams"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "reciprocal_sum"
            },
            "params": {
              "$ref": "#/$defs/reciprocalGraphParams"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "number_line"
            },
            "params": {
              "$ref": "#/$defs/numberLineParams"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "axis_explorer"
            },
            "params": {
              "$ref": "#/$defs/axisExplorerParams"
            }
          }
        }
      ]
    },
    "domainExact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "latex",
        "exact"
      ],
      "properties": {
        "expression": {
          "type": "string"
        },
        "latex": {
          "type": "string"
        },
        "exact": {
          "type": "object"
        }
      }
    },
    "domainNumberLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variable",
        "label",
        "bounds",
        "intervals",
        "points",
        "ticks",
        "exact_set"
      ],
      "properties": {
        "variable": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bounds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "intervals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right",
              "left_closed",
              "right_closed",
              "exact"
            ],
            "properties": {
              "left": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "right": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "left_closed": {
                "type": "boolean"
              },
              "right_closed": {
                "type": "boolean"
              },
              "exact": {
                "$ref": "#/$defs/domainExact"
              }
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "label",
              "exact"
            ],
            "properties": {
              "at": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "exact": {
                "$ref": "#/$defs/domainExact"
              }
            }
          }
        },
        "ticks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "label",
              "exact"
            ],
            "properties": {
              "at": {
                "type": "number"
              },
              "label": {
                "type": "string"
              },
              "exact": {
                "$ref": "#/$defs/domainExact"
              }
            }
          }
        },
        "exact_set": {
          "$ref": "#/$defs/domainExact"
        },
        "condition_id": {
          "type": "string"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^/root/"
        },
        "ast_path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "domainEndpointCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "label",
        "exact",
        "included",
        "holds",
        "passed",
        "reason",
        "sources"
      ],
      "properties": {
        "at": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "exact": {
          "$ref": "#/$defs/domainExact"
        },
        "included": {
          "type": "boolean"
        },
        "holds": {
          "type": "boolean"
        },
        "passed": {
          "const": true
        },
        "reason": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_ref",
              "ast_path",
              "basis_refs",
              "kind",
              "holds"
            ],
            "properties": {
              "source_ref": {
                "type": "string",
                "pattern": "^/root/"
              },
              "ast_path": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "basis_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "enum": [
                  "radicand_nonnegative",
                  "denominator_nonzero",
                  "zero_power_base_nonzero",
                  "explicit_input_domain"
                ]
              },
              "expression_defined": {
                "type": "boolean"
              },
              "holds": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "question",
        "interaction",
        "expected_answer",
        "feedback",
        "submit_label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}#[0-9]+$"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "submit_label": {
          "$ref": "#/$defs/text"
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "completion_graph": {
          "$ref": "#/$defs/graph"
        },
        "completion_graphs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/graph"
          }
        },
        "completion_group": {
          "$ref": "#/$defs/text"
        },
        "condition_number_lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domainNumberLine"
          }
        },
        "completion_number_line": {
          "$ref": "#/$defs/domainNumberLine"
        },
        "endpoint_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/domainEndpointCheck"
          }
        },
        "source_regions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expression",
            "expression_ast",
            "bound_symbols",
            "regions"
          ],
          "properties": {
            "expression": {
              "type": "string"
            },
            "expression_ast": {
              "type": "array"
            },
            "bound_symbols": {
              "type": "object",
              "required": [
                "function_argument"
              ],
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "regions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_ref",
                  "ast_path",
                  "condition_id",
                  "basis_refs",
                  "label",
                  "option_value"
                ],
                "properties": {
                  "source_ref": {
                    "type": "string",
                    "pattern": "^/root/"
                  },
                  "ast_path": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "condition_id": {
                    "type": "string"
                  },
                  "basis_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "label": {
                    "type": "string"
                  },
                  "option_value": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "stem_board": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caption",
            "lines"
          ],
          "properties": {
            "caption": {
              "$ref": "#/$defs/text"
            },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "answer": {
              "type": "string"
            },
            "terms": {
              "type": "string"
            },
            "x": {
              "type": "string"
            },
            "y": {
              "type": "string"
            },
            "method": {
              "type": "string"
            },
            "method_choice": {
              "type": "string"
            }
          }
        },
        "alternatives": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "message",
              "href"
            ],
            "properties": {
              "message": {
                "$ref": "#/$defs/text"
              },
              "href": {
                "type": "string",
                "pattern": "^/knowledge/[a-z][a-z0-9-]*/$"
              }
            }
          }
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "log": {
              "$ref": "#/$defs/text"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "interaction": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "read"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "field",
                "options"
              ],
              "properties": {
                "type": {
                  "const": "choice"
                },
                "field": {
                  "type": "string"
                },
