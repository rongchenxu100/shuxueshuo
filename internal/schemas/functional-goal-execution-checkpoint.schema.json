{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "functional-goal-execution-checkpoint.schema.json",
  "title": "Functional Goal Execution Checkpoint v1",
  "type": "object",
  "required": [
    "schema_version",
    "root_scope",
    "root_issues",
    "metrics",
    "planning_context_id",
    "problem_revision_id",
    "problem_semantic_hash",
    "plan_id",
    "functional_problem_binding_signature",
    "step_binding_signatures",
    "goal_unit_ids",
    "source_unit_ids",
    "provisional_state_signature",
    "checkpoint_id"
  ],
  "properties": {
    "schema_version": {
      "const": "functional-goal-execution-checkpoint/v1"
    },
    "root_scope": {
      "$ref": "#/$defs/execution_scope_0"
    },
    "root_issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostic_authorities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "planning_context_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_semantic_hash": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "functional_problem_binding_signature": {
      "type": "string",
      "minLength": 1
    },
    "step_binding_signatures": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "goal_unit_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "source_unit_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      }
    },
    "provisional_state_signature": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Copy a scope-local visible Entity or Fact ref from Planner Problem View exactly, without adding a scope prefix. This is the only wire form for a named Entity. The compiler selects its identity or latest visible state and establishes producer dependencies; a Fact remains the verified problem snapshot."
    },
    "step_result_ref": {
      "type": "object",
      "description": "Read one named return from an earlier visible step. Use this for anonymous results only. A named Math Entity must use its SourceRef; the compiler obtains the exact input required by the capability.",
      "required": [
        "step_id",
        "return"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "return": {
          "type": "string",
          "minLength": 1,
          "description": "Copy the producer capability's public return name exactly; its type must be accepted by the consuming argument."
        }
      },
      "additionalProperties": false
    },
    "functional_ref": {
      "description": "Use a SourceRef string for every named Entity or visible Fact. Use StepResultRef only for a return without a named Math Entity identity.",
      "oneOf": [
        {
          "$ref": "#/$defs/source_ref"
        },
        {
          "$ref": "#/$defs/step_result_ref"
        }
      ]
    },
    "authored_step": {
      "type": "object",
      "required": [
        "step_id",
        "capability_id",
        "args"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "object",
          "description": "Capability inputs keyed by public catalog arg names; values are exact visible SourceRefs or earlier StepResultRefs. Never invent a string name for an anonymous step result.",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/functional_ref"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/functional_ref"
                }
              }
            ]
          }
        },
        "output_targets": {
          "type": "object",
          "minProperties": 1,
          "description": "Bind non-answer returns to existing visible Problem objects; keys are public capability return roles.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "return_expectations": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "open_expression",
              "closed_value",
              "open_state",
              "closed_state"
            ]
          }
        },
        "intent": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "execution_step": {
      "type": "object",
      "required": [
        "step_id",
        "status",
        "authored_step"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "valid",
            "authority_invalid",
            "ready",
            "runtime_verified",
            "runtime_failed",
            "blocked_by_dependency",
            "pruned_dead"
          ]
        },
        "authored_step": {
          "$ref": "#/$defs/authored_step"
        },
        "resolved_inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "arg",
              "index",
              "source"
            ],
            "properties": {
              "arg": {
                "type": "string",
                "minLength": 1
              },
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "$ref": "#/$defs/functional_ref"
              },
              "resolution": {
                "enum": [
                  "source_snapshot",
                  "step_result",
                  "unresolved"
                ]
              },
              "runtime_type": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "value_omitted_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "actual_outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "return",
              "runtime_type"
            ],
            "properties": {
              "return": {
                "type": "string",
                "minLength": 1
              },
              "runtime_type": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "value_omitted_reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "typed_issue": {
          "type": "object"
        },
        "blocked_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "execution_goal": {
      "type": "object",
      "required": [
        "goal_ref",
        "status"
      ],
      "properties": {
        "goal_ref": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_step"
          }
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": [
        "authority_valid_step_count",
        "authority_invalid_step_count",
        "pruned_dead_step_count",
        "provisional_executed_step_count",
        "blocked_by_dependency_step_count",
        "transaction_attempted",
        "transaction_ok",
        "all_required_goals_verified",
        "blocked_stage"
      ],
      "properties": {
        "authority_valid_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_invalid_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "pruned_dead_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "provisional_executed_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_by_dependency_step_count": {
          "type": "integer",
          "minimum": 0
        },
        "transaction_attempted": {
          "type": "boolean"
        },
        "transaction_ok": {
          "type": "boolean"
        },
        "all_required_goals_verified": {
          "type": "boolean"
        },
        "blocked_stage": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "execution_scope_0": {
      "type": "object",
      "required": [
        "scope_ref"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_step"
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_goal"
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_scope_1"
          }
        }
      },
      "additionalProperties": false
    },
    "execution_scope_1": {
      "type": "object",
      "required": [
        "scope_ref"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_step"
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_goal"
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_scope_2"
          }
        }
      },
      "additionalProperties": false
    },
    "execution_scope_2": {
      "type": "object",
      "required": [
        "scope_ref"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_step"
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_goal"
          }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_scope_3"
          }
        }
      },
      "additionalProperties": false
    },
    "execution_scope_3": {
      "type": "object",
      "required": [
        "scope_ref"
      ],
      "properties": {
        "scope_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_step"
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/execution_goal"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
