{
  "$defs": {
    "authored_step": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/functional_ref"
              },
              {
                "items": {
                  "$ref": "#/$defs/functional_ref"
                },
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "description": "Capability inputs keyed by public catalog arg names; values are exact visible SourceRefs or earlier StepResultRefs. Never invent a string name for a value produced by a step.",
          "type": "object"
        },
        "capability_id": {
          "minLength": 1,
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "type": "string"
        },
        "output_targets": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "description": "Bind non-answer returns to existing visible Problem objects; keys are public capability return roles.",
          "minProperties": 1,
          "type": "object"
        },
        "return_expectations": {
          "additionalProperties": {
            "enum": [
              "open_expression",
              "closed_value",
              "open_state",
              "closed_state"
            ]
          },
          "minProperties": 1,
          "type": "object"
        },
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "capability_id",
        "args"
      ],
      "type": "object"
    },
    "execution_goal": {
      "additionalProperties": false,
      "properties": {
        "goal_ref": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/execution_step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "goal_ref",
        "status"
      ],
      "type": "object"
    },
    "execution_scope_0": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/execution_scope_1"
          },
          "minItems": 1,
          "type": "array"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/execution_goal"
          },
          "minItems": 1,
          "type": "array"
        },
        "scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope_steps": {
          "items": {
            "$ref": "#/$defs/execution_step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "scope_ref"
      ],
      "type": "object"
    },
    "execution_scope_1": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/execution_scope_2"
          },
          "minItems": 1,
          "type": "array"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/execution_goal"
          },
          "minItems": 1,
          "type": "array"
        },
        "scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope_steps": {
          "items": {
            "$ref": "#/$defs/execution_step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "scope_ref"
      ],
      "type": "object"
    },
    "execution_scope_2": {
      "additionalProperties": false,
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/execution_scope_3"
          },
          "minItems": 1,
          "type": "array"
        },
        "goals": {
          "items": {
            "$ref": "#/$defs/execution_goal"
          },
          "minItems": 1,
          "type": "array"
        },
        "scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope_steps": {
          "items": {
            "$ref": "#/$defs/execution_step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "scope_ref"
      ],
      "type": "object"
    },
    "execution_scope_3": {
      "additionalProperties": false,
      "properties": {
        "goals": {
          "items": {
            "$ref": "#/$defs/execution_goal"
          },
          "minItems": 1,
          "type": "array"
        },
        "scope_ref": {
          "minLength": 1,
          "type": "string"
        },
        "scope_steps": {
          "items": {
            "$ref": "#/$defs/execution_step"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "scope_ref"
      ],
      "type": "object"
    },
    "execution_step": {
      "additionalProperties": false,
      "properties": {
        "actual_outputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "return": {
                "minLength": 1,
                "type": "string"
              },
              "runtime_type": {
                "minLength": 1,
                "type": "string"
              },
              "value": {},
              "value_omitted_reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "return",
              "runtime_type"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "authored_step": {
          "$ref": "#/$defs/authored_step"
        },
        "blocked_by": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "resolved_inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "arg": {
                "minLength": 1,
                "type": "string"
              },
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "resolution": {
                "enum": [
                  "source_snapshot",
                  "step_result",
                  "unresolved"
                ]
              },
              "runtime_type": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "$ref": "#/$defs/functional_ref"
              },
              "value": {},
              "value_omitted_reason": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "arg",
              "index",
              "source"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "status": {
          "enum": [
            "valid",
            "authority_invalid",
            "ready",
            "runtime_verified",
            "runtime_failed",
            "blocked_by_dependency",
            "pruned_dead"
          ]
        },
        "step_id": {
          "minLength": 1,
          "type": "string"
        },
        "typed_issue": {
          "type": "object"
        }
      },
      "required": [
        "step_id",
        "status",
        "authored_step"
      ],
      "type": "object"
    },
    "functional_ref": {
      "description": "Use a SourceRef string for the verified problem snapshot, or a StepResultRef object for one exact return from an earlier step.",
      "oneOf": [
        {
          "$ref": "#/$defs/source_ref"
        },
        {
          "$ref": "#/$defs/step_result_ref"
        }
      ]
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "all_required_goals_verified": {
          "type": "boolean"
        },
        "authority_invalid_step_count": {
          "minimum": 0,
          "type": "integer"
        },
        "authority_valid_step_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_by_dependency_step_count": {
          "minimum": 0,
          "type": "integer"
        },
        "blocked_stage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provisional_executed_step_count": {
          "minimum": 0,
          "type": "integer"
        },
        "pruned_dead_step_count": {
          "minimum": 0,
          "type": "integer"
        },
        "transaction_attempted": {
          "type": "boolean"
        },
        "transaction_ok": {
          "type": "boolean"
        }
      },
      "required": [
        "authority_valid_step_count",
        "authority_invalid_step_count",
        "pruned_dead_step_count",
        "provisional_executed_step_count",
        "blocked_by_dependency_step_count",
        "transaction_attempted",
        "transaction_ok",
        "all_required_goals_verified",
        "blocked_stage"
      ],
      "type": "object"
    },
    "source_ref": {
      "description": "Copy a scope-local visible Entity or Fact ref from Planner Problem View exactly, without adding a scope prefix. A string never denotes a value produced by a plan step.",
      "minLength": 1,
      "type": "string"
    },
    "step_result_ref": {
      "additionalProperties": false,
      "description": "Read one named return from an earlier visible step. Use this for anonymous results, non-latest states, or ambiguous producers.",
      "properties": {
        "return": {
          "minLength": 1,
          "description": "Copy the producer capability's public return name exactly; its type must be accepted by the consuming argument.",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "return"
      ],
      "type": "object"
    }
  },
  "$id": "functional-goal-execution-checkpoint.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "minLength": 1,
      "type": "string"
    },
    "functional_problem_binding_signature": {
      "minLength": 1,
      "type": "string"
    },
    "goal_unit_ids": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "type": "object"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "plan_id": {
      "minLength": 1,
      "type": "string"
    },
    "planning_context_id": {
      "minLength": 1,
      "type": "string"
    },
    "problem_revision_id": {
      "minLength": 1,
      "type": "string"
    },
    "problem_semantic_hash": {
      "minLength": 1,
      "type": "string"
    },
    "provisional_state_signature": {
      "minLength": 1,
      "type": "string"
    },
    "root_issues": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "root_scope": {
      "$ref": "#/$defs/execution_scope_0"
    },
    "schema_version": {
      "const": "functional-goal-execution-checkpoint/v1"
    },
    "source_unit_ids": {
      "additionalProperties": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array",
        "uniqueItems": true
      },
      "type": "object"
    },
    "step_binding_signatures": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "root_scope",
    "root_issues",
    "metrics",
    "planning_context_id",
    "problem_revision_id",
    "problem_semantic_hash",
    "plan_id",
    "functional_problem_binding_signature",
    "step_binding_signatures",
    "goal_unit_ids",
    "source_unit_ids",
    "provisional_state_signature",
    "checkpoint_id"
  ],
  "title": "Functional Goal Execution Checkpoint v1",
  "type": "object"
}
