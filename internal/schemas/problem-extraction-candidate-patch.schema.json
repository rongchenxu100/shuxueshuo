{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-extraction-candidate-patch.schema.json",
  "title": "Problem Extraction Candidate Patch",
  "type": "object",
  "required": [
    "schema_version",
    "base_context_id",
    "evidence_pack_id",
    "classification",
    "transcription_lines",
    "candidates",
    "ambiguities",
    "review_region_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "problem-extraction-candidate-patch/v1" },
    "base_context_id": { "type": "string", "minLength": 1 },
    "evidence_pack_id": { "type": "string", "pattern": "^evidence-pack:[a-f0-9]{64}$" },
    "classification": { "$ref": "#/$defs/classification" },
    "transcription_lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/transcription" }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "ambiguities": {
      "type": "array",
      "items": { "$ref": "#/$defs/ambiguity" }
    },
    "review_region_refs": { "$ref": "#/$defs/string_array" }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "classification": {
      "type": "object",
      "required": ["pattern", "problem_type", "confidence", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": ["string", "null"] },
        "problem_type": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "transcription": {
      "type": "object",
      "required": [
        "line_id", "text", "reading_order", "evidence_refs",
        "review_region_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "line_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "reading_order": { "type": "integer", "minimum": 0 },
        "evidence_refs": { "$ref": "#/$defs/nonempty_string_array" },
        "review_region_refs": { "$ref": "#/$defs/string_array" }
      }
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id", "candidate_type", "confidence", "evidence_refs",
        "review_region_refs", "payload"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^(scope|entity|fact|goal)_[A-Za-z0-9_-]+$" },
        "candidate_type": { "enum": ["scope", "entity", "fact", "goal"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_refs": { "$ref": "#/$defs/nonempty_string_array" },
        "review_region_refs": { "$ref": "#/$defs/string_array" },
        "payload": { "type": "object" }
      }
    },
    "ambiguity": {
      "type": "object",
      "required": [
        "ambiguity_id", "code", "evidence_refs",
        "review_region_refs", "message"
      ],
      "additionalProperties": false,
      "properties": {
        "ambiguity_id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "candidate_ids": { "$ref": "#/$defs/string_array" },
        "evidence_refs": { "$ref": "#/$defs/string_array" },
        "review_region_refs": { "$ref": "#/$defs/nonempty_string_array" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "nonempty_string_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
