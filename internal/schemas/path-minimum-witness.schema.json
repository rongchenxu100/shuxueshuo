{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "path-minimum-witness.schema.json",
  "title": "PathMinimumWitness",
  "type": "object",
  "required": [
    "schema_version",
    "step_id",
    "macro_id",
    "original_objective",
    "reduced_objective",
    "role_resolutions",
    "constructions",
    "equivalence_proof",
    "legal_domain",
    "minimum_strategy",
    "minimum_expression",
    "minimizing_points",
    "attainment_checks",
    "macro_search_report",
    "provenance_signature",
    "witness_id"
  ],
  "properties": {
    "schema_version": {
      "const": "path-minimum-witness/v1"
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "macro_id": {
      "type": "string",
      "minLength": 1
    },
    "original_objective": {
      "type": "string",
      "minLength": 1
    },
    "reduced_objective": {
      "type": "string",
      "minLength": 1
    },
    "role_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "authored_ref",
          "chosen_ref",
          "corrected"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authored_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "chosen_ref": {
            "type": "string",
            "minLength": 1
          },
          "corrected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "constructions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "equivalence_proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "legal_domain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "minimum_strategy": {
      "type": "string",
      "minLength": 1
    },
    "minimum_expression": {
      "type": "string",
      "minLength": 1
    },
    "minimizing_points": {
      "type": "object"
    },
    "attainment_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "macro_search_report": {
      "type": "object",
      "required": [
        "schema_version",
        "macro_id",
        "candidate_builder_id",
        "validation_policy_id",
        "winner_candidate_id",
        "role_resolutions",
        "evaluations",
        "search_signature"
      ],
      "properties": {
        "schema_version": {
          "const": "macro-runtime-search-report/v1"
        },
        "macro_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_builder_id": {
          "type": "string",
          "minLength": 1
        },
        "validation_policy_id": {
          "type": "string",
          "minLength": 1
        },
        "winner_candidate_id": {
          "type": "string",
          "minLength": 1
        },
        "role_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "authored_ref",
              "chosen_ref",
              "corrected"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1
              },
              "authored_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "chosen_ref": {
                "type": "string",
                "minLength": 1
              },
              "corrected": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "evaluations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "candidate_id",
              "passed",
              "output_signature",
              "checks"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
              "output_signature": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "call_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "search_signature": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "provenance_signature": {
      "type": "string",
      "minLength": 1
    },
    "witness_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
