{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "macro-runtime-search-report.schema.json",
  "title": "MacroRuntimeSearchReport",
  "type": "object",
  "required": [
    "schema_version",
    "macro_id",
    "candidate_builder_id",
    "validation_policy_id",
    "winner_candidate_id",
    "role_resolutions",
    "evaluations",
    "search_signature"
  ],
  "properties": {
    "schema_version": {
      "const": "macro-runtime-search-report/v1"
    },
    "macro_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_builder_id": {
      "type": "string",
      "minLength": 1
    },
    "validation_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "winner_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "role_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "authored_ref",
          "chosen_ref",
          "corrected"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authored_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "chosen_ref": {
            "type": "string",
            "minLength": 1
          },
          "corrected": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "passed",
          "output_signature",
          "checks"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "output_signature": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "call_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "search_signature": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
