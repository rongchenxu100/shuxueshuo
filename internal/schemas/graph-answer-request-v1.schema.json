{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-answer-request/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "identity"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "quantity"
      ],
      "properties": {
        "kind": {
          "const": "extremum"
        },
        "quantity": {
          "enum": [
            "minimum",
            "maximum",
            "infimum",
            "supremum"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bindings",
        "expression"
      ],
      "properties": {
        "kind": {
          "const": "expression"
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "quantity"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "quantity": {
                "enum": [
                  "minimum",
                  "maximum",
                  "infimum",
                  "supremum"
                ]
              }
            }
          }
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expected",
        "relation"
      ],
      "properties": {
        "kind": {
          "const": "compare_set"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "relation": {
          "enum": [
            "equal",
            "not_equal"
          ]
        }
      }
    }
  ],
  "description": "原题对已求集合的提问方式；只保留原文要求，不填写算出的值、范围或计划。最值必须区分能否取得。"
}
