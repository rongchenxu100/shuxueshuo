{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "problem-call-source-provenance.schema.json",
  "title": "ProblemCallSourceProvenance",
  "type": "object",
  "required": [
    "schema_version",
    "planning_context_id",
    "problem_revision_id",
    "problem_semantic_hash",
    "canonical_call_id",
    "goal_unit_ids",
    "input_source_unit_ids",
    "call_binding_signature",
    "macro_search_signature",
    "macro_role_resolutions"
  ],
  "properties": {
    "schema_version": {
      "const": "problem-call-source-provenance/v1"
    },
    "planning_context_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "problem_semantic_hash": {
      "type": "string",
      "minLength": 1
    },
    "canonical_call_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_unit_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "input_source_unit_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "call_binding_signature": {
      "type": "string",
      "minLength": 1
    },
    "macro_search_signature": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "macro_role_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "authored_ref",
          "chosen_ref"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "authored_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "chosen_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
