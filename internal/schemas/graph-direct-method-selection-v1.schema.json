{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "const": "graph-direct-method-selection/v1"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "单路线时必填；多路线时省略。"
    },
    "route_id": {
      "type": "string",
      "minLength": 1,
      "description": "单路线时必填；多路线时省略。"
    },
    "admission": {
      "enum": [
        "function_domain",
        "function_domain_routes",
        "function_equality",
        "abstract_function_domain",
        "function_evaluation"
      ]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "route_id",
          "admission"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "enum": [
              "function_domain",
              "function_domain_parameter"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "method",
        "route_id"
      ],
      "not": {
        "required": [
          "routes"
        ]
      },
      "properties": {
        "admission": {
          "enum": [
            "function_domain",
            "function_equality",
            "abstract_function_domain",
            "function_evaluation"
          ]
        }
      }
    },
    {
      "required": [
        "routes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "method"
            ]
          },
          {
            "required": [
              "route_id"
            ]
          }
        ]
      },
      "properties": {
        "admission": {
          "const": "function_domain_routes"
        }
      }
    }
  ]
}
