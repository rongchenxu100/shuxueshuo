{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "admission"
  ],
  "properties": {
    "schema_version": {
      "const": "graph-direct-method-selection/v1"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "单路线时必填；多路线时省略。"
    },
    "route_id": {
      "type": "string",
      "minLength": 1,
      "description": "单路线时必填；多路线时省略。"
    },
    "admission": {
      "enum": [
        "function_domain",
        "function_domain_routes",
        "function_equality",
        "abstract_function_domain",
        "function_evaluation",
        "function_range",
        "function_range_routes",
        "function_formula",
        "function_graph",
        "piecewise_equation",
        "piecewise_routes"
      ]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "route_id",
          "admission"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "admission": {
            "enum": [
              "function_domain",
              "function_domain_parameter",
              "function_range_quadratic",
              "function_range_direct",
              "function_range_substitution",
              "function_range_fraction",
              "function_range_equation",
              "function_range_finite",
              "function_range_translation",
              "function_formula",
              "function_matching",
              "function_coefficients",
              "function_system",
              "function_assignment",
              "function_graph",
              "piecewise_equation",
              "piecewise_inequality",
              "function_range_piecewise",
              "piecewise_range_parameter",
              "piecewise_modeling"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rule": {
      "type": "string"
    },
    "display": {
      "const": "method_cards"
    }
  },
  "oneOf": [
    {
      "required": [
        "method",
        "route_id"
      ],
      "not": {
        "required": [
          "routes"
        ]
      },
      "properties": {
        "admission": {
          "enum": [
            "function_domain",
            "function_equality",
            "abstract_function_domain",
            "function_evaluation",
            "function_range",
            "function_formula",
            "function_graph",
            "piecewise_equation"
          ]
        }
      }
    },
    {
      "required": [
        "routes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "method"
            ]
          },
          {
            "required": [
              "route_id"
            ]
          }
        ]
      },
      "properties": {
        "admission": {
          "enum": [
            "function_domain_routes",
            "function_range_routes",
            "function_formula",
            "function_graph",
            "piecewise_routes"
          ]
        }
      }
    }
  ]
}
