{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-problem-extraction/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_text",
    "root"
  ],
  "properties": {
    "original_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768,
      "pattern": "\\S",
      "description": "完整题干原文的转录，供人阅读与页面展示；与root数学候选独立，不参与数学编译。保留原有中文叙述、公式、量词措辞和参数说明，按阅读顺序换行；公式可用等义Unicode或LaTeX排版，不化简、不从root反向生成。不抄手写答案、批注或解析。无法辨认处写[无法辨认]并在uncertainties说明。"
    },
    "root": {
      "$ref": "#/$defs/Scope"
    }
  },
  "$defs": {
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "整题及小问树。root放整题共用的定义与条件；题面有（1）（2）等小问时，每个小问是root.children中的一个节点，按题面顺序排列，放该小问自己的局部条件与所求。父节点条件向下继承，兄弟小问的局部条件互不相通。没有小问时只用root，不虚构小问。",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "题面分问或图景标签，如（1）、②；可省略。不作为对象ID，也不替代数学条件。"
        },
        "definitions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "固定放置规则：仅曲线定义（Γ: y=x^2+u*x+v）、函数定义（f(t)=t^2）及题内新概念定义原文放这里。点坐标、中点、平移等其余题设关系均放facts，不因它们引入对象而改放此处。曲线/函数定义用稳定符号及受控数学式，不拼接中文说明。新概念原文作为解释材料，使用处仍须展开关系。数学式偶尔放错数组不单独判错，代码从表达式识别对象类型。"
          },
          "maxItems": 128,
          "description": "可省略。仅曲线/函数定义及题内新概念原文优先放此处；其他题设关系优先放facts。"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "使用 math_expression_catalog 的受控数学字符串；不要输出 AST、解题过程或答案。题面只说“恒成立”而未写出量词变量或其范围时，按实数域补全（如 ∀x∈ℝ: …）。不要补充隐含非零条件。"
          },
          "maxItems": 128,
          "description": "除曲线/函数定义及新概念原文之外的题设关系均放这里，包括P=(1,2)、W=midpoint(U,V)、R=P+(3,0)、点在线上、参数范围及函数取值条件。各项同时成立；每项一条受控数学关系，引用稳定符号，不夹带解释句、不重复definitions、不输出求解结果。受控短声明如“A、B为定点；C为动点；D为平面内一点。”也放这里；无需额外补动点标签。 最值条件min(UV+VW)=7与取得最值的状态UV+VW=min(UV+VW)均放facts，但含义不同，不能互相替代。状态仅在题面明确时保留，不推导最优位置或附加条件。"
        },
        "goals": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "expression"
                ],
                "properties": {
                  "kind": {
                    "const": "find_value",
                    "description": "求值"
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求数学表达式，如UV+VW；不写“求…的值”等自然语言或答案。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  },
                  "input_domain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "仅题面明确另限外层自由变量范围时填写；不能填自然域或答案。"
                  }
                },
                "additionalProperties": false,
                "description": "求参数或表达式的值。用expression标明所求，不输出算出的数值。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "object"
                ],
                "properties": {
                  "kind": {
                    "const": "find_coordinates",
                    "description": "求坐标"
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求点的符号，如P；不填Γ、坐标答案、“点P”或其他自然语言。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  }
                },
                "additionalProperties": false,
                "description": "求点的坐标。object必须引用点，不是曲线或整条定义。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "object"
                ],
                "properties": {
                  "kind": {
                    "const": "find_equation",
                    "description": "求方程"
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求曲线或函数的符号，如Γ、f；不填点名、整条定义或“该抛物线”。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  }
                },
                "additionalProperties": false,
                "description": "求曲线或函数的解析式/方程。object引用已定义的曲线或函数。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "expression"
                ],
                "properties": {
                  "kind": {
                    "const": "find_minimum",
                    "description": "求最小值"
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求数学表达式，如UV+VW；不写“求…的值”等自然语言或答案。"
                  },
                  "variables": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "一个可见的点名或参数名，如P或t，不是表达式或中文说明。"
                    },
                    "maxItems": 128,
                    "description": "可选的优化变量提示，只填写题面明确的点名或参数名，如[P,Q]。即使题面明确也可以省略；不分析依赖、不列固定参数、不把所有字母都当优化变量。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  }
                },
                "additionalProperties": false,
                "description": "求表达式的最小值。expression填写原表达式，不再套min；variables可省略。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "expression"
                ],
                "properties": {
                  "kind": {
                    "const": "find_maximum",
                    "description": "求最大值"
                  },
                  "expression": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求数学表达式，如UV+VW；不写“求…的值”等自然语言或答案。"
                  },
                  "variables": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "一个可见的点名或参数名，如P或t，不是表达式或中文说明。"
                    },
                    "maxItems": 128,
                    "description": "可选的优化变量提示，只填写题面明确的点名或参数名，如[P,Q]。即使题面明确也可以省略；不分析依赖、不列固定参数、不把所有字母都当优化变量。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  }
                },
                "additionalProperties": false,
                "description": "求表达式的最大值。expression填写原表达式，不再套max；variables可省略。"
              },
              {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "find_range",
                    "description": "求范围"
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求范围的参数符号，如t；不写中文名称或答案。"
                  },
                  "in_terms_of": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "description": "题面明确要求保留的一个参数符号。"
                    },
                    "maxItems": 128,
                    "description": "题面要求“用含某参数的式子表示”时填写对应参数名，如[\"u\",\"v\"]；未提出这种要求时可省略。它是答案形式要求，不是固定参数列表，也不同于variables提示。"
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "求具体函数的完整值域时填写已定义函数名，如 f；不是自变量、解析式或答案。"
                  },
                  "input_domain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "函数值域目标的额外输入范围，仅转录题给范围；完整定义域声明写入 Dom(f)=D。"
                  },
                  "answer_request": {
                    "$ref": "#/$defs/AnswerRequest",
                    "description": "原题对值域集合的提问方式，仅记录目标，不写答案。"
                  }
                },
                "additionalProperties": false,
                "description": "symbol 求参数可行范围；object 求具体函数全部输出集合，两者严格互斥。",
                "oneOf": [
                  {
                    "required": [
                      "symbol"
                    ],
                    "not": {
                      "required": [
                        "object"
                      ]
                    }
                  },
                  {
                    "required": [
                      "object"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "symbol"
                          ]
                        },
                        {
                          "required": [
                            "in_terms_of"
                          ]
                        }
                      ]
                    }
                  }
                ],
                "allOf": [
                  {
                    "if": {
                      "required": [
                        "input_domain"
                      ]
                    },
                    "then": {
                      "required": [
                        "object"
                      ]
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "answer_request"
                      ]
                    },
                    "then": {
                      "required": [
                        "object"
                      ]
                    }
                  }
                ]
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "symbol"
                ],
                "properties": {
                  "kind": {
                    "const": "find_count",
                    "description": "求个数"
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所计数的集合符号，如M；本节点及父节点条件就是对它的全部限制。不写|{M:…}|、中文名称或答案。"
                  }
                },
                "additionalProperties": false,
                "description": "求满足本节点条件的集合有多少个（如“满足条件的集合M的个数”）。symbol填写集合名，条件写在facts，不输出算出的个数。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "object"
                ],
                "properties": {
                  "kind": {
                    "const": "find_domain",
                    "description": "求具体函数全部允许的实数输入"
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "已定义函数的符号，如f；不填解析式、输入变量或答案。"
                  },
                  "input_domain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "仅在题面明确另限输入范围时填写原给定范围，如[0,1]；否则省略。不得填写由根式、分母推导的自然定义域或求解答案。"
                  }
                },
                "additionalProperties": false,
                "description": "求具体函数定义域，保留函数原定义；可选input_domain仅转录题设另给的输入范围。"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "object",
                  "domain",
                  "symbol"
                ],
                "properties": {
                  "kind": {
                    "const": "match_domain",
                    "description": "已知含参具体函数的定义域恰为题给集合，求参数范围"
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "已定义函数的符号，如f；不填解析式或答案。"
                  },
                  "domain": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "题面给出的定义域集合，如ℝ；不得填写求解得到的参数范围。"
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "所求参数符号，如k；不写中文名称或答案。"
                  }
                },
                "additionalProperties": false,
                "description": "已知定义域恰为给定集合时反求参数；domain转录题设定义域，symbol为所求参数。"
              },
              {
                "$ref": "#/$defs/CompareFunctionsGoal"
              },
              {
                "$ref": "#/$defs/FindAbstractDomainGoal"
              },
              {
                "$ref": "#/$defs/FindAbstractDomainParameterGoal"
              },
              {
                "$ref": "#/$defs/FindAbstractRangeGoal"
              },
              {
                "$ref": "#/$defs/CheckConstantGoal"
              },
              {
                "$ref": "#/$defs/FiniteSumGoal"
              },
              {
                "$ref": "#/$defs/FindTranslationRangeGoal"
              },
              {
                "$ref": "#/$defs/SelectRangeDomainGoal"
              },
              {
                "$ref": "#/$defs/FindExtremaExpressionGoal"
              },
              {
                "$ref": "#/$defs/FindFunctionFormulaGoal"
              },
              {
                "$ref": "#/$defs/FindRelationValueGoal"
              },
              {
                "$ref": "#/$defs/FindRelationRangeGoal"
              }
            ]
          },
          "maxItems": 128,
          "description": "在本节点及其祖先节点条件下求什么。小问的所求放在对应小问节点；目标仅填写种类、对象或表达式及适用的答案形式/变量提示，不另带数学条件。"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          },
          "maxItems": 128,
          "description": "小问节点，按题面顺序；可省略。小问的局部条件（如“当m=1时”）只写在该小问节点，不提到root，也不复制到其他小问。整题共用的定义与条件只写在root，不在小问中重复。小问内再分情形（如①②）时作为该小问的children。不得把多个小问的条件或所求合并到同一节点。"
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "missing_figure",
                  "ambiguous_symbol",
                  "unreadable",
                  "occluded",
                  "unstructured",
                  "ambiguous_reuse"
                ],
                "description": "missing_figure：缺少题目引用的图；ambiguous_symbol：符号不确定；unreadable：无法辨认；occluded：遮挡；unstructured：超出受控记法的表达能力；ambiguous_reuse：同名对象指代不明。"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "说明对应位置、缺失内容或具体歧义；保留可读原文线索，不猜测未知条件或补写答案。"
              }
            }
          },
          "maxItems": 128,
          "description": "可省略；没有不确定性时为空。问题放在对应作用域，整题共用的问题放root。missing_figure会阻断后续处理；不猜图，也不把定义/题型不熟悉误报为缺图。 核对所有输入图片；提到图不代表图已提供，即使文字足以推理也须报告被引用但未提供的图。图已提供不能误报；模糊或遮挡使用相应类型。"
        }
      }
    },
    "ComparisonFunction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S",
          "description": "原函数定义的受控字符串，例如 f(x)=(sqrt(x))^2；不化简，不输出AST。原图只写 y=解析式时可按共同规则使用局部函数别名 f(x)，原自变量和解析式不变，公开题面仍保留 y。"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S",
          "description": "仅题面明确给定的定义域，如 [0,1]、[0,0]、{0}、ℝ，或 ℝ∖{-1,1/2}、[0,2]∖{1}；集合差用 ∖（setminus 同义），不使用算术减号。未给出时省略，不填写推导所得自然域。"
        }
      }
    },
    "ComparisonOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "text",
        "functions",
        "left",
        "right"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "functions": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/ComparisonFunction"
          }
        },
        "left": {
          "type": "string",
          "pattern": "^(local|shared):[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "right": {
          "type": "string",
          "pattern": "^(local|shared):[A-Za-z][A-Za-z0-9_-]{0,63}$"
        }
      }
    },
    "CompareFunctionsGoal": {
