{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graph-math-step/v2",
  "type": "object",
  "required": [
    "contract",
    "lesson_version",
    "run_id",
    "target_ref",
    "route_id",
    "step_id",
    "ordinal",
    "method_ref",
    "source_refs",
    "case_path",
    "title",
    "before",
    "after",
    "explanation",
    "premise_refs",
    "used_basis",
    "local_check",
    "revisions_ref",
    "math_step_sha256"
  ],
  "properties": {
    "contract": {
      "const": "graph-math-step/v2"
    },
    "lesson_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": "string",
      "pattern": "^/root(?:/children/[0-9]+)*/goals/[0-9]+$"
    },
    "route_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "method_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case_condition": {
      "$ref": "#/$defs/mathValue",
      "description": "Verified condition for the current case, frozen with the card."
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "description": "Presentation branch within the execution case; does not alter source case_path."
    },
    "branch_condition": {
      "$ref": "#/$defs/mathValue",
      "description": "Verified nontrivial condition for the presentation branch, frozen with the card."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "before": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mathValue"
      }
    },
    "after": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mathValue"
      }
    },
    "explanation": {
      "type": "string"
    },
    "derivation": {
      "const": true
    },
    "highlight": {
      "type": "object",
      "required": [
        "caption",
        "items"
      ],
      "properties": {
        "caption": {
          "type": "string"
        },
        "connector": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "math"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "math": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "conclusion_only": {
          "const": true
        },
        "show_result": {
          "const": true
        },
        "replace_with_graph": {
          "const": true
        },
        "layout": {
          "const": "merge"
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "premise_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "used_basis": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "local_check": {
      "const": "passed"
    },
    "math_step_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revisions_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "option_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "label",
        "target_ref",
        "left_ref",
        "right_ref",
        "phase"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target_ref": {
          "type": "string",
          "minLength": 1
        },
        "left_ref": {
          "type": "string",
          "minLength": 1
        },
        "right_ref": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "evidence",
            "verdict"
          ]
        }
      }
    }
  },
  "$defs": {
    "mathValue": {
      "type": "object",
      "required": [
        "expression",
        "latex"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "latex": {
          "type": "string",
          "minLength": 1
        },
        "exact": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "required": [
      "revisions"
    ]
  }
}
