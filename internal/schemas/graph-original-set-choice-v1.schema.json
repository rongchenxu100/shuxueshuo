{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified set-answer original choice",
  "description": "Verified set-equality or candidate-domain image comparison choices. Runtime additionally checks goal kind, original option identity, label uniqueness and membership.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "kind",
    "matching",
    "selection_mode",
    "target_ref",
    "options",
    "correct_labels"
  ],
  "properties": {
    "status": {
      "const": "matched"
    },
    "kind": {
      "enum": [
        "single_choice",
        "multiple_choice"
      ]
    },
    "matching": {
      "enum": [
        "set_equality",
        "range_domain_options"
      ]
    },
    "selection_mode": {
      "enum": [
        "single",
        "multiple",
        "unspecified"
      ]
    },
    "target_ref": {
      "type": "string",
      "pattern": "^/root(?:/children/[0-9]+)*/goals/[0-9]+$"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "text"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "correct_labels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection_mode": {
            "const": "single"
          }
        }
      },
      "then": {
        "properties": {
          "kind": {
            "const": "single_choice"
          },
          "correct_labels": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "kind": {
            "const": "multiple_choice"
          }
        }
      }
    }
  ]
}
