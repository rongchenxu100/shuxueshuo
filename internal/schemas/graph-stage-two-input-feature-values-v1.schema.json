{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage-two known/conditional input feature values",
  "description": "Structural validation only, against stage-one feature registry output; unknown values are not interpreted.",
  "$defs": {
    "quantifier": {
      "enum": [
        "∀",
        "∃"
      ]
    },
    "bound_vars": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "free_vars": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "goal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "symbol"
          ],
          "properties": {
            "kind": {
              "enum": [
                "find_range",
                "find_minimum",
                "find_maximum",
                "find_domain",
                "match_domain"
              ]
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "object": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "description": "match_domain 时的函数符号；其他目标可省略。"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "mode",
            "select_relation",
            "selection_mode"
          ],
          "properties": {
            "kind": {
              "const": "compare_functions"
            },
            "mode": {
              "enum": [
                "pair",
                "groups",
                "shared_baseline"
              ]
            },
            "select_relation": {
              "enum": [
                "equal",
                "different",
                "unknown",
                null
              ]
            },
            "selection_mode": {
              "enum": [
                "single",
                "multiple",
                "unspecified",
                "none"
              ]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "pair"
                  }
                }
              },
              "then": {
                "properties": {
                  "select_relation": {
                    "type": "null"
                  },
                  "selection_mode": {
                    "const": "none"
                  }
                }
              },
              "else": {
                "properties": {
                  "select_relation": {
                    "enum": [
                      "equal",
                      "different",
                      "unknown"
                    ]
                  },
                  "selection_mode": {
                    "enum": [
                      "single",
                      "multiple",
                      "unspecified"
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "kind",
            "known_form",
            "strength"
          ],
          "properties": {
            "kind": {
              "enum": [
                "find_abstract_domain",
                "find_abstract_domain_parameter",
                "find_abstract_range"
              ]
            },
            "known_form": {
              "enum": [
                "identity",
                "affine",
                null
              ]
            },
            "strength": {
              "enum": [
                "exact",
                "meaningful_only"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "find_value",
                "check_constant",
                "finite_sum"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "object"
          ],
          "properties": {
            "kind": {
              "const": "find_range"
            },
            "object": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "domain": {
      "type": "object",
      "required": [
        "expression",
        "lower",
        "upper",
        "left_closed",
        "right_closed",
        "bounded"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lower": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "upper": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "left_closed": {
          "type": "boolean"
        },
        "right_closed": {
          "type": "boolean"
        },
        "bounded": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "domain_kind": {
      "enum": [
        "real",
        "bounded_interval",
        "half_infinite_interval"
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "operator",
        "strict",
        "lhs",
        "rhs"
      ],
      "properties": {
        "operator": {
          "enum": [
            "<",
            "<=",
            ">",
            ">=",
            "=",
            "!="
          ]
        },
        "strict": {
          "type": "boolean"
        },
        "lhs": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rhs": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "normal_form": {
      "type": "object",
      "required": [
        "expression",
        "operator",
        "rhs",
        "variable"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operator": {
          "enum": [
            ">",
            ">=",
            "=",
            "!="
          ]
        },
        "rhs": {
          "const": "0"
        },
        "variable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "degree_in_bound": {
      "type": "object",
      "required": [
        "variable",
        "degree",
        "degree_kind",
        "expression"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "degree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "degree_kind": {
          "enum": [
            "exact",
            "upper_bound",
            "zero_polynomial"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "degree_kind": {
                "const": "zero_polynomial"
              }
            }
          },
          "then": {
            "properties": {
              "degree": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "degree": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "degree_in_goal": {
      "type": "object",
      "required": [
        "variable",
        "degree",
        "degree_kind",
        "expression"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "degree": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "degree_kind": {
          "enum": [
            "exact",
            "upper_bound",
            "zero_polynomial"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "degree_kind": {
                "const": "zero_polynomial"
              }
            }
          },
          "then": {
            "properties": {
              "degree": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "degree": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "leading_coeff_in_bound": {
      "type": "object",
      "required": [
        "variable",
        "expression",
        "contains_parameters",
        "may_be_zero"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "contains_parameters": {
          "type": "boolean"
        },
        "may_be_zero": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "coefficients": {
      "type": "object",
      "required": [
        "variable",
        "expression",
        "items"
      ],
      "properties": {
        "variable": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "power",
              "expression",
              "contains_parameters"
            ],
            "properties": {
              "power": {
                "type": "integer",
                "minimum": 0
              },
              "expression": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "contains_parameters": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "range_var_is_principal": {
      "type": "boolean"
    },
    "function_domain": {
      "type": "object",
      "required": [
        "function_ref",
        "function_name",
        "variable",
        "source_ref",
        "expression",
        "expression_latex",
        "input_domain_source_ref",
        "reason",
        "expression_ast",
        "input_domain_ast",
        "structure_supported",
        "has_radical",
        "has_division"
      ],
      "properties": {
        "function_ref": {
          "type": "string"
        },
        "function_name": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "expression_latex": {
          "type": "string"
        },
        "input_domain_source_ref": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "expression_ast": {
          "type": "array"
        },
        "input_domain_ast": {
          "type": "array"
        },
        "structure_supported": {
          "type": "boolean"
        },
        "has_radical": {
          "type": "boolean"
        },
        "has_division": {
          "type": "boolean"
        },
        "has_zero_power": {
          "type": "boolean"
        },
        "has_quadratic_condition": {
          "type": "boolean"
        },
        "task": {
          "enum": [
            "find_domain",
            "match_domain"
          ],
          "description": "子任务；缺省视为 find_domain 以兼容旧录制。"
        },
        "parameter": {
          "type": "string",
          "description": "match_domain 时所求参数名。"
        },
        "parameter_ref": {
          "type": "string"
        },
        "prescribed_domain_ast": {
          "type": "array",
          "description": "match_domain 时题给定义域 AST；find_domain 可省略。"
        },
        "structure_version": {
          "type": "string"
        },
        "parameter_family": {
          "enum": [
            "halfline_root_ratio"
          ],
          "description": "M6 半轴根式比值契约；缺省沿用全实数根式契约。"
        }
      },
      "additionalProperties": false
    },
    "function_comparison": {
      "type": "object",
      "required": [
        "kind",
        "target",
        "target_ref",
        "mode",
        "select_relation",
        "selection_mode",
        "completeness",
        "options",
        "structure_supported",
        "reason",
        "structure_version"
      ],
      "properties": {
        "kind": {
          "const": "compare_functions"
        },
        "target": {
          "type": "array",
          "prefixItems": [
            {
              "const": "comparison_task"
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ],
          "items": false,
          "minItems": 2
        },
        "target_ref": {
          "type": "string",
          "pattern": "^/root(?:/children/[0-9]+)*/goals/[0-9]+$"
        },
        "mode": {
          "enum": [
            "pair",
            "groups",
            "shared_baseline"
          ]
        },
        "select_relation": {
          "enum": [
            "equal",
            "different",
            "unknown",
            null
          ]
        },
        "selection_mode": {
          "enum": [
            "single",
            "multiple",
            "unspecified",
            "none"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/function_comparison/$defs/option"
          }
        },
        "structure_supported": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "structure_version": {
          "const": "function-comparison-domain-first/v2"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "ast": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ],
          "items": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "boolean",
                  "integer"
                ]
              },
              {
                "$ref": "#/$defs/function_comparison/$defs/ast"
              }
            ]
          }
        },
        "function": {
          "type": "object",
          "required": [
            "function_ref",
            "function_name",
            "variable",
            "source_ref",
            "expression",
            "expression_latex",
            "input_domain_source_ref",
            "expression_ast",
            "input_domain_ast",
            "explicit_domain"
          ],
          "properties": {
            "function_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "function_name": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "variable": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expression": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expression_latex": {
              "type": "string"
            },
            "input_domain_source_ref": {
              "type": "string"
            },
            "expression_ast": {
              "$ref": "#/$defs/function_comparison/$defs/ast"
            },
            "input_domain_ast": {
              "$ref": "#/$defs/function_comparison/$defs/ast"
            },
            "explicit_domain": {
              "type": "boolean"
            },
            "structure_supported": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "family": {
              "enum": [
                "domain_only",
                "polynomial",
                "absolute_affine",
                "absolute_quadratic",
                "polynomial_plus_absolute",
                "cancelled_affine_factor",
                "square_root_square",
                "square_root_squared"
              ]
            }
          },
          "additionalProperties": false
        },
        "option": {
          "type": "object",
          "required": [
            "option_id",
            "label",
            "text",
            "source_ref",
            "left",
            "right"
          ],
          "properties": {
            "option_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "source_ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "left": {
              "$ref": "#/$defs/function_comparison/$defs/function"
            },
            "right": {
              "$ref": "#/$defs/function_comparison/$defs/function"
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "pair"
              }
            }
          },
          "then": {
            "properties": {
              "select_relation": {
                "type": "null"
              },
              "selection_mode": {
                "const": "none"
              }
            }
          },
          "else": {
            "properties": {
              "select_relation": {
                "enum": [
                  "equal",
                  "different",
                  "unknown"
                ]
              },
              "selection_mode": {
                "enum": [
                  "single",
                  "multiple",
                  "unspecified"
                ]
              }
            }
          }
        }
      ]
    },
    "abstract_function_domain": {
      "oneOf": [
        {
          "$ref": "#/$defs/abstract_function_domain_plain"
        },
        {
          "$ref": "#/$defs/abstract_function_domain_parameter"
        }
      ]
    },
    "abstract_function_domain_plain": {
      "type": "object",
      "required": [
        "kind",
        "function_name",
        "function_ref",
        "known_call_ast",
        "known_argument_ast",
        "known_domain_ast",
        "known_strength",
        "target_call_ast",
        "target_argument_ast",
        "outer_domain_ast",
        "has_outer_domain",
        "source_ref",
        "known_call_source_ref",
        "known_domain_source_ref",
        "target_call_source_ref",
        "structure_supported",
        "reason",
        "structure_version",
        "known_form",
        "variable",
        "known_slope",
        "known_intercept",
        "target_form",
        "target_latex",
        "concrete_denominator_ast",
        "denominator_slope",
        "denominator_intercept",
        "denominator_ast_path",
        "concrete_denominator_latex"
      ],
      "properties": {
        "kind": {
          "const": "find_abstract_domain"
        },
        "known_range_ast": {
          "type": "array"
        },
        "known_range_source_ref": {
          "type": "string"
        },
        "function_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "function_ref": {
          "type": "array"
        },
        "known_call_ast": {
          "type": "array"
        },
        "known_argument_ast": {
          "type": "array"
        },
        "known_domain_ast": {
          "type": "array"
        },
        "known_strength": {
          "enum": [
            "exact",
            "meaningful_only"
          ]
        },
        "target_call_ast": {
          "type": "array"
        },
        "target_argument_ast": {
          "type": "array"
        },
        "outer_domain_ast": {
          "type": "array"
        },
        "has_outer_domain": {
          "type": "boolean"
        },
        "source_ref": {
          "type": "string"
        },
        "known_call_source_ref": {
          "type": "string"
        },
        "known_domain_source_ref": {
          "type": "string"
        },
        "target_call_source_ref": {
          "type": "string"
        },
        "structure_supported": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "structure_version": {
          "const": "abstract-function-domain-mixed-and-parameter/v4"
        },
        "known_form": {
          "enum": [
            "identity",
            "affine",
            null
          ]
        },
        "target_slope": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_intercept": {
          "type": [
            "string",
            "null"
          ]
        },
        "variable": {
          "type": "string"
        },
        "known_variable": {
          "type": "string"
        },
        "known_argument_latex": {
          "type": "string"
        },
        "target_argument_latex": {
          "type": "string"
        },
        "input_range_latex": {
          "type": "string"
        },
        "input_range_ready": {
          "type": "boolean"
        },
        "known_slope": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_intercept": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_form": {
          "enum": [
            "plain",
            "affine_denominator",
            "sqrt_affine_denominator",
            null
          ]
        },
        "target_latex": {
          "type": "string"
        },
        "concrete_denominator_ast": {
          "type": [
            "array",
            "null"
          ]
        },
        "denominator_slope": {
          "type": [
            "string",
            "null"
          ]
        },
        "denominator_intercept": {
          "type": [
            "string",
            "null"
          ]
        },
        "denominator_ast_path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "concrete_denominator_latex": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "abstract_function_domain_parameter": {
      "type": "object",
      "properties": {
        "function_name": {
          "type": "string"
        },
        "known_variable": {
          "type": "string"
        },
        "variable": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "target_latex": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "known_call_source_ref": {
          "type": "string"
        },
        "known_domain_source_ref": {
          "type": "string"
        },
        "target_call_source_ref": {
          "type": "string"
        },
        "parameter_source_ref": {
          "type": "string"
        },
        "variable_source_ref": {
          "type": "string"
        },
        "quantifier_source_ref": {
          "type": "string"
        },
