        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "repair_permission": {
                "const": "editable"
              }
            },
            "required": [
              "repair_permission"
            ]
          },
