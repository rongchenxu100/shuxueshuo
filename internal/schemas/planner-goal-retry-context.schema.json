          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "valid",
            "authority_invalid",
            "ready",
            "runtime_verified",
            "runtime_failed",
            "blocked_by_dependency",
            "pruned_dead"
          ]
        },
        "repair_permission": {
          "enum": [
            "editable",
            "frozen",
            "read_only"
          ]
        },
        "repair_reason": {
          "type": "string",
          "minLength": 1
        },
        "resolved_inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "actual_outputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "typed_issue": {
