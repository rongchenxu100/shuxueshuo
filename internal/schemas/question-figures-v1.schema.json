{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "question-figures/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "figures"],
  "properties": {
    "schema_version": {"const": "question-figures/v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "width", "height", "quality"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "width": {"type": "integer", "minimum": 1, "maximum": 20000},
        "height": {"type": "integer", "minimum": 1, "maximum": 20000},
        "quality": {"enum": ["original", "processed"]}
      }
    },
    "figures": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "scope_ref", "box"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "role": {"enum": ["source", "statement", "option", "workspace"]},
          "scope_ref": {"type": "string", "pattern": "^/root(?:/children/[0-9]+)*$"},
          "target_ref": {"type": "string", "pattern": "^/root(?:/children/[0-9]+)*/goals/[0-9]+$"},
          "option_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "label": {"type": "string", "pattern": "^[A-Z]$"},
          "box": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1},
            "description": "同一裁剪框归一化坐标（same-crop-normalized），与 processed/original 像素尺寸无关；依次为左、上、右、下，范围 0 到 1。裁图时按 source 的实际像素尺寸换算。"
          }
        },
        "allOf": [{
          "if": {"properties": {"role": {"const": "option"}}},
          "then": {"required": ["target_ref", "option_id", "label"]},
          "else": {"not": {"anyOf": [{"required": ["option_id"]}, {"required": ["label"]}]}}
        }]
      }
    }
  }
}
